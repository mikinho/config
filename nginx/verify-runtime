#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

# Read-only startup acceptance for the repository's Linux nginx service.
# A foreground Type=exec master is not ready merely because execve succeeded.
set -eu

PROGRAM_NAME=${0##*/}
PROC_ROOT=/proc
NGINX_PID_FILE=/run/nginx/nginx.pid
NGINX_LOG_DIRECTORY=/var/log/nginx
NGINX_SYSTEMD_UNIT=nginx.service
TEST_BINARY=/usr/bin/test
MODE=runtime
STARTUP_GATE=no
POLICY_COMMAND_TIMEOUT=5
QUERY_TIMEOUT=5
MASTER_PID=
PREVIOUS_MASTER_PID=
EXPECTED_WORKERS=1
EXACT_WORKERS=no
TIMEOUT_SECONDS=10
QUIC_BPF=${NGINX_QUIC_BPF:-no}
# Keep these aligned with nginx.service and its optional QUIC BPF drop-in.
BASE_CAPABILITIES=00000000010004eb
QUIC_CAPABILITIES=000000c0012014eb
LAST_ERROR='nginx startup has not been inspected'
MONOTONIC_CENTISECONDS=0
STALE_METADATA_WARNED=no
required_syscalls=

usage() {
    cat <<EOF
Usage: $PROGRAM_NAME [--master-pid PID] [--previous-master-pid PID]
       [--workers N] [--timeout-seconds N] [--quic-bpf] [--startup]
       $PROGRAM_NAME --policy-only [--timeout-seconds N]

Checks the live Linux nginx master, active workers, effective process security,
and root-owned log-directory traversal without changing service or file state.
Run as root. Defaults to the managed PID file, at least one active worker, and
a ten-second window. --workers requires exactly the reviewed count, not merely
a minimum, so extra workers cannot bypass the reviewed task budget. The QUIC
BPF expectation can also come from the managed service environment.

Every invocation requires the loaded unit to deny the complete local @mount
syscall group. --policy-only checks that composed policy before service start.

--timeout-seconds bounds the whole check on the monotonic clock, covering
readiness polling and service-manager queries alike. Conditions that resolve on
their own (a PID file or worker not yet present, a manager query that did not
answer within $POLICY_COMMAND_TIMEOUT seconds) are retried once per second until the
window closes; policy violations fail immediately. Queries are capped by the
remaining window; forced command cleanup can take one additional second, but
late results never count as success. 0 performs a single attempt with separate
five-second query limits instead of an overall readiness window.

--startup marks the unit's own ExecStartPost invocation. The loaded policy it
inspects is exactly what the new master received, so on-disk unit changes that
daemon-reload has not activated are reported as a warning instead of failing
the start. Operator and host-acceptance invocations keep failing closed.
EOF
}

fail() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 1; }
warn() { printf '%s: warning: %s\n' "$PROGRAM_NAME" "$*" >&2; }
pending() { LAST_ERROR=$*; return 1; }

read_monotonic_time() {
    # /proc/uptime follows CLOCK_BOOTTIME, so a wall-clock step during startup
    # can neither shorten nor stretch the verification window.
    read -r clock_value _ < "$PROC_ROOT/uptime" \
        || fail "cannot read the monotonic clock from $PROC_ROOT/uptime"
    case "$clock_value" in
        *.[0-9][0-9]) ;;
        *) fail "cannot interpret the monotonic clock from $PROC_ROOT/uptime" ;;
    esac
    clock_seconds=${clock_value%.*}
    clock_fraction=${clock_value#*.}
    case "$clock_seconds" in
        '' | *[!0-9]* | 0[0-9]*) fail "cannot interpret the monotonic clock from $PROC_ROOT/uptime" ;;
    esac
    # Linux reports hundredths. Preserve them when shortening the last query;
    # rounding down to seconds can otherwise give it almost a second too long.
    MONOTONIC_CENTISECONDS=$((clock_seconds * 100 + 1$clock_fraction - 100))
}

window_open() {
    [ "$TIMEOUT_SECONDS" -gt 0 ] || return 0
    read_monotonic_time
    [ "$MONOTONIC_CENTISECONDS" -lt "$deadline" ]
}

prepare_manager_query() {
    QUERY_TIMEOUT=$POLICY_COMMAND_TIMEOUT
    [ "$TIMEOUT_SECONDS" -gt 0 ] || return 0
    window_open || { pending "verification window expired before $1"; return 1; }
    remaining_centiseconds=$((deadline - MONOTONIC_CENTISECONDS))
    if [ "$remaining_centiseconds" -lt "$((POLICY_COMMAND_TIMEOUT * 100))" ]; then
        if [ "$((remaining_centiseconds % 100))" -eq 0 ]; then
            QUERY_TIMEOUT=$((remaining_centiseconds / 100))
        else
            QUERY_TIMEOUT=$(printf '%s.%02d' "$((remaining_centiseconds / 100))" "$((remaining_centiseconds % 100))")
        fi
    fi
}

manager_query() {
    # The caller computes the remaining budget outside command substitution,
    # so diagnostics retain the actual timeout used by this particular query.
    LC_ALL=C SYSTEMD_COLORS=0 timeout --kill-after=1 "$QUERY_TIMEOUT" "$@" 2>/dev/null
}

describe_query_status() {
    if [ "$QUERY_TIMEOUT" = 1 ]; then time_unit=second; else time_unit=seconds; fi
    case "$1" in
        124) printf 'did not answer within %s %s' "$QUERY_TIMEOUT" "$time_unit" ;;
        137) printf 'ignored its %s-second deadline and was killed' "$QUERY_TIMEOUT" ;;
        *) printf 'exited with status %s' "$1" ;;
    esac
}

report_stale_metadata() {
    # The loaded unit is what the running master received, so the inspected
    # policy is accurate even when the on-disk files have moved on. Only the
    # unit's own start gate tolerates that drift: failing there would turn a
    # forgotten daemon-reload into an outage that Restart= cannot clear.
    # Operator and host-acceptance runs certify the on-disk policy and fail.
    [ "$STARTUP_GATE" = yes ] \
        || fail "$NGINX_SYSTEMD_UNIT manager metadata is stale; review the on-disk unit and drop-ins, run systemctl daemon-reload, then restart $NGINX_SYSTEMD_UNIT"
    [ "$STALE_METADATA_WARNED" = no ] || return 0
    STALE_METADATA_WARNED=yes
    warn "$NGINX_SYSTEMD_UNIT was started from its loaded configuration, but its on-disk unit or drop-ins have changed since; run systemctl daemon-reload and restart $NGINX_SYSTEMD_UNIT to activate reviewed changes"
}

validate_number() {
    case "$2" in
        '' | *[!0-9]* | 0[0-9]*) fail "$1 must be a canonical decimal integer" ;;
    esac
    [ "${#2}" -le 7 ] || fail "$1 is too large"
}

status_field() {
    # /proc fields are kernel-owned single lines. A process exiting during
    # inspection is a retryable startup condition, never successful evidence.
    awk -v key="$2:" '$1 == key { $1 = ""; sub(/^[ \t]+/, ""); print; exit }' "$1" 2>/dev/null
}

unit_property() {
    printf '%s\n' "$unit_policy" | awk -v prefix="$1=" '
        index($0, prefix) == 1 { count++; value = substr($0, length(prefix) + 1) }
        END { if (count != 1) exit 1; print value }
    '
}

expand_mount_group() {
    # systemctl resolves groups to syscall names. Expand the local systemd
    # group's definition too, rather than pinning a list that can miss new
    # mount APIs after an operating-system update. Unknown output fails closed.
    # The expansion is deterministic, so one successful result serves every
    # retry of the surrounding check.
    [ -z "$required_syscalls" ] || return 0
    prepare_manager_query 'systemd-analyze syscall-filter' || return 1
    query_status=0
    mount_group=$(manager_query systemd-analyze syscall-filter @mount) || query_status=$?
    [ "$query_status" -eq 0 ] \
        || { pending "cannot expand the local @mount syscall group: systemd-analyze $(describe_query_status "$query_status")"; return 1; }
    required_syscalls=$(printf '%s\n' "$mount_group" | awk '
        $0 == "@mount" { header++; next }
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        NF == 1 && $1 ~ /^[a-z_][a-z0-9_]*$/ {
            names[$1] = 1
            printf "%s%s", separator, $1
            separator = " "
            next
        }
        { invalid = 1 }
        END { if (invalid || header != 1 || !names["mount"] || !names["umount2"] || !names["pivot_root"]) exit 1 }
    ') || fail 'cannot interpret the local @mount syscall group'
}

check_systemd_policy() {
    # Inspect PID 1's composed policy, including later site drop-ins. Seccomp=2
    # alone also occurs when unrelated settings install filters but @mount was
    # cleared. A manager that does not answer in time is a retryable condition;
    # a policy that answers wrongly is not.
    prepare_manager_query 'systemctl show' || return 1
    query_status=0
    unit_policy=$(manager_query systemctl --no-pager show \
        --property=LoadState,NeedDaemonReload,SystemCallFilter,SystemCallErrorNumber,MainPID \
        "$NGINX_SYSTEMD_UNIT") || query_status=$?
    [ "$query_status" -eq 0 ] \
        || { pending "cannot inspect the composed $NGINX_SYSTEMD_UNIT mount policy: systemctl show $(describe_query_status "$query_status")"; return 1; }
    [ "$(unit_property LoadState)" = loaded ] \
        || fail "$NGINX_SYSTEMD_UNIT must be loaded for mount-policy verification"
    case "$(unit_property NeedDaemonReload)" in
        no) ;;
        yes) report_stale_metadata ;;
        *) fail "$NGINX_SYSTEMD_UNIT manager metadata is unknown; review and reload systemd before verification" ;;
    esac
    composed_filter=$(unit_property SystemCallFilter) \
        || fail "$NGINX_SYSTEMD_UNIT has no readable SystemCallFilter property"
    case "$composed_filter" in
        '~'*) denied_syscalls=${composed_filter#\~} ;;
        *) fail "$NGINX_SYSTEMD_UNIT must use a SystemCallFilter deny-list containing the complete @mount group; allow-list replacements require separate review" ;;
    esac
    [ "$(unit_property SystemCallErrorNumber)" = 1 ] \
        || fail "$NGINX_SYSTEMD_UNIT must retain SystemCallErrorNumber=EPERM"
    SYSTEMD_MASTER_PID=$(unit_property MainPID) \
        || fail "$NGINX_SYSTEMD_UNIT has no readable MainPID property"
    expand_mount_group || return 1
    missing_syscalls=$(printf '%s\n' "$denied_syscalls" | awk -v required="$required_syscalls" '
        {
            for (i = 1; i <= NF; i++) {
                entry = $i
                # A nonzero errno or kill also blocks the syscall. Reject
                # zero/success actions and malformed names instead of assuming
                # that an arbitrary suffix provides the required containment.
                if (entry !~ /^[a-z_][a-z0-9_]*(:([A-Z][A-Z0-9_]*|[1-9][0-9]*|kill))?$/) exit 2
                sub(/:.*/, "", entry)
                denied[entry] = 1
            }
        }
        END {
            count = split(required, names, " ")
            for (i = 1; i <= count; i++) if (!denied[names[i]]) {
                printf "%s%s", separator, names[i]
                separator = " "
            }
        }
    ') || fail "$NGINX_SYSTEMD_UNIT has an unsupported SystemCallFilter entry"
    [ -z "$missing_syscalls" ] \
        || fail "$NGINX_SYSTEMD_UNIT SystemCallFilter does not deny required mount syscalls: $missing_syscalls"
}

check_process_security() {
    security_pid=$1
    security_role=$2
    security_status=$PROC_ROOT/$security_pid/status
    [ -r "$security_status" ] || { pending "$security_role PID $security_pid has no readable status"; return 1; }
    [ "$(status_field "$security_status" Umask)" = 0027 ] \
        || { pending "$security_role PID $security_pid does not retain Umask 0027"; return 1; }
    [ "$(status_field "$security_status" NoNewPrivs)" = 1 ] \
        || { pending "$security_role PID $security_pid does not have NoNewPrivileges active"; return 1; }
    [ "$(status_field "$security_status" Seccomp)" = 2 ] \
        || { pending "$security_role PID $security_pid does not have seccomp filtering active"; return 1; }
    observed_bounding=$(status_field "$security_status" CapBnd)
    [ "$observed_bounding" = "$EXPECTED_CAPABILITIES" ] \
        || { pending "$security_role PID $security_pid has an unexpected capability bounding set: CapBnd=$observed_bounding, expected $EXPECTED_CAPABILITIES"; return 1; }
    if [ "$security_role" = master ]; then
        expected_effective=$EXPECTED_CAPABILITIES
        expected_uid=0
    else
        expected_effective=0000000000000000
        expected_uid=$NGINX_UID
    fi
    observed_effective=$(status_field "$security_status" CapEff)
    observed_permitted=$(status_field "$security_status" CapPrm)
    observed_ambient=$(status_field "$security_status" CapAmb)
    [ "$observed_effective" = "$expected_effective" ] \
        && [ "$observed_permitted" = "$expected_effective" ] \
        && [ "$observed_ambient" = 0000000000000000 ] \
        || { pending "$security_role PID $security_pid has unexpected effective, permitted, or ambient capabilities: CapEff=$observed_effective CapPrm=$observed_permitted CapAmb=$observed_ambient; expected CapEff=$expected_effective CapPrm=$expected_effective CapAmb=0000000000000000"; return 1; }
    # All four IDs must agree, including filesystem IDs used for access checks.
    process_uids=$(status_field "$security_status" Uid)
    process_gids=$(status_field "$security_status" Gid)
    [ "$(printf '%s\n' "$process_uids" | tr '\t' ' ' | tr -s ' ')" = "$expected_uid $expected_uid $expected_uid $expected_uid" ] \
        && [ "$(printf '%s\n' "$process_gids" | tr '\t' ' ' | tr -s ' ')" = "$NGINX_GID $NGINX_GID $NGINX_GID $NGINX_GID" ] \
        || { pending "$security_role PID $security_pid has an unexpected user or group identity"; return 1; }
    if [ "$security_role" = master ]; then
        observed_groups=$(status_field "$security_status" Groups)
        [ "$observed_groups" = "$NGINX_GID" ] \
            || { pending "master PID $security_pid has unexpected supplementary groups: Groups=$observed_groups; expected $NGINX_GID"; return 1; }
    fi
}

inspect_runtime() {
    observed_pid=$MASTER_PID
    if [ -z "$observed_pid" ]; then
        observed_pid=$(cat "$NGINX_PID_FILE" 2>/dev/null) \
            || { pending 'nginx PID file is not ready'; return 1; }
    fi
    case "$observed_pid" in
        '' | 0 | *[!0-9]*) pending 'nginx has no valid master PID'; return 1 ;;
    esac
    [ "$observed_pid" = "$SYSTEMD_MASTER_PID" ] \
        || { pending 'nginx master does not match the unit whose mount policy was inspected'; return 1; }
    [ "$observed_pid" != "$PREVIOUS_MASTER_PID" ] \
        || { pending 'nginx master did not change after restart'; return 1; }
    [ -f "$NGINX_PID_FILE" ] && [ ! -L "$NGINX_PID_FILE" ] \
        && [ "$(cat "$NGINX_PID_FILE" 2>/dev/null)" = "$observed_pid" ] \
        || { pending 'nginx PID file does not match the supervised master'; return 1; }
    master_title=$(tr '\000' ' ' 2>/dev/null < "$PROC_ROOT/$observed_pid/cmdline") \
        || { pending 'nginx master command line is not ready'; return 1; }
    case "$master_title" in
        'nginx: master process '*) ;;
        *) pending 'supervised master does not identify itself as nginx'; return 1 ;;
    esac
    check_process_security "$observed_pid" master || return 1
    [ -d "$NGINX_LOG_DIRECTORY" ] && [ ! -L "$NGINX_LOG_DIRECTORY" ] \
        && [ "$(stat -c '%u:%g:%a' "$NGINX_LOG_DIRECTORY" 2>/dev/null)" = "0:$NGINX_GID:750" ] \
        || { pending 'nginx log directory must be root:nginx with mode 0750'; return 1; }
    setpriv --reuid "$NGINX_UID" --regid "$NGINX_GID" --init-groups \
        -- "$TEST_BINARY" -x "$NGINX_LOG_DIRECTORY" \
        || { pending 'nginx worker identity cannot traverse the log directory'; return 1; }
    children=$(cat "$PROC_ROOT/$observed_pid/task/$observed_pid/children" 2>/dev/null) \
        || { pending 'nginx master child list is not ready'; return 1; }
    active_workers=0
    for child_pid in $children; do
        case "$child_pid" in
            '' | *[!0-9]*) pending 'nginx master child list is invalid'; return 1 ;;
        esac
        child_title=$(tr '\000' ' ' 2>/dev/null < "$PROC_ROOT/$child_pid/cmdline" | sed 's/ *$//') || continue
        # Exclude cache helpers and old workers draining after a reload.
        [ "$child_title" = 'nginx: worker process' ] || continue
        check_process_security "$child_pid" worker || return 1
        active_workers=$((active_workers + 1))
    done
    if [ "$EXACT_WORKERS" = yes ]; then
        [ "$active_workers" -eq "$EXPECTED_WORKERS" ] \
            || { pending "nginx has $active_workers active workers; expected exactly $EXPECTED_WORKERS"; return 1; }
    else
        [ "$active_workers" -ge "$EXPECTED_WORKERS" ] \
            || { pending "nginx has $active_workers active workers; expected at least $EXPECTED_WORKERS"; return 1; }
    fi
    # Catch master death or PID replacement during the composed observation.
    [ -r "$PROC_ROOT/$observed_pid/status" ] \
        && [ "$(cat "$NGINX_PID_FILE" 2>/dev/null)" = "$observed_pid" ] \
        || { pending 'nginx master changed or exited during inspection'; return 1; }
}

inspect_service() {
    # Re-read the composed policy on every attempt so the master compared
    # against MainPID is the one the manager reports right now.
    check_systemd_policy || return 1
    window_open || { pending 'verification window expired after policy inspection'; return 1; }
    [ "$MODE" = policy ] || inspect_runtime
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --master-pid | --previous-master-pid | --workers | --timeout-seconds)
            [ "$#" -ge 2 ] || fail "$1 requires a value"
            validate_number "$1" "$2"
            case "$1" in
                --master-pid) [ "$2" -gt 0 ] || fail 'master PID must be positive'; MASTER_PID=$2 ;;
                --previous-master-pid) PREVIOUS_MASTER_PID=$2 ;;
                --workers)
                    [ "$2" -gt 0 ] && [ "$2" -le 32767 ] || fail 'workers must be from 1 to 32767'
                    EXPECTED_WORKERS=$2
                    EXACT_WORKERS=yes
                    ;;
                --timeout-seconds) [ "$2" -le 300 ] || fail 'timeout must be from 0 to 300 seconds'; TIMEOUT_SECONDS=$2 ;;
            esac
            shift 2
            ;;
        --quic-bpf) QUIC_BPF=yes; shift ;;
        --policy-only) MODE=policy; shift ;;
        --startup) STARTUP_GATE=yes; shift ;;
        --help | -h) usage; exit 0 ;;
        *) fail "unknown argument: $1" ;;
    esac
done
case "$QUIC_BPF" in
    no) EXPECTED_CAPABILITIES=$BASE_CAPABILITIES ;;
    yes) EXPECTED_CAPABILITIES=$QUIC_CAPABILITIES ;;
    *) fail 'NGINX_QUIC_BPF must be yes or no' ;;
esac
for required_command in awk cat id setpriv stat tr sed sleep systemctl systemd-analyze timeout; do
    command -v "$required_command" >/dev/null 2>&1 || fail "required command not found: $required_command"
done
[ "$(id -u)" -eq 0 ] || fail 'run as root to inspect nginx process security'
if [ "$MODE" = policy ]; then
    [ -z "$MASTER_PID$PREVIOUS_MASTER_PID" ] && [ "$EXACT_WORKERS" = no ] && [ "$STARTUP_GATE" = no ] \
        || fail '--policy-only does not accept process assertions or --startup'
else
    NGINX_UID=$(id -u nginx) || fail 'nginx user is unavailable'
    NGINX_GID=$(id -g nginx) || fail 'nginx group is unavailable'
fi

# One monotonic deadline covers manager queries and process inspection, so the
# unit's TimeoutStartSec= budget stays predictable however many attempts run.
read_monotonic_time
deadline=$((MONOTONIC_CENTISECONDS + TIMEOUT_SECONDS * 100))
attempts=0
while :; do
    window_open \
        || fail "$LAST_ERROR after $attempts attempt(s); the $TIMEOUT_SECONDS-second window expired"
    attempts=$((attempts + 1))
    if inspect_service; then
        window_open || fail "verification completed outside the $TIMEOUT_SECONDS-second window"
        break
    fi
    if [ "$TIMEOUT_SECONDS" -eq 0 ] || ! window_open; then
        fail "$LAST_ERROR after $attempts attempt(s); the $TIMEOUT_SECONDS-second window expired"
    fi
    sleep 1
done
if [ "$MODE" = policy ]; then
    printf 'Verified %s composed mount-syscall denial.\n' "$NGINX_SYSTEMD_UNIT"
    exit 0
fi
printf 'Verified nginx master PID %s and %s active worker(s): Umask 0027, identities, process restrictions, composed mount-syscall denial, and log-directory traversal.\n' \
    "$observed_pid" "$active_workers"
