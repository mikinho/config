#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)

NGINX_RENDERER=$REPOSITORY_ROOT/deploy/install-nginx
HOST_TOOL_INSTALLER=$REPOSITORY_ROOT/deploy/install-host-tools
SELINUX_SETUP=$REPOSITORY_ROOT/selinux/setup
FIREWALL_SETUP=$REPOSITORY_ROOT/firewalld/setup
NGINX_UNIT_SOURCE=$REPOSITORY_ROOT/systemd/system/nginx.service
LOGROTATE_SOURCE=$REPOSITORY_ROOT/logrotate/nginx
SYSCTL_SOURCE=$REPOSITORY_ROOT/sysctl/99-nginx-quic.conf

NGINX_UNIT_TARGET=/etc/systemd/system/nginx.service
LOGROTATE_TARGET=/etc/logrotate.d/nginx
SYSCTL_TARGET=/etc/sysctl.d/99-nginx-quic.conf
NGINX_BINARY=/usr/sbin/nginx
NGINX_CONFIG=/etc/nginx/nginx.conf
NGINX_PID_FILE=/run/nginx/nginx.pid
PROC_ROOT=/proc
# Keep this in step with the shared unit. Host overrides may reduce this budget;
# setup never assumes a larger local override is safe for a shared baseline.
SHARED_TASKS_MAX=512
HELPER_TASK_RESERVE=16

MODE=apply
ZONE=public
QUIC_BPF=no
WORKERS=
THREADS_PER_WORKER=
TASKS_BUDGET=

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME --check
  $PROGRAM_NAME --plan [--workers N --threads-per-worker N --tasks-budget N] [--zone NAME] [--quic-bpf]
  $PROGRAM_NAME --capacity-check --workers N --threads-per-worker N --tasks-budget N
  sudo $PROGRAM_NAME --workers N --threads-per-worker N --tasks-budget N [--zone NAME] [--quic-bpf]

Applies the host-level runtime settings around an already assembled and
reviewed /etc/nginx tree: SELinux, firewalld, systemd, QUIC sysctl limits,
logrotate, and host verification tools. It never renders over /etc/nginx.
Install the exact reviewed nginx configuration first and ensure nginx -t passes.
Apply requires operator-reviewed worker and total per-worker pool-thread counts
matching that configuration. For worker_processes auto, inspect the host CPU
count (getconf _NPROCESSORS_ONLN); sum all configured/default thread pools.
--tasks-budget asserts reviewed available task capacity, including ancestor
cgroup limits and other services sharing them; it does not change any limit.
This command RESTARTS nginx, including an already active service: schedule a
maintenance window. A config-only reload cannot activate new systemd sandboxing.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

validate_regular_source() {
    nginx_source=$1
    [ -f "$nginx_source" ] && [ ! -L "$nginx_source" ] \
        || fail "repository source must be a regular file: $nginx_source"
}

validate_executable_source() {
    nginx_source=$1
    validate_regular_source "$nginx_source"
    [ -x "$nginx_source" ] \
        || fail "repository dependency must be executable: $nginx_source"
}

validate_sources() {
    validate_executable_source "$NGINX_RENDERER"
    validate_executable_source "$HOST_TOOL_INSTALLER"
    validate_executable_source "$SELINUX_SETUP"
    validate_executable_source "$FIREWALL_SETUP"
    validate_regular_source "$NGINX_UNIT_SOURCE"
    validate_regular_source "$LOGROTATE_SOURCE"
    validate_regular_source "$SYSCTL_SOURCE"
}

validate_zone() {
    case "$ZONE" in
        '' | -* | *[!A-Za-z0-9_-]*) fail "invalid firewalld zone: $ZONE" ;;
    esac
}

validate_capacity_inputs() {
    [ -n "$WORKERS" ] && [ -n "$THREADS_PER_WORKER" ] && [ -n "$TASKS_BUDGET" ] \
        || fail "apply requires reviewed --workers N, --threads-per-worker N, and --tasks-budget N matching the selected nginx configuration and host"
    # Bound arithmetic to signed 32-bit shell implementations and reject octal,
    # signs, whitespace, and expressions before any arithmetic expansion.
    for capacity_value in "$WORKERS" "$THREADS_PER_WORKER" "$TASKS_BUDGET"; do
        case "$capacity_value" in
            '' | *[!0-9]* | 0[0-9]*) fail "capacity counts must be canonical decimal integers from 0 to 32767" ;;
        esac
        [ "${#capacity_value}" -le 5 ] && [ "$capacity_value" -le 32767 ] \
            || fail "capacity counts must be canonical decimal integers from 0 to 32767"
    done
    [ "$WORKERS" -gt 0 ] || fail "--workers must be greater than zero"
    [ "$TASKS_BUDGET" -gt 0 ] || fail "--tasks-budget must be greater than zero"
    REQUIRED_TASKS=$((2 * WORKERS * (1 + THREADS_PER_WORKER) + HELPER_TASK_RESERVE))
    [ "$REQUIRED_TASKS" -le "$SHARED_TASKS_MAX" ] \
        || fail "nginx requires at least $REQUIRED_TASKS tasks (two worker generations plus $HELPER_TASK_RESERVE helper tasks); shared TasksMax=$SHARED_TASKS_MAX. Review worker/thread-pool sizing before applying"
    [ "$REQUIRED_TASKS" -le "$TASKS_BUDGET" ] \
        || fail "nginx requires at least $REQUIRED_TASKS tasks, but operator-reviewed --tasks-budget is $TASKS_BUDGET"
}

check_live_capacity() {
    validate_capacity_inputs
    command -v systemctl >/dev/null 2>&1 || fail "required command not found: systemctl"
    capacity_budget=$SHARED_TASKS_MAX
    [ "$TASKS_BUDGET" -ge "$capacity_budget" ] || capacity_budget=$TASKS_BUDGET
    capacity_load=$(systemctl show --property=LoadState --value nginx.service) \
        || fail "cannot inspect nginx unit load state for capacity preflight"
    case "$capacity_load" in
        not-found) capacity_limit=infinity ;;
        loaded)
            capacity_reload=$(systemctl show --property=NeedDaemonReload --value nginx.service) \
                || fail "cannot inspect nginx manager metadata for capacity preflight"
            [ "$capacity_reload" = no ] \
                || fail "nginx manager metadata is stale or unknown; review unit/drop-ins and reload systemd before capacity preflight"
            capacity_limit=$(systemctl show --property=TasksMax --value nginx.service) \
                || fail "cannot inspect nginx TasksMax; review host task limits before applying"
            ;;
        *) fail "nginx unit load state is unsupported or unknown: $capacity_load" ;;
    esac
    case "$capacity_limit" in
        infinity) ;;
        '' | *[!0-9]*) fail "nginx TasksMax is unknown; review host task limits before applying" ;;
        *)
            # systemd can return an unsigned 64-bit value; avoid shell overflow.
            capacity_budget=$(LC_ALL=C awk -v limit="$capacity_limit" -v budget="$capacity_budget" \
                'BEGIN { printf "%.0f\n", (limit < budget ? limit : budget) }')
            ;;
    esac
    [ "$REQUIRED_TASKS" -le "$capacity_budget" ] \
        || fail "nginx requires at least $REQUIRED_TASKS tasks (two worker generations plus $HELPER_TASK_RESERVE helper tasks), but checked budget is $capacity_budget; review host task limits and worker/thread-pool sizing"
    printf 'Reviewed nginx sizing: workers=%s, threads-per-worker=%s, required=%s, budget=%s.\n' \
        "$WORKERS" "$THREADS_PER_WORKER" "$REQUIRED_TASKS" "$capacity_budget"
}

read_master_pid() {
    master_pid=$(systemctl show --property=MainPID --value nginx.service) \
        || fail "cannot read nginx MainPID"
    case "$master_pid" in
        '' | *[!0-9]*) fail "nginx MainPID is unknown" ;;
    esac
}

verify_restarted_master() {
    systemctl is-active --quiet nginx.service || fail "nginx is not active after restart"
    read_master_pid
    [ "$master_pid" != 0 ] || fail "nginx has no master after restart"
    [ "$master_pid" != "$previous_master_pid" ] \
        || fail "nginx master did not change; installed systemd sandbox activation is unverified"
    [ -f "$NGINX_PID_FILE" ] && [ "$(cat "$NGINX_PID_FILE")" = "$master_pid" ] \
        || fail "nginx PID file does not match the restarted master"
    [ -r "$PROC_ROOT/$master_pid/status" ] \
        || fail "cannot inspect restarted nginx master restrictions"
    awk '$1 == "NoNewPrivs:" && $2 == "1" { found = 1 } END { exit !found }' \
        "$PROC_ROOT/$master_pid/status" \
        || fail "restarted nginx master does not have NoNewPrivileges active"
    printf 'Verified restarted nginx master PID %s with NoNewPrivileges active.\n' "$master_pid"
}

validate_target_file() {
    nginx_target=$1
    if [ -e "$nginx_target" ] || [ -L "$nginx_target" ]; then
        [ -f "$nginx_target" ] && [ ! -L "$nginx_target" ] \
            || fail "installation target must be a regular file: $nginx_target"
    fi
}

validate_live_host() {
    check_live_capacity
    [ "$(id -u)" -eq 0 ] || fail "run as root or use --plan"
    for nginx_command in install logrotate sysctl systemctl systemd-analyze; do
        command -v "$nginx_command" >/dev/null 2>&1 \
            || fail "required command not found: $nginx_command"
    done
    [ -x "$NGINX_BINARY" ] || fail "nginx binary is missing: $NGINX_BINARY"
    [ -f "$NGINX_CONFIG" ] && [ ! -L "$NGINX_CONFIG" ] \
        || fail "live nginx configuration must be a regular file: $NGINX_CONFIG"
    validate_target_file "$NGINX_UNIT_TARGET"
    validate_target_file "$LOGROTATE_TARGET"
    validate_target_file "$SYSCTL_TARGET"
    "$NGINX_RENDERER" --verify-host
    "$NGINX_BINARY" -t -q -c "$NGINX_CONFIG" \
        || fail "live nginx configuration failed pre-application validation"
    systemd-analyze --man=no verify "$NGINX_UNIT_SOURCE" \
        || fail "repository nginx unit failed pre-application validation"
    logrotate --debug "$LOGROTATE_SOURCE" >/dev/null \
        || fail "repository logrotate policy failed validation"
}

print_plan() {
    if [ -n "$WORKERS$THREADS_PER_WORKER$TASKS_BUDGET" ]; then
        validate_capacity_inputs
        printf 'Reviewed sizing inputs: workers=%s, threads-per-worker=%s; requires %s tasks within shared ceiling %s.\n' \
            "$WORKERS" "$THREADS_PER_WORKER" "$REQUIRED_TASKS" "$SHARED_TASKS_MAX"
        printf 'Operator-reviewed task budget: %s. Apply must also check the loaded unit TasksMax; this plan does not inspect the host.\n' "$TASKS_BUDGET"
    else
        printf 'Apply requires reviewed --workers N, --threads-per-worker N, and --tasks-budget N; capacity is NOT verified by this plan.\n'
    fi
    printf '+ %s --verify-host\n' "$NGINX_RENDERER"
    if [ "$QUIC_BPF" = yes ]; then
        "$SELINUX_SETUP" --plan --component nginx --quic-bpf
    else
        "$SELINUX_SETUP" --plan --component nginx
    fi
    "$FIREWALL_SETUP" --plan --service nginx --zone "$ZONE"
    printf '+ install -D -o root -g root -m 0644 %s %s\n' "$NGINX_UNIT_SOURCE" "$NGINX_UNIT_TARGET"
    printf '+ install -D -o root -g root -m 0644 %s %s\n' "$LOGROTATE_SOURCE" "$LOGROTATE_TARGET"
    printf '+ install -D -o root -g root -m 0644 %s %s\n' "$SYSCTL_SOURCE" "$SYSCTL_TARGET"
    printf '+ %s\n' "$HOST_TOOL_INSTALLER"
    printf '+ sysctl --load=%s\n' "$SYSCTL_TARGET"
    printf '+ systemctl daemon-reload\n'
    printf '+ systemd-analyze --man=no verify nginx.service\n'
    printf '+ %s -t -q -c %s\n' "$NGINX_BINARY" "$NGINX_CONFIG"
    printf 'A planned nginx restart is required to activate the installed systemd sandbox; allow a service interruption.\n'
    printf '+ recheck effective task budget after daemon-reload\n'
    printf '+ systemctl restart nginx.service\n'
    printf '+ verify active fresh master, PID file, and /proc NoNewPrivs\n'
    printf '+ systemctl enable nginx.service\n'
}

apply_runtime() {
    validate_live_host
    previous_master_pid=0
    if [ "$capacity_load" = loaded ]; then
        read_master_pid
        previous_master_pid=$master_pid
    fi
    if [ "$QUIC_BPF" = yes ]; then
        "$SELINUX_SETUP" --component nginx --quic-bpf
    else
        "$SELINUX_SETUP" --component nginx
    fi
    "$FIREWALL_SETUP" --service nginx --zone "$ZONE"
    install -D -o root -g root -m 0644 "$NGINX_UNIT_SOURCE" "$NGINX_UNIT_TARGET"
    install -D -o root -g root -m 0644 "$LOGROTATE_SOURCE" "$LOGROTATE_TARGET"
    install -D -o root -g root -m 0644 "$SYSCTL_SOURCE" "$SYSCTL_TARGET"
    "$HOST_TOOL_INSTALLER"
    if command -v restorecon >/dev/null 2>&1; then
        restorecon -RF \
            "$NGINX_UNIT_TARGET" \
            "$LOGROTATE_TARGET" \
            "$SYSCTL_TARGET"
    fi
    sysctl "--load=$SYSCTL_TARGET"
    systemctl daemon-reload
    systemd-analyze --man=no verify nginx.service
    "$NGINX_BINARY" -t -q -c "$NGINX_CONFIG"
    check_live_capacity
    printf 'Restarting nginx to activate the installed systemd runtime settings.\n'
    systemctl restart nginx.service
    verify_restarted_master
    systemctl enable nginx.service
    logrotate --debug "$LOGROTATE_TARGET" >/dev/null
    printf 'Applied nginx host runtime settings in firewalld zone %s.\n' "$ZONE"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --plan)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --capacity-check)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=capacity-check
            shift
            ;;
        --workers)
            [ "$#" -ge 2 ] || fail "--workers requires a count"
            WORKERS=$2
            shift 2
            ;;
        --threads-per-worker)
            [ "$#" -ge 2 ] || fail "--threads-per-worker requires a count"
            THREADS_PER_WORKER=$2
            shift 2
            ;;
        --tasks-budget)
            [ "$#" -ge 2 ] || fail "--tasks-budget requires a count"
            TASKS_BUDGET=$2
            shift 2
            ;;
        --quic-bpf)
            QUIC_BPF=yes
            shift
            ;;
        --zone)
            [ "$#" -ge 2 ] || fail "--zone requires a name"
            ZONE=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

validate_sources
validate_zone
if [ "$MODE" = check ]; then
    [ "$QUIC_BPF" = no ] || fail "--check does not accept --quic-bpf"
    [ -z "$WORKERS$THREADS_PER_WORKER$TASKS_BUDGET" ] || fail "--check does not accept capacity inputs"
    printf 'Validated nginx setup sources and component dependencies.\n'
    exit 0
fi

case "$MODE" in
    capacity-check) check_live_capacity ;;
    plan)
        printf 'nginx runtime setup: zone=%s, quic-bpf=%s\n' "$ZONE" "$QUIC_BPF"
        print_plan
        printf 'Plan complete; no host changes were made.\n'
        ;;
    apply) apply_runtime ;;
esac
