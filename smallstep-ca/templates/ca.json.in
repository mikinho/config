{
  "root": "/etc/step-ca/certs/root_ca.crt",
  "federatedRoots": [],
  "crt": "/etc/step-ca/certs/intermediate_ca.crt",
  "key": "/etc/step-ca/secrets/intermediate_ca_key",
  "address": "__BIND_ADDRESS__:__PORT__",
  "insecureAddress": "",
  "dnsNames": ["__SERVER_NAME__"],
  "logger": {
    "format": "json"
  },
  "db": {
    "type": "badgerv2",
    "dataSource": "/var/lib/step-ca/db"
  },
  "crl": {
    "enabled": false
  },
  "authority": {
    "disableIssuedAtCheck": false,
    "claims": {
      "minTLSCertDuration": "5m",
      "maxTLSCertDuration": "__MAX_TLS_HOURS__h",
      "defaultTLSCertDuration": "__DEFAULT_TLS_HOURS__h",
      "disableRenewal": false,
      "allowRenewalAfterExpiry": false,
      "disableSmallstepExtensions": false
    },
    "policy": {"__CONFIG_PLACEHOLDER__": "X509_POLICY"},
    "provisioners": [{"__CONFIG_PLACEHOLDER__": "PROVISIONERS"}]
  },
  "tls": {
    "minVersion": 1.2,
    "maxVersion": 1.3,
    "renegotiation": false
  }
}
