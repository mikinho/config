[Unit]
Description=Smallstep online intermediate certificate authority
Documentation=https://smallstep.com/docs/step-ca
Documentation=https://smallstep.com/docs/step-ca/certificate-authority-server-production
After=network-online.target
Wants=network-online.target
ConditionFileNotEmpty=%E/%p/config/ca.json
ConditionFileNotEmpty=%E/%p/certs/root_ca.crt
ConditionFileNotEmpty=%E/%p/certs/intermediate_ca.crt
ConditionFileNotEmpty=%E/%p/secrets/intermediate_ca_key
ConditionFileNotEmpty=%E/%p/secrets/intermediate-password

[Service]
Type=simple
User=step
Group=step
UMask=0077
# %p is the unit prefix, step-ca, so every path below follows the unit name.
# The credential path stays ${CREDENTIALS_DIRECTORY}: the %d specifier only
# exists from systemd 251, below this repository's 249 floor.
Environment=STEPPATH=%E/%p
WorkingDirectory=%S/%p
LoadCredential=intermediate.password:%E/%p/secrets/intermediate-password
ExecStart=/usr/bin/step-ca %E/%p/config/ca.json --password-file ${CREDENTIALS_DIRECTORY}/intermediate.password
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadOnlyPaths=%E/%p
ReadWritePaths=%S/%p
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
SocketBindDeny=any
SocketBindAllow=tcp:@PORT@
IPAddressDeny=any
IPAddressAllow=localhost
@ALLOWED_CLIENT_NETWORKS@

[Install]
WantedBy=multi-user.target
