[Unit]
Description=Smallstep online intermediate certificate authority
Documentation=https://smallstep.com/docs/step-ca
Documentation=https://smallstep.com/docs/step-ca/certificate-authority-server-production
After=network-online.target
Wants=network-online.target
ConditionFileNotEmpty=/etc/step-ca/config/ca.json
ConditionFileNotEmpty=/etc/step-ca/certs/root_ca.crt
ConditionFileNotEmpty=/etc/step-ca/certs/intermediate_ca.crt
ConditionFileNotEmpty=/etc/step-ca/secrets/intermediate_ca_key
ConditionFileNotEmpty=/etc/step-ca/secrets/intermediate-password

[Service]
Type=simple
User=step
Group=step
UMask=0077
Environment=STEPPATH=/etc/step-ca
WorkingDirectory=/var/lib/step-ca
LoadCredential=intermediate.password:/etc/step-ca/secrets/intermediate-password
ExecStart=/usr/bin/step-ca /etc/step-ca/config/ca.json --password-file ${CREDENTIALS_DIRECTORY}/intermediate.password
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadOnlyPaths=/etc/step-ca
ReadWritePaths=/var/lib/step-ca
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
SocketBindDeny=any
SocketBindAllow=tcp:@PORT@
IPAddressDeny=any
IPAddressAllow=localhost
@ALLOWED_CLIENT_NETWORKS@

[Install]
WantedBy=multi-user.target
