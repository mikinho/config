#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
CA_TEMPLATE=$SCRIPT_DIRECTORY/templates/ca.json.in
SYSTEMD_TEMPLATE=$SCRIPT_DIRECTORY/templates/step-ca.service.in
SOURCE_VERIFIER=$SCRIPT_DIRECTORY/verify
POLICY_VALIDATOR=$SCRIPT_DIRECTORY/validate-policy
POLICY_FILTER=$SCRIPT_DIRECTORY/lib/policy.jq
SYSTEMD_LIBRARY=$SCRIPT_DIRECTORY/lib/systemd.sh
INSTALLED_VERIFIER=/usr/local/bin/verify-step-ca
INSTALLED_POLICY_DIRECTORY=/usr/local/libexec/config-step-ca
INSTALLED_CA_TEMPLATE=$INSTALLED_POLICY_DIRECTORY/templates/ca.json.in
INSTALLED_SYSTEMD_TEMPLATE=$INSTALLED_POLICY_DIRECTORY/templates/step-ca.service.in
INSTALLED_POLICY_VALIDATOR=$INSTALLED_POLICY_DIRECTORY/validate-policy
INSTALLED_POLICY_FILTER=$INSTALLED_POLICY_DIRECTORY/lib/policy.jq
INSTALLED_SYSTEMD_LIBRARY=$INSTALLED_POLICY_DIRECTORY/lib/systemd.sh

CONFIGURATION_PATH=/etc/step-ca/config/ca.json
ROOT_CERTIFICATE_TARGET=/etc/step-ca/certs/root_ca.crt
INTERMEDIATE_CERTIFICATE_TARGET=/etc/step-ca/certs/intermediate_ca.crt
INTERMEDIATE_KEY_TARGET=/etc/step-ca/secrets/intermediate_ca_key
INTERMEDIATE_PASSWORD_TARGET=/etc/step-ca/secrets/intermediate-password
DATABASE_DIRECTORY=/var/lib/step-ca/db
SERVICE_PATH=/etc/systemd/system/step-ca.service

MODE=apply
SERVER_NAME=
BIND_ADDRESS=
PORT=8443
ROOT_CERTIFICATE_FILE=
INTERMEDIATE_CERTIFICATE_FILE=
INTERMEDIATE_PRIVATE_KEY_FILE=
INTERMEDIATE_PASSWORD_FILE=
PROVISIONERS_FILE=
X509_POLICY_FILE=
DEFAULT_TLS_HOURS=24
MAX_TLS_HOURS=720
ALLOWED_NETWORK_FILE=
ALLOWED_NETWORK_COUNT=0
NETWORK_CONTROLS_CONFIRMED=no
TEMPORARY_DIRECTORY=
ROLLBACK_REQUIRED=no

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME --check
  $PROGRAM_NAME --plan OPTIONS
  sudo $PROGRAM_NAME OPTIONS

Required options:
  --server-name DNS_NAME
  --bind-address RFC1918_IPV4
  --port PORT                         (default: 8443; must be 1024-65535)
  --root-certificate-file FILE        (public certificate only)
  --intermediate-certificate-file FILE
  --intermediate-private-key-file FILE
  --intermediate-password-file FILE
  --provisioners-file FILE            (nonempty JSON array of JWK provisioners)
  --x509-policy-file FILE             (scoped JSON authority policy)
  --allowed-client-network CIDR       (repeat; RFC 1918 only)
  --network-controls-confirmed

Certificate lifetime options:
  --default-tls-hours HOURS            (default: 24)
  --max-tls-hours HOURS                (default: 720; absolute ceiling: 840)

The root certificate, intermediate certificate, encrypted intermediate key,
JWK provisioner metadata, and policy must be prepared outside this command.
This setup never creates or imports a root private key. Apply is first-install
only and requires independent firewall/routing evidence for the exact listener.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

cleanup() {
    if [ -n "$TEMPORARY_DIRECTORY" ] && [ -d "$TEMPORARY_DIRECTORY" ]; then
        rm -rf -- "$TEMPORARY_DIRECTORY"
    fi
    if [ -n "$ALLOWED_NETWORK_FILE" ] && [ -f "$ALLOWED_NETWORK_FILE" ]; then
        rm -f -- "$ALLOWED_NETWORK_FILE"
    fi
}

rollback() {
    [ "$MODE" = apply ] || return 0
    [ "$ROLLBACK_REQUIRED" = yes ] || return 0
    systemctl disable --now step-ca.service >/dev/null 2>&1 || true
    rm -f -- "$SERVICE_PATH" "$CONFIGURATION_PATH" \
        "$ROOT_CERTIFICATE_TARGET" "$INTERMEDIATE_CERTIFICATE_TARGET" \
        "$INTERMEDIATE_KEY_TARGET" "$INTERMEDIATE_PASSWORD_TARGET"
    systemctl daemon-reload >/dev/null 2>&1 || true
}

handle_exit() {
    exit_status=$1
    trap - EXIT HUP INT TERM
    if [ "$exit_status" -ne 0 ]; then
        rollback
    fi
    cleanup
    exit "$exit_status"
}

validate_source() {
    source_path=$1
    [ -f "$source_path" ] && [ ! -L "$source_path" ] \
        || fail "repository dependency must be a regular file: $source_path"
}

validate_absolute_path() {
    path_label=$1
    path_value=$2
    case "$path_value" in
        /*) ;;
        *) fail "$path_label must be an absolute path" ;;
    esac
    case "$path_value" in
        *' '*) fail "$path_label must not contain spaces" ;;
    esac
}

validate_dns_name() {
    dns_name=$1
    case "$dns_name" in
        *[!a-z0-9.-]* | .* | *..* | *.) fail "--server-name must be a lowercase DNS name" ;;
    esac
    printf '%s\n' "$dns_name" | grep -Eq '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$' \
        || fail "--server-name must be a lowercase DNS name"
    case "$dns_name" in
        *.*) ;;
        *) fail "--server-name must contain a DNS suffix" ;;
    esac
}

validate_ipv4() {
    address_label=$1
    address_value=$2
    printf '%s\n' "$address_value" | awk -F. '
        NF != 4 { exit 1 }
        { for (field_index = 1; field_index <= 4; field_index += 1) {
              if ($field_index !~ /^[0-9]+$/ || $field_index < 0 || $field_index > 255) exit 1
          }
        }
    ' || fail "$address_label must be an IPv4 address"
}

validate_private_ipv4() {
    address_label=$1
    address_value=$2
    validate_ipv4 "$address_label" "$address_value"
    first_octet=${address_value%%.*}
    remaining_octets=${address_value#*.}
    second_octet=${remaining_octets%%.*}
    case "$first_octet:$second_octet" in
        10:* | 172:1[6-9] | 172:2[0-9] | 172:3[01] | 192:168) ;;
        *) fail "$address_label must be an RFC 1918 private address" ;;
    esac
}

validate_private_cidr() {
    cidr_value=$1
    case "$cidr_value" in
        */*) ;;
        *) fail "--allowed-client-network must use CIDR notation" ;;
    esac
    cidr_address=${cidr_value%/*}
    cidr_prefix=${cidr_value##*/}
    validate_private_ipv4 "--allowed-client-network address" "$cidr_address"
    case "$cidr_prefix" in '' | *[!0-9]*) fail "invalid client-network prefix" ;; esac
    first_octet=${cidr_address%%.*}
    remaining_octets=${cidr_address#*.}
    second_octet=${remaining_octets%%.*}
    case "$first_octet:$second_octet" in
        10:*) minimum_prefix=8 ;;
        172:*) minimum_prefix=12 ;;
        192:168) minimum_prefix=16 ;;
        *) fail "--allowed-client-network must be RFC 1918" ;;
    esac
    [ "$cidr_prefix" -ge "$minimum_prefix" ] && [ "$cidr_prefix" -le 32 ] \
        || fail "client-network prefix must stay within its RFC 1918 block"
    printf '%s\n' "$cidr_address" | awk -F. -v prefix="$cidr_prefix" '
        {
            remaining = prefix
            for (field_number = 1; field_number <= 4; field_number += 1) {
                if (remaining >= 8) {
                    network_octet = $field_number
                } else if (remaining <= 0) {
                    network_octet = 0
                } else {
                    block_size = 2 ^ (8 - remaining)
                    network_octet = int($field_number / block_size) * block_size
                }
                if ($field_number != network_octet) exit 1
                remaining -= 8
            }
        }
    ' || fail "--allowed-client-network must use its canonical network address"
}

validate_positive_integer() {
    value_label=$1
    value=$2
    case "$value" in '' | *[!0-9]*) fail "$value_label must be a positive integer" ;; esac
    [ "$value" -gt 0 ] || fail "$value_label must be a positive integer"
}

validate_service_identity() {
    getent passwd step | awk -F: '
        $1 == "step" && $3 > 0 && $3 < 1000 &&
        $6 == "/etc/step-ca" && $7 == "/usr/sbin/nologin" { valid = 1 }
        END { exit valid ? 0 : 1 }
    ' || fail "step must be a system account with the reviewed home and shell"
    [ "$(id -gn step)" = step ] && [ "$(id -Gn step)" = step ] \
        || fail "step must have only its matching primary group"
}

append_allowed_network() {
    network_value=$1
    validate_private_cidr "$network_value"
    if grep -Fx "$network_value" "$ALLOWED_NETWORK_FILE" >/dev/null 2>&1; then
        fail "--allowed-client-network values must be unique"
    fi
    printf '%s\n' "$network_value" >> "$ALLOWED_NETWORK_FILE"
    ALLOWED_NETWORK_COUNT=$((ALLOWED_NETWORK_COUNT + 1))
}

validate_sensitive_source() {
    source_label=$1
    source_path=$2
    validate_absolute_path "$source_label" "$source_path"
    [ -f "$source_path" ] && [ ! -L "$source_path" ] \
        || fail "$source_label must be a regular, non-symbolic-link file"
    source_identity=$(stat -Lc '%U:%G:%a:%h' "$source_path" 2>/dev/null) \
        || fail "cannot inspect $source_label"
    case "$source_identity" in
        root:root:400:1 | root:root:600:1) ;;
        *) fail "$source_label must be a one-link root:root mode 0400 or 0600 file" ;;
    esac
}

validate_public_source() {
    source_label=$1
    source_path=$2
    validate_absolute_path "$source_label" "$source_path"
    [ -f "$source_path" ] && [ ! -L "$source_path" ] \
        || fail "$source_label must be a regular, non-symbolic-link file"
    source_identity=$(stat -Lc '%U:%G:%a:%h' "$source_path" 2>/dev/null) \
        || fail "cannot inspect $source_label"
    case "$source_identity" in
        root:root:400:1 | root:root:600:1 | root:root:644:1) ;;
        *) fail "$source_label must be a one-link root:root mode 0400, 0600, or 0644 file" ;;
    esac
}

validate_json_inputs() {
    "$POLICY_VALIDATOR" --provisioners-file "$PROVISIONERS_FILE" \
        --x509-policy-file "$X509_POLICY_FILE" --default-tls-hours "$DEFAULT_TLS_HOURS" \
        --max-tls-hours "$MAX_TLS_HOURS" >/dev/null \
        || fail "CA issuance policy failed shared validation"
}

render_configuration() {
    output_path=$1
    jq --arg address "$BIND_ADDRESS:$PORT" \
        --arg server_name "$SERVER_NAME" \
        --arg default_duration "${DEFAULT_TLS_HOURS}h" \
        --arg max_duration "${MAX_TLS_HOURS}h" \
        --slurpfile provisioners "$PROVISIONERS_FILE" \
        --slurpfile policy "$X509_POLICY_FILE" '
            .address = $address |
            .dnsNames = [$server_name] |
            .authority.claims.defaultTLSCertDuration = $default_duration |
            .authority.claims.maxTLSCertDuration = $max_duration |
            .authority.provisioners = $provisioners[0] |
            .authority.policy = $policy[0]
        ' "$CA_TEMPLATE" > "$output_path"
}

render_service() {
    output_path=$1
    awk -v port="$PORT" -v networks="$ALLOWED_NETWORK_FILE" '
        $0 == "@ALLOWED_CLIENT_NETWORKS@" {
            while ((getline network < networks) > 0) {
                print "IPAddressAllow=" network
            }
            close(networks)
            next
        }
        { gsub(/@PORT@/, port); print }
    ' "$SYSTEMD_TEMPLATE" > "$output_path"
}

for source_path in "$CA_TEMPLATE" "$SYSTEMD_TEMPLATE" "$SOURCE_VERIFIER" "$POLICY_VALIDATOR" "$POLICY_FILTER" "$SYSTEMD_LIBRARY"; do
    validate_source "$source_path"
done

ALLOWED_NETWORK_FILE=$(mktemp "${TMPDIR:-/tmp}/config-step-ca-networks.XXXXXX")
: > "$ALLOWED_NETWORK_FILE"
trap cleanup EXIT HUP INT TERM

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --plan)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --server-name) [ "$#" -ge 2 ] || fail "--server-name requires a value"; SERVER_NAME=$2; shift 2 ;;
        --bind-address) [ "$#" -ge 2 ] || fail "--bind-address requires a value"; BIND_ADDRESS=$2; shift 2 ;;
        --port) [ "$#" -ge 2 ] || fail "--port requires a value"; PORT=$2; shift 2 ;;
        --root-certificate-file) [ "$#" -ge 2 ] || fail "--root-certificate-file requires a file"; ROOT_CERTIFICATE_FILE=$2; shift 2 ;;
        --intermediate-certificate-file) [ "$#" -ge 2 ] || fail "--intermediate-certificate-file requires a file"; INTERMEDIATE_CERTIFICATE_FILE=$2; shift 2 ;;
        --intermediate-private-key-file) [ "$#" -ge 2 ] || fail "--intermediate-private-key-file requires a file"; INTERMEDIATE_PRIVATE_KEY_FILE=$2; shift 2 ;;
        --intermediate-password-file) [ "$#" -ge 2 ] || fail "--intermediate-password-file requires a file"; INTERMEDIATE_PASSWORD_FILE=$2; shift 2 ;;
        --provisioners-file) [ "$#" -ge 2 ] || fail "--provisioners-file requires a file"; PROVISIONERS_FILE=$2; shift 2 ;;
        --x509-policy-file) [ "$#" -ge 2 ] || fail "--x509-policy-file requires a file"; X509_POLICY_FILE=$2; shift 2 ;;
        --default-tls-hours) [ "$#" -ge 2 ] || fail "--default-tls-hours requires a value"; DEFAULT_TLS_HOURS=$2; shift 2 ;;
        --max-tls-hours) [ "$#" -ge 2 ] || fail "--max-tls-hours requires a value"; MAX_TLS_HOURS=$2; shift 2 ;;
        --allowed-client-network) [ "$#" -ge 2 ] || fail "--allowed-client-network requires a CIDR"; append_allowed_network "$2"; shift 2 ;;
        --network-controls-confirmed) NETWORK_CONTROLS_CONFIRMED=yes; shift ;;
        --help | -h) usage; exit 0 ;;
        *) fail "unknown argument: $1" ;;
    esac
done

if [ "$MODE" = check ]; then
    [ -z "$SERVER_NAME$BIND_ADDRESS$ROOT_CERTIFICATE_FILE$INTERMEDIATE_CERTIFICATE_FILE$INTERMEDIATE_PRIVATE_KEY_FILE$INTERMEDIATE_PASSWORD_FILE$PROVISIONERS_FILE$X509_POLICY_FILE" ] \
        || fail "--check does not accept setup options"
    printf 'Validated Smallstep CA setup source and templates.\n'
    exit 0
fi

[ -n "$SERVER_NAME" ] || fail "--server-name is required"
[ -n "$BIND_ADDRESS" ] || fail "--bind-address is required"
[ -n "$ROOT_CERTIFICATE_FILE" ] || fail "--root-certificate-file is required"
[ -n "$INTERMEDIATE_CERTIFICATE_FILE" ] || fail "--intermediate-certificate-file is required"
[ -n "$INTERMEDIATE_PRIVATE_KEY_FILE" ] || fail "--intermediate-private-key-file is required"
[ -n "$INTERMEDIATE_PASSWORD_FILE" ] || fail "--intermediate-password-file is required"
[ -n "$PROVISIONERS_FILE" ] || fail "--provisioners-file is required"
[ -n "$X509_POLICY_FILE" ] || fail "--x509-policy-file is required"
[ "$ALLOWED_NETWORK_COUNT" -gt 0 ] || fail "at least one --allowed-client-network is required"
[ "$NETWORK_CONTROLS_CONFIRMED" = yes ] || fail "setup requires --network-controls-confirmed"
validate_dns_name "$SERVER_NAME"
validate_private_ipv4 "--bind-address" "$BIND_ADDRESS"
validate_positive_integer "--port" "$PORT"
[ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] \
    || fail "--port must be between 1024 and 65535"
validate_positive_integer "--default-tls-hours" "$DEFAULT_TLS_HOURS"
validate_positive_integer "--max-tls-hours" "$MAX_TLS_HOURS"
[ "$DEFAULT_TLS_HOURS" -le "$MAX_TLS_HOURS" ] \
    || fail "default TLS duration must not exceed the maximum"
[ "$DEFAULT_TLS_HOURS" -le 168 ] \
    || fail "default TLS duration must not exceed 168 hours"
[ "$MAX_TLS_HOURS" -le 840 ] \
    || fail "maximum TLS duration must not exceed the 840-hour absolute ceiling"
for path_pair in \
    "root certificate:$ROOT_CERTIFICATE_FILE" \
    "intermediate certificate:$INTERMEDIATE_CERTIFICATE_FILE" \
    "intermediate private key:$INTERMEDIATE_PRIVATE_KEY_FILE" \
    "intermediate password:$INTERMEDIATE_PASSWORD_FILE" \
    "provisioners JSON:$PROVISIONERS_FILE" \
    "X.509 policy JSON:$X509_POLICY_FILE"
do
    validate_absolute_path "${path_pair%%:*}" "${path_pair#*:}"
done

printf 'Smallstep CA listener: %s (%s:%s)\n' "$SERVER_NAME" "$BIND_ADDRESS" "$PORT"
printf 'Allowed client networks: %s exact RFC 1918 CIDR(s)\n' "$ALLOWED_NETWORK_COUNT"
printf 'TLS certificate lifetime: default %sh, maximum %sh\n' \
    "$DEFAULT_TLS_HOURS" "$MAX_TLS_HOURS"
if [ "$MAX_TLS_HOURS" -gt 720 ]; then
    printf 'Exception notice: maximum exceeds the preferred 720-hour service-certificate ceiling.\n'
fi

if [ "$MODE" = plan ]; then
    printf '+ validate the offline-root certificate and online intermediate chain\n'
    printf '+ prove the encrypted intermediate key matches its certificate\n'
    printf '+ require JWK-only provisioners and a scoped X.509 issuance policy\n'
    printf '+ install root-owned CA material; no root private key is accepted or generated\n'
    printf '+ install a hardened systemd service with exact source-network controls\n'
    printf '+ enable, start, and verify the TLS health endpoint and unit policy\n'
    printf 'Plan complete; no input file or secret was read.\n'
    exit 0
fi

[ "$(id -u)" -eq 0 ] || fail "run as root or use --plan"
for required_command in awk cmp getent grep id install jq mktemp openssl restorecon stat systemctl useradd; do
    command -v "$required_command" >/dev/null 2>&1 \
        || fail "required command not found: $required_command"
done
for existing_target in \
    "$CONFIGURATION_PATH" "$ROOT_CERTIFICATE_TARGET" \
    "$INTERMEDIATE_CERTIFICATE_TARGET" "$INTERMEDIATE_KEY_TARGET" \
    "$INTERMEDIATE_PASSWORD_TARGET" "$SERVICE_PATH"
do
    if [ -e "$existing_target" ] || [ -L "$existing_target" ]; then
        fail "first-install setup refuses existing target: $existing_target"
    fi
done
[ ! -e /etc/step-ca/secrets/root_ca_key ] && [ ! -L /etc/step-ca/secrets/root_ca_key ] \
    || fail "root private key must not exist on the online CA host"
for policy_pair in \
    "verifier:$SOURCE_VERIFIER:$INSTALLED_VERIFIER" \
    "CA template:$CA_TEMPLATE:$INSTALLED_CA_TEMPLATE" \
    "systemd template:$SYSTEMD_TEMPLATE:$INSTALLED_SYSTEMD_TEMPLATE" \
    "issuance validator:$POLICY_VALIDATOR:$INSTALLED_POLICY_VALIDATOR" \
    "issuance filter:$POLICY_FILTER:$INSTALLED_POLICY_FILTER" \
    "effective unit policy:$SYSTEMD_LIBRARY:$INSTALLED_SYSTEMD_LIBRARY"
do
    policy_label=${policy_pair%%:*}
    policy_paths=${policy_pair#*:}
    source_policy=${policy_paths%%:*}
    installed_policy=${policy_paths#*:}
    validate_source "$installed_policy"
    cmp -s "$source_policy" "$installed_policy" \
        || fail "installed $policy_label differs; rerun the reviewed installer"
done
[ -x "$INSTALLED_VERIFIER" ] \
    || fail "installed verifier is not executable: $INSTALLED_VERIFIER"
validate_public_source "root certificate" "$ROOT_CERTIFICATE_FILE"
validate_public_source "intermediate certificate" "$INTERMEDIATE_CERTIFICATE_FILE"
validate_sensitive_source "intermediate private key" "$INTERMEDIATE_PRIVATE_KEY_FILE"
validate_sensitive_source "intermediate password" "$INTERMEDIATE_PASSWORD_FILE"
validate_sensitive_source "provisioners JSON" "$PROVISIONERS_FILE"
validate_sensitive_source "X.509 policy JSON" "$X509_POLICY_FILE"
validate_json_inputs

TEMPORARY_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/config-step-ca-setup.XXXXXX")
umask 077
trap 'handle_exit $?' EXIT
trap 'exit 1' HUP INT TERM

openssl x509 -in "$ROOT_CERTIFICATE_FILE" -noout -text \
    | grep -F 'CA:TRUE' >/dev/null \
    || fail "root certificate must assert CA:TRUE"
root_subject=$(openssl x509 -in "$ROOT_CERTIFICATE_FILE" -noout -subject -nameopt RFC2253)
root_issuer=$(openssl x509 -in "$ROOT_CERTIFICATE_FILE" -noout -issuer -nameopt RFC2253)
[ "${root_subject#subject=}" = "${root_issuer#issuer=}" ] \
    || fail "root certificate must be self-issued"
openssl x509 -checkend 31536000 -noout -in "$ROOT_CERTIFICATE_FILE" \
    || fail "root certificate must remain valid for at least one year"
openssl verify -check_ss_sig -CAfile "$ROOT_CERTIFICATE_FILE" \
    "$ROOT_CERTIFICATE_FILE" >/dev/null \
    || fail "root certificate must verify as its own trust anchor"
openssl x509 -in "$INTERMEDIATE_CERTIFICATE_FILE" -noout -text \
    | grep -F 'CA:TRUE, pathlen:0' >/dev/null \
    || fail "intermediate certificate must assert CA:TRUE with pathlen:0"
openssl verify -CAfile "$ROOT_CERTIFICATE_FILE" "$INTERMEDIATE_CERTIFICATE_FILE" >/dev/null \
    || fail "intermediate certificate does not verify under the supplied root"
openssl x509 -checkend 2678400 -noout -in "$INTERMEDIATE_CERTIFICATE_FILE" \
    || fail "intermediate certificate must remain valid for at least 31 days"
grep -Fx -- '-----BEGIN ENCRYPTED PRIVATE KEY-----' \
    "$INTERMEDIATE_PRIVATE_KEY_FILE" >/dev/null \
    || fail "intermediate private key must use encrypted PKCS #8 PEM"
awk 'NR == 1 && length($0) >= 16 { valid = 1; next } { exit 1 } \
    END { exit valid ? 0 : 1 }' "$INTERMEDIATE_PASSWORD_FILE" \
    || fail "intermediate password file must contain one value of at least 16 characters"
openssl pkey -in "$INTERMEDIATE_PRIVATE_KEY_FILE" \
    -passin "file:$INTERMEDIATE_PASSWORD_FILE" -pubout \
    -out "$TEMPORARY_DIRECTORY/key.pub"
openssl x509 -in "$INTERMEDIATE_CERTIFICATE_FILE" -pubkey -noout \
    -out "$TEMPORARY_DIRECTORY/certificate.pub"
cmp -s "$TEMPORARY_DIRECTORY/key.pub" "$TEMPORARY_DIRECTORY/certificate.pub" \
    || fail "intermediate private key does not match its certificate"

render_configuration "$TEMPORARY_DIRECTORY/ca.json"
render_service "$TEMPORARY_DIRECTORY/step-ca.service"
jq -e 'has("password") | not' "$TEMPORARY_DIRECTORY/ca.json" >/dev/null \
    || fail "rendered configuration contains a plaintext password field"
grep -E '__[A-Z0-9_]+__' "$TEMPORARY_DIRECTORY/ca.json" >/dev/null 2>&1 \
    && fail "rendered configuration contains an unresolved template token"
grep -E '@(PORT|ALLOWED_CLIENT_NETWORKS)@' \
    "$TEMPORARY_DIRECTORY/step-ca.service" >/dev/null 2>&1 \
    && fail "rendered service contains an unresolved template token"

if ! id step >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /etc/step-ca \
        --shell /usr/sbin/nologin step
fi
validate_service_identity
install -d -o root -g root -m 0755 /etc/step-ca
install -d -o root -g step -m 0750 /etc/step-ca/config /etc/step-ca/certs
install -d -o root -g step -m 0710 /etc/step-ca/secrets
install -d -o step -g step -m 0700 /var/lib/step-ca "$DATABASE_DIRECTORY"
ROLLBACK_REQUIRED=yes
install -o root -g step -m 0440 "$TEMPORARY_DIRECTORY/ca.json" "$CONFIGURATION_PATH"
install -o root -g step -m 0440 "$ROOT_CERTIFICATE_FILE" "$ROOT_CERTIFICATE_TARGET"
install -o root -g step -m 0440 "$INTERMEDIATE_CERTIFICATE_FILE" \
    "$INTERMEDIATE_CERTIFICATE_TARGET"
install -o root -g step -m 0440 "$INTERMEDIATE_PRIVATE_KEY_FILE" \
    "$INTERMEDIATE_KEY_TARGET"
install -o root -g root -m 0600 "$INTERMEDIATE_PASSWORD_FILE" \
    "$INTERMEDIATE_PASSWORD_TARGET"
install -o root -g root -m 0644 "$TEMPORARY_DIRECTORY/step-ca.service" "$SERVICE_PATH"
restorecon -R /etc/step-ca /var/lib/step-ca "$SERVICE_PATH"
systemctl daemon-reload
systemctl enable --now step-ca.service

set -- --server-name "$SERVER_NAME" --bind-address "$BIND_ADDRESS" --port "$PORT" \
    --default-tls-hours "$DEFAULT_TLS_HOURS" --max-tls-hours "$MAX_TLS_HOURS"
while IFS= read -r allowed_network; do
    set -- "$@" --allowed-client-network "$allowed_network"
done < "$ALLOWED_NETWORK_FILE"
"$INSTALLED_VERIFIER" "$@"
ROLLBACK_REQUIRED=no
printf 'Initialized and verified the online intermediate CA; no root private key was installed.\n'
