#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
PLATFORM_LIBRARY=$REPOSITORY_ROOT/deploy/lib/platform.sh
VERIFIER_SOURCE=$SCRIPT_DIRECTORY/verify
COMMON_LIBRARY_SOURCE=$SCRIPT_DIRECTORY/lib/common.sh
LOCAL_CACHE_TEMPLATE_SOURCE=$SCRIPT_DIRECTORY/templates/redis-local-cache.conf.in
LOCAL_DURABLE_TEMPLATE_SOURCE=$SCRIPT_DIRECTORY/templates/redis-local-durable.conf.in
NETWORK_CACHE_TEMPLATE_SOURCE=$SCRIPT_DIRECTORY/templates/redis-network-cache.conf.in
NETWORK_DURABLE_TEMPLATE_SOURCE=$SCRIPT_DIRECTORY/templates/redis-network-durable.conf.in
SYSTEMD_TEMPLATE_SOURCE=$SCRIPT_DIRECTORY/templates/redis.service.conf.in
PACKAGE_MANIFEST_SOURCE=$SCRIPT_DIRECTORY/packages-8.2.9.manifest
BUNDLE_METADATA=$REPOSITORY_ROOT/BUNDLE-METADATA
BUNDLE_CHECKSUMS=$REPOSITORY_ROOT/SHA256SUMS

REDIS_SERIES=8.2
REDIS_VERSION=8.2.9
REDIS_KEY_URL=https://packages.redis.io/gpg
REDIS_KEY_FINGERPRINT=54318FA4052D1E61A6B6F7BB5F4349D6BF53AA0C
REDIS_KEY_ID=5F4349D6BF53AA0C
REDIS_REPOSITORY_BASE_URL=https://packages.redis.io/rpm/rockylinux9
REPOSITORY_DIRECTORY=/etc/yum.repos.d
REPOSITORY_TARGET=$REPOSITORY_DIRECTORY/redis-official-8.2.repo
KEY_TARGET=/etc/pki/rpm-gpg/REDIS-OFFICIAL
VERIFIER_TARGET=/usr/local/bin/verify-redis
VERIFIER_LIBRARY_DIRECTORY=/usr/local/libexec/config-redis
PACKAGE_MANIFEST_TARGET=$VERIFIER_LIBRARY_DIRECTORY/packages-8.2.9.manifest

MODE=install
OS_RELEASE_FILE=/etc/os-release
OS_RELEASE_OVERRIDDEN=no
ARCHITECTURE_OVERRIDE=
TEMPORARY_DIRECTORY=
SERVICE_WAS_ENABLED=no

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME
  $PROGRAM_NAME --plan [--os-release FILE] [--architecture x86_64]
  $PROGRAM_NAME --check
  sudo $PROGRAM_NAME --check-bundle

Installs the reviewed Redis Open Source $REDIS_SERIES extended release from
Redis's official Rocky Linux 9 repository after verifying the full signing-key
fingerprint and exact RPM digest. Rocky Linux 9 is the preferred platform;
CentOS Stream 9 is an EL9 compatibility platform for existing hosts. It
installs the verifier and four templates but does not start or enable
redis.service. Run redis/setup after reviewing the selected listener model and
data profile.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

cleanup() {
    if [ -n "$TEMPORARY_DIRECTORY" ] && [ -d "$TEMPORARY_DIRECTORY" ]; then
        rm -rf -- "$TEMPORARY_DIRECTORY"
    fi
}

validate_source() {
    install_source=$1
    [ -f "$install_source" ] && [ ! -L "$install_source" ] \
        || fail "repository dependency must be a regular file: $install_source"
}

validate_root_directory() {
    directory_path=$1
    [ -d "$directory_path" ] && [ ! -L "$directory_path" ] \
        || fail "target must be a real directory: $directory_path"
    directory_identity=$(stat -Lc '%U:%a' "$directory_path" 2>/dev/null) \
        || fail "cannot inspect target directory: $directory_path"
    directory_owner=${directory_identity%:*}
    directory_mode=${directory_identity##*:}
    [ "$directory_owner" = root ] \
        || fail "target directory must be owned by root: $directory_path"
    if [ "$((0$directory_mode & 0022))" -ne 0 ]; then
        fail "target directory must not be writable by group or other: $directory_path"
    fi
}

redis_package_manifest() {
    cat -- "$PACKAGE_MANIFEST_SOURCE"
}

validate_execution_bundle() {
    for bundle_command in awk find grep sha256sum stat; do
        command -v "$bundle_command" >/dev/null 2>&1 \
            || fail "required bundle-validation command not found: $bundle_command"
    done
    [ -d "$REPOSITORY_ROOT" ] && [ ! -L "$REPOSITORY_ROOT" ] \
        || fail "deployment bundle root must be a real directory"
    bundle_parent=$REPOSITORY_ROOT
    while :; do
        bundle_parent_identity=$(stat -Lc '%U:%G:%a' "$bundle_parent" 2>/dev/null) \
            || fail "cannot inspect deployment bundle parent: $bundle_parent"
        bundle_parent_owner=${bundle_parent_identity%%:*}
        bundle_parent_remainder=${bundle_parent_identity#*:}
        bundle_parent_group=${bundle_parent_remainder%%:*}
        bundle_parent_mode=${bundle_parent_identity##*:}
        [ "$bundle_parent_owner:$bundle_parent_group" = root:root ] \
            || fail "deployment bundle parent must be root:root: $bundle_parent"
        if [ "$((0$bundle_parent_mode & 0022))" -ne 0 ]; then
            fail "deployment bundle parent must not be writable by group or other: $bundle_parent"
        fi
        [ "$bundle_parent" = / ] || [ "$bundle_parent" = /root ] || {
            bundle_parent=$(dirname -- "$bundle_parent")
            continue
        }
        break
    done
    bundle_unsafe_entry=$(find "$REPOSITORY_ROOT" -xdev \
        \( -type l -o \( ! -type d ! -type f \) \
           -o ! -user root -o ! -group root -o -perm /022 \
           -o \( -type f ! -links 1 \) \) -print -quit)
    [ -z "$bundle_unsafe_entry" ] \
        || fail "unsafe deployment bundle entry: $bundle_unsafe_entry"
    [ "$(stat -Lc '%U:%G:%a:%h' "$BUNDLE_METADATA" 2>/dev/null)" = root:root:644:1 ] \
        || fail "deployment bundle metadata must be a one-link root:root mode 0644 file"
    [ "$(stat -Lc '%U:%G:%a:%h' "$BUNDLE_CHECKSUMS" 2>/dev/null)" = root:root:644:1 ] \
        || fail "deployment bundle checksums must be a one-link root:root mode 0644 file"
    grep -Eq '^sourceRevision=[0-9a-f]{40}$' "$BUNDLE_METADATA" \
        || fail "deployment bundle metadata has no exact Git source revision"
    for bundle_required_path in \
        BUNDLE-METADATA deploy/lib/platform.sh redis/install redis/setup \
        redis/verify redis/lib/common.sh redis/packages-8.2.9.manifest \
        redis/templates/redis-local-cache.conf.in \
        redis/templates/redis-local-durable.conf.in \
        redis/templates/redis-network-cache.conf.in \
        redis/templates/redis-network-durable.conf.in \
        redis/templates/redis.service.conf.in
    do
        awk -v expected="$bundle_required_path" \
            '$1 ~ /^[0-9a-f]{64}$/ && $2 == expected { matches += 1 } \
             END { exit matches == 1 ? 0 : 1 }' "$BUNDLE_CHECKSUMS" \
            || fail "deployment bundle checksum manifest must contain exactly: $bundle_required_path"
    done
    (cd "$REPOSITORY_ROOT" && sha256sum --strict --check SHA256SUMS >/dev/null) \
        || fail "deployment bundle checksum verification failed"
}

for install_source in \
    "$PLATFORM_LIBRARY" "$VERIFIER_SOURCE" "$COMMON_LIBRARY_SOURCE" \
    "$LOCAL_CACHE_TEMPLATE_SOURCE" "$LOCAL_DURABLE_TEMPLATE_SOURCE" \
    "$NETWORK_CACHE_TEMPLATE_SOURCE" "$NETWORK_DURABLE_TEMPLATE_SOURCE" \
    "$SYSTEMD_TEMPLATE_SOURCE" "$PACKAGE_MANIFEST_SOURCE"
do
    validate_source "$install_source"
done
[ -x "$VERIFIER_SOURCE" ] || fail "verifier must be executable: $VERIFIER_SOURCE"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = install ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --check-bundle)
            [ "$MODE" = install ] || fail "select exactly one mode"
            MODE=bundle-check
            shift
            ;;
        --plan)
            [ "$MODE" = install ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --os-release)
            [ "$#" -ge 2 ] || fail "--os-release requires a file"
            OS_RELEASE_FILE=$2
            OS_RELEASE_OVERRIDDEN=yes
            shift 2
            ;;
        --architecture)
            [ "$#" -ge 2 ] || fail "--architecture requires a value"
            ARCHITECTURE_OVERRIDE=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

if [ "$MODE" != plan ] && [ "$OS_RELEASE_OVERRIDDEN" = yes ]; then
    fail "--os-release is accepted only with --plan"
fi
if [ "$MODE" != plan ] && [ -n "$ARCHITECTURE_OVERRIDE" ]; then
    fail "--architecture is accepted only with --plan"
fi
if [ "$MODE" = install ] || [ "$MODE" = bundle-check ]; then
    [ "$(id -u)" -eq 0 ] || fail "run as root or use --plan"
    validate_execution_bundle
fi
if [ "$MODE" = bundle-check ]; then
    printf 'Validated root-owned immutable Redis deployment bundle.\n'
    exit 0
fi

# shellcheck disable=SC1090,SC1091
. "$PLATFORM_LIBRARY"

if [ "$MODE" = check ]; then
    "$VERIFIER_SOURCE" --check >/dev/null
    printf 'Validated Redis installer and verifier sources.\n'
    exit 0
fi

# shellcheck disable=SC2034
PLATFORM_MODE=$MODE
platform_detect_supported_os "$OS_RELEASE_FILE"
if [ -n "$ARCHITECTURE_OVERRIDE" ]; then
    PLATFORM_OS_ARCHITECTURE=$ARCHITECTURE_OVERRIDE
fi
case "$PLATFORM_OS_ID:$PLATFORM_OS_VERSION_MAJOR" in
    rocky:9) REDIS_PLATFORM_PROFILE='official Rocky Linux 9 platform' ;;
    centos:9) REDIS_PLATFORM_PROFILE='reviewed CentOS Stream 9 EL9 compatibility platform' ;;
    *) fail "Redis $REDIS_SERIES is supported here only on Rocky Linux 9 or CentOS Stream 9" ;;
esac
[ "$PLATFORM_OS_ARCHITECTURE" = x86_64 ] \
    || fail "Redis $REDIS_SERIES official package is supported here only on x86_64"

printf 'Redis installation target: %s (%s)\n' \
    "$PLATFORM_OS_LABEL" "$PLATFORM_OS_ARCHITECTURE"
printf 'Redis platform profile: %s\n' "$REDIS_PLATFORM_PROFILE"
printf 'Redis package series: %s extended release\n' "$REDIS_SERIES"
printf 'Reviewed Redis package release: %s\n' "$REDIS_VERSION"

if [ "$MODE" = plan ]; then
    platform_print_command dnf install --assumeyes ca-certificates curl gnupg2 openssl
    platform_print_command curl --fail --location --silent --show-error \
        --output /tmp/REDIS-OFFICIAL "$REDIS_KEY_URL"
    printf '+ verify OpenPGP fingerprint %s\n' "$REDIS_KEY_FINGERPRINT"
    platform_print_command install -o root -g root -m 0644 \
        /tmp/REDIS-OFFICIAL "$KEY_TARGET"
    printf '+ install disabled exact %s with baseurl %s/\n' \
        "$REPOSITORY_TARGET" "$REDIS_REPOSITORY_BASE_URL"
    printf '+ import verified signing key into the RPM database\n'
    printf '+ download, SHA-256 check, and rpmkeys verify these exact packages:\n'
    redis_package_manifest | awk -F'|' '{ printf "  %s-%s\n", $1, $2 }'
    printf '+ install the verified local RPM and reject package substitution\n'
    printf '+ install verifier policy under %s\n' "$VERIFIER_LIBRARY_DIRECTORY"
    printf 'Plan complete; redis.service would remain stopped and disabled.\n'
    exit 0
fi

for required_command in awk cmp curl dnf gpg grep install mktemp rpm rpmkeys sha256sum stat systemctl; do
    command -v "$required_command" >/dev/null 2>&1 \
        || fail "required command not found: $required_command"
done
validate_root_directory /etc
validate_root_directory /etc/pki
validate_root_directory /etc/pki/rpm-gpg
validate_root_directory "$REPOSITORY_DIRECTORY"
validate_root_directory /usr/local
validate_root_directory /usr/local/bin
if systemctl is-active --quiet redis.service 2>/dev/null; then
    fail "refusing package changes while redis.service is active"
fi
if systemctl is-enabled --quiet redis.service 2>/dev/null; then
    SERVICE_WAS_ENABLED=yes
fi
if command -v redis-server >/dev/null 2>&1; then
    redis-server --version 2>/dev/null | grep -Eq 'v=8\.2\.' \
        || fail "an installed Redis server is not from the $REDIS_SERIES extended series"
fi
for managed_target in "$REPOSITORY_TARGET" "$KEY_TARGET" "$VERIFIER_TARGET"; do
    if [ -e "$managed_target" ] || [ -L "$managed_target" ]; then
        [ -f "$managed_target" ] && [ ! -L "$managed_target" ] \
            || fail "managed target must be a regular, non-symbolic-link file: $managed_target"
    fi
done

TEMPORARY_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/config-redis-install.XXXXXX")
umask 077
trap cleanup EXIT HUP INT TERM

dnf install --assumeyes ca-certificates curl gnupg2 openssl
curl --fail --location --silent --show-error \
    --output "$TEMPORARY_DIRECTORY/REDIS-OFFICIAL" "$REDIS_KEY_URL"
install -d -m 0700 "$TEMPORARY_DIRECTORY/gnupg"
downloaded_primary_fingerprints=$(gpg --batch --homedir "$TEMPORARY_DIRECTORY/gnupg" \
    --with-colons --show-keys "$TEMPORARY_DIRECTORY/REDIS-OFFICIAL" 2>/dev/null \
    | awk -F: '$1 == "pub" { primary = 1; next } \
        primary && $1 == "fpr" { print toupper($10); primary = 0 }')
[ "$downloaded_primary_fingerprints" = "$REDIS_KEY_FINGERPRINT" ] \
    || fail "Redis signing-key file must contain only the pinned primary fingerprint"
install -o root -g root -m 0644 \
    "$TEMPORARY_DIRECTORY/REDIS-OFFICIAL" "$KEY_TARGET"

cat > "$TEMPORARY_DIRECTORY/redis-official-8.2.repo" <<EOF
[redis-official-8.2]
name=Redis official Rocky Linux 9 repository
baseurl=$REDIS_REPOSITORY_BASE_URL/
gpgcheck=1
repo_gpgcheck=0
gpgkey=file://$KEY_TARGET
enabled=0
EOF
install -o root -g root -m 0644 \
    "$TEMPORARY_DIRECTORY/redis-official-8.2.repo" "$REPOSITORY_TARGET"

competing_repositories=$(dnf -q repolist --enabled 2>/dev/null \
    | awk '$1 ~ /^redis/ && $1 != "redis-official-8.2" { print $1 }')
[ -z "$competing_repositories" ] \
    || fail "disable reviewed competing Redis repositories before continuing: $competing_repositories"

rpm --import "$KEY_TARGET"
set --
package_count=0
while IFS='|' read -r package_name package_nevra package_filename package_sha256; do
    [ -n "$package_name" ] || continue
    package_path=$TEMPORARY_DIRECTORY/$package_filename
    curl --fail --location --silent --show-error \
        --output "$package_path" "$REDIS_REPOSITORY_BASE_URL/amd64/$package_filename"
    printf '%s  %s\n' "$package_sha256" "$package_path" \
        | sha256sum --check --status - \
        || fail "Redis RPM SHA-256 mismatch: $package_filename"
    rpmkeys --checksig "$package_path" >/dev/null 2>&1 \
        || fail "Redis RPM signature verification failed: $package_filename"
    package_signature=$(rpm -qp --qf '%{RSAHEADER:pgpsig}\n' "$package_path" 2>/dev/null || true)
    printf '%s\n' "$package_signature" | grep -qi "Key ID $REDIS_KEY_ID" \
        || fail "Redis RPM signature does not identify the pinned key: $package_filename"
    set -- "$@" "$package_path"
    package_count=$((package_count + 1))
done <<EOF
$(redis_package_manifest)
EOF
[ "$package_count" -eq 1 ] || fail "reviewed Redis package manifest is incomplete"
dnf install --assumeyes "$@"

while IFS='|' read -r package_name package_nevra package_filename package_sha256; do
    [ -n "$package_name" ] || continue
    installed_nevra=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' "$package_name" 2>/dev/null || true)
    [ "$installed_nevra" = "$package_nevra" ] \
        || fail "$package_name must be installed as $package_nevra (found ${installed_nevra:-missing})"
done <<EOF
$(redis_package_manifest)
EOF

install -d -o root -g root -m 0755 "$VERIFIER_LIBRARY_DIRECTORY"
install -d -o root -g root -m 0755 "$VERIFIER_LIBRARY_DIRECTORY/templates"
install -o root -g root -m 0755 "$VERIFIER_SOURCE" "$VERIFIER_TARGET"
install -o root -g root -m 0644 "$COMMON_LIBRARY_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/common.sh"
install -o root -g root -m 0644 "$PACKAGE_MANIFEST_SOURCE" "$PACKAGE_MANIFEST_TARGET"
install -o root -g root -m 0644 "$LOCAL_CACHE_TEMPLATE_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/templates/redis-local-cache.conf.in"
install -o root -g root -m 0644 "$LOCAL_DURABLE_TEMPLATE_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/templates/redis-local-durable.conf.in"
install -o root -g root -m 0644 "$NETWORK_CACHE_TEMPLATE_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/templates/redis-network-cache.conf.in"
install -o root -g root -m 0644 "$NETWORK_DURABLE_TEMPLATE_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/templates/redis-network-durable.conf.in"
install -o root -g root -m 0644 "$SYSTEMD_TEMPLATE_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/templates/redis.service.conf.in"

systemctl disable redis.service >/dev/null 2>&1 || true
systemctl stop redis.service >/dev/null 2>&1 || true
if [ "$SERVICE_WAS_ENABLED" = yes ]; then
    printf 'Notice: redis.service was enabled before installation and is now disabled.\n'
fi
printf 'Installed and pinned Redis %s; redis.service remains stopped and disabled.\n' \
    "$REDIS_VERSION"
printf 'Next: review redis/setup --plan, then initialize one approved Redis configuration.\n'
