# redis/templates/redis-local-cache.conf.in

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

bind 127.0.0.1
protected-mode yes
port 6379
tls-port 0
tcp-backlog 511
timeout 0
tcp-keepalive 300
unixsocket /run/redis/redis.sock
unixsocketperm 0770

daemonize no
supervised systemd
pidfile /run/redis/redis-server.pid
loglevel notice
logfile ""
always-show-logo no
disable-thp yes

databases 1
aclfile /etc/redis/users.acl
acl-pubsub-default resetchannels
acllog-max-len 128
enable-protected-configs no
enable-debug-command no
enable-module-command no

maxclients 10000
maxmemory @MAXMEMORY_MIB@mb
maxmemory-policy allkeys-lru
maxmemory-samples 5

stop-writes-on-bgsave-error no
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir /var/lib/redis
save ""

appendonly no

slowlog-log-slower-than -1
slowlog-max-len 128
latency-monitor-threshold 100
notify-keyspace-events ""
