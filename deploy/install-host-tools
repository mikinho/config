#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
TARGET_DIRECTORY=/usr/local/bin
LIBEXEC_DIRECTORY=/usr/local/libexec

usage() {
    cat <<EOF
Usage:
  sudo $PROGRAM_NAME
  $PROGRAM_NAME --check

Installs the reviewed host verifier and certificate healthcheck under
$TARGET_DIRECTORY and nginx runtime verifier under $LIBEXEC_DIRECTORY,
as root-owned executables. --check validates sources without modifying the host.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

validate_source() {
    source_path=$1
    if [ ! -f "$source_path" ] || [ -L "$source_path" ] || [ ! -x "$source_path" ]; then
        fail "source must be a real executable file: $source_path"
    fi
}

validate_target_directory() {
    checked_directory=$1
    if [ ! -d "$checked_directory" ] || [ -L "$checked_directory" ]; then
        fail "target must be a real directory: $checked_directory"
    fi
    target_identity=$(stat -Lc '%U:%G:%a' "$checked_directory" 2>/dev/null) \
        || fail "cannot inspect target directory: $checked_directory"
    target_owner_group=${target_identity%:*}
    target_mode=${target_identity##*:}
    [ "$target_owner_group" = root:root ] \
        || fail "$checked_directory must be owned by root:root"
    [ "$target_mode" = 755 ] \
        || fail "$checked_directory must have mode 0755 (found $target_mode)"
}

install_tool() {
    source_path=$1
    target_path=$2
    [ ! -L "$target_path" ] || fail "refusing symbolic-link target: $target_path"
    if [ -e "$target_path" ]; then
        [ -f "$target_path" ] || fail "target is not a regular file: $target_path"
    fi
    install -o root -g root -m 0755 "$source_path" "$target_path"
    cmp -s "$source_path" "$target_path" \
        || fail "installed tool differs from repository source: $target_path"
    [ "$(stat -Lc '%U:%G:%a' "$target_path")" = root:root:755 ] \
        || fail "installed tool has unsafe ownership or mode: $target_path"
}

mode=install
while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$mode" = install ] || fail "select exactly one mode"
            mode=check
            shift
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

validate_source "$SCRIPT_DIRECTORY/verify-deployment"
validate_source "$SCRIPT_DIRECTORY/certbot-healthcheck"
validate_source "$SCRIPT_DIRECTORY/../nginx/verify-runtime"

if [ "$mode" = check ]; then
    printf 'Validated host-tool repository sources.\n'
    exit 0
fi

[ "$(id -u)" -eq 0 ] || fail "run as root"
command -v install >/dev/null 2>&1 || fail "install command not found"
command -v cmp >/dev/null 2>&1 || fail "cmp command not found"
validate_target_directory /usr/local
validate_target_directory "$TARGET_DIRECTORY"
if [ ! -e "$LIBEXEC_DIRECTORY" ] && [ ! -L "$LIBEXEC_DIRECTORY" ]; then
    install -d -o root -g root -m 0755 "$LIBEXEC_DIRECTORY"
fi
validate_target_directory "$LIBEXEC_DIRECTORY"
install_tool "$SCRIPT_DIRECTORY/verify-deployment" "$TARGET_DIRECTORY/verify-deployment"
install_tool "$SCRIPT_DIRECTORY/certbot-healthcheck" "$TARGET_DIRECTORY/certbot-healthcheck"
install_tool "$SCRIPT_DIRECTORY/../nginx/verify-runtime" "$LIBEXEC_DIRECTORY/nginx-runtime-verify"
if command -v restorecon >/dev/null 2>&1; then
    restorecon -F "$TARGET_DIRECTORY/verify-deployment" \
        "$TARGET_DIRECTORY/certbot-healthcheck" "$LIBEXEC_DIRECTORY/nginx-runtime-verify"
fi

printf 'Installed root-owned host tools under %s and %s.\n' "$TARGET_DIRECTORY" "$LIBEXEC_DIRECTORY"
