# deploy/application/templates/ssh-maintenance.conf.in

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

# Fail-closed guard installed while deployment policy is being reconciled.
DenyUsers @@DEPLOY_USER@@

Match User @@DEPLOY_USER@@
    ForceCommand /bin/false
    PermitUserRC no
    PermitTTY no
    X11Forwarding no
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    PermitTunnel no

Match all
