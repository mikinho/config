# deploy/application/templates/finalizer.path.in

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

[Unit]
Description=Watch for the @@APPLICATION_TAG@@ deployment sentinel
Wants=@@RECOVERY_SERVICE@@
After=@@RECOVERY_SERVICE@@

[Path]
PathExists=@@TRIGGER_ROOT@@/inbox/.deploy-done
Unit=@@FINALIZER_SERVICE@@

[Install]
WantedBy=multi-user.target
