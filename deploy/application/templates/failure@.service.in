# deploy/application/templates/failure@.service.in

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

[Unit]
Description=Record failure of @@APPLICATION_TAG@@ deployment unit %i

[Service]
Type=oneshot
ExecStart=/usr/bin/logger -p daemon.crit -t @@APPLICATION_TAG@@-deploy Deployment finalizer failed: %i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
