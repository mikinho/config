[Unit]
Description=Recover interrupted @@APPLICATION_TAG@@ deployment state
After=local-fs.target
Before=@@LIVE_SERVICE@@ @@FINALIZER_PATH@@

[Service]
Type=oneshot
User=root
ExecStart=@@SECURE_ROOT@@/scripts/post-deploy --recover-pointer
RemainAfterExit=yes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=@@APPLICATION_ROOT@@ @@SECURE_ROOT@@ @@TRIGGER_ROOT@@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target
