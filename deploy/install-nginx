#!/bin/sh

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
NGINX_SOURCE=$REPOSITORY_ROOT/nginx
PROFILE_DIRECTORY=$SCRIPT_DIRECTORY/profiles
NGINX_BINARY=/usr/sbin/nginx
SCRATCH_DIRECTORY=
STAGING_DIRECTORY=

# add_header_inherit, used by includes/security-headers.conf, first shipped in
# nginx 1.29.3. Keep in step with the compatibility table in the root README.
NGINX_VERSION_FLOOR=1.29.3

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME --check
  $PROGRAM_NAME --list-profiles
  $PROGRAM_NAME --verify-host
  $PROGRAM_NAME --output DIRECTORY [--profile NAME ...]

The baseline profile is always selected. The output must not already exist.
Run --verify-host on the target before installing a rendered tree. It checks
the fixed /usr/sbin/nginx service binary's version and required build options;
it does not parse a rendered or live configuration, so nginx -t is still
required after assembling the exact target tree.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

cleanup() {
    if [ -n "$STAGING_DIRECTORY" ] && [ -d "$STAGING_DIRECTORY" ]; then
        rm -rf -- "$STAGING_DIRECTORY"
    fi

    if [ -n "$SCRATCH_DIRECTORY" ] && [ -d "$SCRATCH_DIRECTORY" ]; then
        rm -rf -- "$SCRATCH_DIRECTORY"
    fi
}

trap cleanup EXIT HUP INT TERM

# POSIX sh has no local variables, so every helper uses names unique to
# itself; a helper reusing its caller's loop variable would silently corrupt
# the caller's state.
version_at_least() {
    version_candidate=$1
    version_floor=$2

    version_index=1
    while [ "$version_index" -le 3 ]; do
        candidate_part=$(printf '%s' "$version_candidate" | cut -d. -f"$version_index")
        floor_part=$(printf '%s' "$version_floor" | cut -d. -f"$version_index")
        candidate_part=${candidate_part:-0}
        floor_part=${floor_part:-0}

        if [ "$candidate_part" -gt "$floor_part" ]; then
            return 0
        fi
        if [ "$candidate_part" -lt "$floor_part" ]; then
            return 1
        fi

        version_index=$((version_index + 1))
    done

    return 0
}

parse_nginx_version() {
    parse_version_raw=$1
    parse_version_candidate=

    case "$parse_version_raw" in
        'nginx version: '*/*)
            parse_version_candidate=$(printf '%s\n' "$parse_version_raw" \
                | sed 's|^.*/||; s|[^0-9.].*$||')
            ;;
    esac

    if printf '%s\n' "$parse_version_candidate" \
        | grep -Eq '^[0-9]+([.][0-9]+){0,2}$'; then
        printf '%s\n' "$parse_version_candidate"
    fi
}

# Rendering can happen on a build machine, so the floor is enforced against
# the host that will actually load the tree, not at render time.
verify_host_nginx() {
    [ -x "$NGINX_BINARY" ] \
        || fail "required nginx service binary is not executable: $NGINX_BINARY"

    host_version_raw=$("$NGINX_BINARY" -v 2>&1) \
        || fail "unable to read the nginx version from $NGINX_BINARY"
    host_version=$(parse_nginx_version "$host_version_raw")
    [ -n "$host_version" ] || fail "unable to parse an nginx version from: $host_version_raw"

    version_at_least "$host_version" "$NGINX_VERSION_FLOOR" \
        || fail "nginx $host_version is older than the $NGINX_VERSION_FLOOR floor required by add_header_inherit"

    host_build_raw=$("$NGINX_BINARY" -V 2>&1) \
        || fail "unable to read nginx build options from $NGINX_BINARY"

    for required_option in \
        --with-threads \
        --with-http_ssl_module \
        --with-http_v2_module \
        --with-http_v3_module \
        --with-http_gzip_static_module \
        --with-http_stub_status_module
    do
        printf '%s\n' "$host_build_raw" | grep -F -- "$required_option" >/dev/null \
            || fail "$NGINX_BINARY is missing required build option: $required_option"
    done

    printf '%s %s meets the version and required-build baseline.\n' \
        "$NGINX_BINARY" "$host_version"
}

validate_profile_name() {
    candidate_name=$1

    case "$candidate_name" in
        '' | -* | *- | *[!a-z0-9-]*)
            fail "invalid profile name: $candidate_name"
            ;;
    esac
}

validate_stub_entry() {
    entry=$1
    origin_file=$2

    case "$entry" in
        /* | *..* | *[!a-z0-9./-]*)
            fail "invalid stub path in $origin_file: $entry"
            ;;
        stubs/http/*.conf)
            entry_name=${entry#stubs/http/}
            case "$entry_name" in
                '' | */*) fail "invalid HTTP stub path in $origin_file: $entry" ;;
            esac
            ;;
        stubs/*.conf)
            entry_name=${entry#stubs/}
            case "$entry_name" in
                '' | */*) fail "invalid main stub path in $origin_file: $entry" ;;
            esac
            ;;
        *)
            fail "profile entry is not a stub in $origin_file: $entry"
            ;;
    esac

    entry_source=$NGINX_SOURCE/$entry
    [ -f "$entry_source" ] || fail "missing stub referenced by $origin_file: $entry"
    [ ! -L "$entry_source" ] || fail "profile stubs must not be symbolic links: $entry"
}

collect_profile() {
    manifest_name=$1
    output_file=$2
    validate_profile_name "$manifest_name"

    manifest_file=$PROFILE_DIRECTORY/$manifest_name.profile
    [ -f "$manifest_file" ] || fail "unknown profile: $manifest_name"
    [ ! -L "$manifest_file" ] || fail "profile manifests must not be symbolic links: $manifest_name"

    # The manifest is repository-owned input and output_file is always a
    # scratch-file path supplied by this script, so they cannot be the same.
    # shellcheck disable=SC2094
    while IFS= read -r manifest_entry || [ -n "$manifest_entry" ]; do
        case "$manifest_entry" in
            '' | \#*) continue ;;
        esac

        validate_stub_entry "$manifest_entry" "$manifest_file"
        printf '%s\n' "$manifest_entry" >> "$output_file"
    done < "$manifest_file"
}

validate_all_profiles() {
    all_profile_stubs=$SCRATCH_DIRECTORY/all-profile-stubs
    all_source_stubs=$SCRATCH_DIRECTORY/all-source-stubs
    : > "$all_profile_stubs"

    profile_count=0
    for profile_file in "$PROFILE_DIRECTORY"/*.profile; do
        [ -f "$profile_file" ] || fail "no deployment profiles found"
        profile_name=${profile_file##*/}
        profile_name=${profile_name%.profile}
        collect_profile "$profile_name" "$all_profile_stubs"
        profile_count=$((profile_count + 1))
    done

    LC_ALL=C sort -u "$all_profile_stubs" -o "$all_profile_stubs"
    find "$NGINX_SOURCE/stubs" -type f -name '*.conf' -print \
        | sed "s|$NGINX_SOURCE/||" \
        | LC_ALL=C sort > "$all_source_stubs"

    if ! diff -u "$all_source_stubs" "$all_profile_stubs"; then
        fail "every stub must be assigned to at least one deployment profile"
    fi

    printf 'Validated %s profiles and all stub assignments.\n' "$profile_count"
}

list_profiles() {
    for profile_file in "$PROFILE_DIRECTORY"/*.profile; do
        [ -f "$profile_file" ] || fail "no deployment profiles found"
        profile_name=${profile_file##*/}
        printf '%s\n' "${profile_name%.profile}"
    done
}

copy_configuration() {
    selected_stubs=$1

    if [ ! -d "$NGINX_SOURCE/includes" ] || [ -L "$NGINX_SOURCE/includes" ]; then
        fail "nginx includes source must be a real directory"
    fi
    if [ ! -d "$NGINX_SOURCE/sites" ] || [ -L "$NGINX_SOURCE/sites" ]; then
        fail "nginx sites source must be a real directory"
    fi
    if [ ! -f "$NGINX_SOURCE/nginx.conf" ] || [ -L "$NGINX_SOURCE/nginx.conf" ]; then
        fail "nginx.conf source must be a regular file, not a symbolic link"
    fi

    mkdir -p \
        "$STAGING_DIRECTORY/includes" \
        "$STAGING_DIRECTORY/sites" \
        "$STAGING_DIRECTORY/stubs/http" \
        "$STAGING_DIRECTORY/upstreams" \
        "$STAGING_DIRECTORY/trusted-proxies"

    cp "$NGINX_SOURCE/nginx.conf" "$STAGING_DIRECTORY/nginx.conf"

    for source_file in "$NGINX_SOURCE"/includes/*.conf; do
        if [ ! -f "$source_file" ] || [ -L "$source_file" ]; then
            fail "nginx include source must be a regular file, not a symbolic link: $source_file"
        fi
        cp "$source_file" "$STAGING_DIRECTORY/includes/"
    done

    for source_file in "$NGINX_SOURCE"/sites/*.conf; do
        if [ ! -f "$source_file" ] || [ -L "$source_file" ]; then
            fail "nginx site source must be a regular file, not a symbolic link: $source_file"
        fi
        cp "$source_file" "$STAGING_DIRECTORY/sites/"
    done

    while IFS= read -r stub_entry || [ -n "$stub_entry" ]; do
        destination_file=$STAGING_DIRECTORY/$stub_entry
        destination_directory=${destination_file%/*}
        mkdir -p "$destination_directory"
        cp "$NGINX_SOURCE/$stub_entry" "$destination_file"
    done < "$selected_stubs"
}

generate_quic_host_key() {
    selected_stubs=$1

    if grep -qx 'stubs/http/quic.conf' "$selected_stubs"; then
        (
            umask 077
            dd if=/dev/urandom of="$STAGING_DIRECTORY/quic_host.key" bs=80 count=1 2>/dev/null
        )

        key_size=$(wc -c < "$STAGING_DIRECTORY/quic_host.key" | tr -d ' ')
        [ "$key_size" = 80 ] || fail "failed to generate the QUIC host key"
    fi
}

write_install_manifest() {
    selected_profiles=$1
    selected_stubs=$2
    manifest=$STAGING_DIRECTORY/INSTALL-PROFILE

    {
        printf '%s\n' '# Minimum nginx version able to parse this tree'
        printf 'nginx-version-floor %s\n' "$NGINX_VERSION_FLOOR"
        printf '%s\n' '# Selected profiles'
        sed 's/^/profile /' "$selected_profiles"
        printf '%s\n' '# Selected stubs'
        sed 's/^/stub /' "$selected_stubs"
    } > "$manifest"
}

render_configuration() {
    output_directory=$1
    requested_profiles=$2

    case "$output_directory" in
        '' | / | . | ..) fail "refusing unsafe output directory: $output_directory" ;;
    esac

    [ ! -e "$output_directory" ] || fail "output already exists: $output_directory"

    output_parent=${output_directory%/*}
    if [ "$output_parent" = "$output_directory" ]; then
        output_parent=.
    fi
    output_name=${output_directory##*/}
    case "$output_name" in
        '' | . | ..) fail "invalid output directory: $output_directory" ;;
    esac

    mkdir -p "$output_parent"
    if [ -e "$output_directory" ] || [ -L "$output_directory" ]; then
        fail "output appeared while preparing render: $output_directory"
    fi
    STAGING_DIRECTORY=$(mktemp -d "$output_parent/.$output_name.XXXXXX")

    selected_profiles=$SCRATCH_DIRECTORY/selected-profiles
    selected_stubs=$SCRATCH_DIRECTORY/selected-stubs
    {
        printf '%s\n' baseline
        printf '%s\n' "$requested_profiles"
    } | sed '/^$/d' | LC_ALL=C sort -u > "$selected_profiles"
    : > "$selected_stubs"

    while IFS= read -r profile_name || [ -n "$profile_name" ]; do
        collect_profile "$profile_name" "$selected_stubs"
    done < "$selected_profiles"
    LC_ALL=C sort -u "$selected_stubs" -o "$selected_stubs"

    copy_configuration "$selected_stubs"
    generate_quic_host_key "$selected_stubs"
    write_install_manifest "$selected_profiles" "$selected_stubs"

    if [ -e "$output_directory" ] || [ -L "$output_directory" ]; then
        fail "output appeared while rendering: $output_directory"
    fi
    staging_name=${STAGING_DIRECTORY##*/}
    publish_marker=.config-render-$staging_name
    : > "$STAGING_DIRECTORY/$publish_marker"
    mv "$STAGING_DIRECTORY" "$output_directory"
    if [ ! -f "$output_directory/$publish_marker" ]; then
        nested_staging=$output_directory/$staging_name
        if [ -d "$nested_staging" ]; then
            STAGING_DIRECTORY=$nested_staging
        fi
        fail "render was not published at the requested output: $output_directory"
    fi
    rm "$output_directory/$publish_marker"
    STAGING_DIRECTORY=
    printf 'Rendered nginx install tree: %s\n' "$output_directory"
}

mode=
output_directory=
requested_profiles=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ -z "$mode" ] || fail "select exactly one operating mode"
            mode=check
            shift
            ;;
        --list-profiles)
            [ -z "$mode" ] || fail "select exactly one operating mode"
            mode=list
            shift
            ;;
        --verify-host)
            [ -z "$mode" ] || fail "select exactly one operating mode"
            mode=verify
            shift
            ;;
        --output)
            [ -z "$mode" ] || [ "$mode" = render ] || fail "select exactly one operating mode"
            [ "$#" -ge 2 ] || fail "--output requires a directory"
            mode=render
            output_directory=$2
            shift 2
            ;;
        --profile)
            [ "$#" -ge 2 ] || fail "--profile requires a name"
            validate_profile_name "$2"
            requested_profiles=$requested_profiles${requested_profiles:+"
"}$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            fail "unknown argument: $1"
            ;;
    esac
done

[ -n "$mode" ] || {
    usage >&2
    exit 1
}

SCRATCH_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/config-nginx.XXXXXX")

case "$mode" in
    check)
        [ -z "$requested_profiles" ] || fail "--profile is valid only with --output"
        validate_all_profiles
        ;;
    list)
        [ -z "$requested_profiles" ] || fail "--profile is valid only with --output"
        list_profiles
        ;;
    verify)
        [ -z "$requested_profiles" ] || fail "--profile is valid only with --output"
        verify_host_nginx
        ;;
    render)
        [ -n "$output_directory" ] || fail "--output requires a directory"
        render_configuration "$output_directory" "$requested_profiles"
        ;;
esac
