#!/bin/sh

PROGRAM_NAME=${0##*/}
set -eu
set -f

NGINX_BINARY=/usr/sbin/nginx
NGINX_CONFIG=/etc/nginx/nginx.conf
NGINX_VERSION_FLOOR=1.29.3

BACKEND=auto
ZONE=public
TOPOLOGY=direct
SSH_PHASE=final
EXPECTED_IGNORE_IPS=
SITE_TAG=
VERBOSE=0
FAILED_CHECKS=0

CERTBOT_TIMER_UNIT=certbot.timer
CERTBOT_HEALTHCHECK=/usr/local/bin/certbot-healthcheck
CERTBOT_HEALTHCHECK_TIMER=certbot-healthcheck.timer
CERTBOT_SNAP_RUNNER_DROPIN=/etc/systemd/system/certbot.timer.d/10-snap-runner.conf
CERTBOT_SNAP_NGINX_DROPIN=/etc/systemd/system/snap.certbot.renew.service.d/10-nginx.conf
FAIL2BAN_POLICY=/etc/fail2ban/jail.d/90-baseline.local
SELINUX_CONFIG=/etc/selinux/config
SHELL_ENVIRONMENT=/etc/managed-environment
SHELL_PROMPT_POLICY=/etc/profile.d/70-managed-environment-prompt.sh
SHELL_UMASK_POLICY=/etc/profile.d/80-admin-umask.sh
SHELL_HISTORY_POLICY=/etc/profile.d/90-no-persistent-history.sh

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME [OPTIONS]

Non-destructive host post-deployment verification. Validates installed Nginx,
managed certificates, systemd units, trusted shell classification and policies,
OpenSSH, Fail2ban, firewalld, synchronized time, SELinux policy, QUIC kernel
buffers, and runtime socket permissions.

Options:
  --backend BACKEND   Certbot renewal backend: 'auto' (default), 'native', or 'snap'
  --zone ZONE         Existing firewalld zone selected during setup (default: public)
  --topology TYPE     Client topology: 'direct' (default) or 'proxied'
  --ssh-phase PHASE   Expected SSH state: 'prepare' or 'final' (default: final)
  --ignore-ip CIDR    Expected Fail2ban administrative CIDR; repeat as needed
  --site SITE_TAG     Validate per-site PHP-FPM socket and systemd instance
  --verbose, -v       Show detailed diagnostic outputs for each check
  --help, -h          Show this help message

Exit Status:
  0 if all verified checks pass, 1 if any check fails or prerequisites are missing.
EOF
}

fail_msg() {
    printf '[FAIL] %s\n' "$*" >&2
    FAILED_CHECKS=$((FAILED_CHECKS + 1))
}

pass_msg() {
    printf '[PASS] %s\n' "$*"
}

info_msg() {
    if [ "$VERBOSE" -eq 1 ]; then
        printf '       %s\n' "$*"
    fi
}

append_expected_ignore_ip() {
    expected_ignore_ip=$1
    case "$expected_ignore_ip" in
        '' | -* | *[!0-9A-Fa-f:./]* | */*/*)
            printf '%s: invalid expected administrative CIDR: %s\n' \
                "$PROGRAM_NAME" "$expected_ignore_ip" >&2
            exit 1
            ;;
    esac
    case "$expected_ignore_ip" in
        */*) ;;
        *)
            printf '%s: expected administrative address must use CIDR notation: %s\n' \
                "$PROGRAM_NAME" "$expected_ignore_ip" >&2
            exit 1
            ;;
    esac
    command -v python3 >/dev/null 2>&1 || {
        printf '%s: python3 is required for exact CIDR validation\n' \
            "$PROGRAM_NAME" >&2
        exit 1
    }
    python3 -c \
        'import ipaddress, sys; ipaddress.ip_interface(sys.argv[1])' \
        "$expected_ignore_ip" >/dev/null 2>&1 || {
        printf '%s: invalid expected administrative CIDR: %s\n' \
            "$PROGRAM_NAME" "$expected_ignore_ip" >&2
        exit 1
    }
    EXPECTED_IGNORE_IPS=$EXPECTED_IGNORE_IPS${EXPECTED_IGNORE_IPS:+"
"}$expected_ignore_ip
}

validate_options() {
    case "$BACKEND" in
        auto | native | snap) ;;
        *) printf '%s: unknown backend: %s\n' "$PROGRAM_NAME" "$BACKEND" >&2; exit 1 ;;
    esac
    case "$ZONE" in
        '' | -* | *[!A-Za-z0-9_-]*)
            printf '%s: invalid firewalld zone: %s\n' "$PROGRAM_NAME" "$ZONE" >&2
            exit 1
            ;;
    esac
    case "$TOPOLOGY" in
        direct | proxied) ;;
        *) printf '%s: unknown topology: %s\n' "$PROGRAM_NAME" "$TOPOLOGY" >&2; exit 1 ;;
    esac
    case "$SSH_PHASE" in
        prepare | final) ;;
        *) printf '%s: unknown SSH phase: %s\n' "$PROGRAM_NAME" "$SSH_PHASE" >&2; exit 1 ;;
    esac
    case "$SITE_TAG" in
        '') ;;
        [a-z]*[!a-z0-9_]* | [!a-z]*)
            printf '%s: invalid PHP-FPM site tag: %s\n' \
                "$PROGRAM_NAME" "$SITE_TAG" >&2
            exit 1
            ;;
    esac
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        fail_msg "run as root so every host baseline check can inspect live state"
        return 1
    fi
}

version_at_least() {
    version_candidate=$1
    version_floor=$2

    version_index=1
    while [ "$version_index" -le 3 ]; do
        candidate_part=$(printf '%s' "$version_candidate" | cut -d. -f"$version_index")
        floor_part=$(printf '%s' "$version_floor" | cut -d. -f"$version_index")
        candidate_part=${candidate_part:-0}
        floor_part=${floor_part:-0}

        if [ "$candidate_part" -gt "$floor_part" ]; then
            return 0
        fi
        if [ "$candidate_part" -lt "$floor_part" ]; then
            return 1
        fi

        version_index=$((version_index + 1))
    done

    return 0
}

parse_nginx_version() {
    parse_version_raw=$1
    parse_version_candidate=

    case "$parse_version_raw" in
        'nginx version: '*/*)
            parse_version_candidate=$(printf '%s\n' "$parse_version_raw" \
                | sed 's|^.*/||; s|[^0-9.].*$||')
            ;;
    esac

    if printf '%s\n' "$parse_version_candidate" \
        | grep -Eq '^[0-9]+([.][0-9]+){0,2}$'; then
        printf '%s\n' "$parse_version_candidate"
    fi
}

check_nginx() {
    printf 'Checking nginx binary and configuration...\n'
    if [ ! -x "$NGINX_BINARY" ]; then
        fail_msg "nginx binary not executable: $NGINX_BINARY"
        return
    fi

    host_version_raw=$("$NGINX_BINARY" -v 2>&1) || {
        fail_msg "unable to read nginx version from $NGINX_BINARY"
        return
    }
    host_version=$(parse_nginx_version "$host_version_raw")
    if [ -z "$host_version" ]; then
        fail_msg "unable to parse nginx version: $host_version_raw"
    elif printf '%s\n' "$host_version" | grep -Eq '^[0-9]+([.][0-9]+){0,2}$'; then
        if ! version_at_least "$host_version" "$NGINX_VERSION_FLOOR"; then
            fail_msg "nginx $host_version is below syntax floor $NGINX_VERSION_FLOOR"
        else
            pass_msg "nginx binary version is $host_version (>= $NGINX_VERSION_FLOOR)"
        fi
    else
        fail_msg "nginx reported an invalid numeric version: $host_version"
    fi

    host_build_raw=$("$NGINX_BINARY" -V 2>&1) || {
        fail_msg "unable to read nginx build options"
        return
    }
    for required_option in \
        --with-threads \
        --with-http_ssl_module \
        --with-http_v2_module \
        --with-http_v3_module \
        --with-http_gzip_static_module \
        --with-http_stub_status_module
    do
        if printf '%s\n' "$host_build_raw" | grep -F -- "$required_option" >/dev/null; then
            info_msg "nginx build contains $required_option"
        else
            fail_msg "nginx build missing required option: $required_option"
        fi
    done

    if [ ! -f "$NGINX_CONFIG" ]; then
        fail_msg "live nginx config is missing: $NGINX_CONFIG"
    elif "$NGINX_BINARY" -t -q -c "$NGINX_CONFIG" 2>/dev/null; then
        pass_msg "nginx configuration test passed: $NGINX_CONFIG"
    else
        fail_msg "nginx configuration test failed: $NGINX_CONFIG"
    fi
}

check_quic_state() {
    printf 'Checking QUIC host key and socket buffer limits...\n'
    if [ -f /etc/nginx/quic_host.key ]; then
        key_mode=$(stat -c '%a' /etc/nginx/quic_host.key 2>/dev/null || stat -f '%Lp' /etc/nginx/quic_host.key 2>/dev/null || echo '')
        key_bytes=$(wc -c < /etc/nginx/quic_host.key | tr -d ' ')
        key_owner=$(stat -c '%U:%G' /etc/nginx/quic_host.key 2>/dev/null || stat -f '%Su:%Sg' /etc/nginx/quic_host.key 2>/dev/null || echo '')
        if [ "$key_mode" = "600" ] && [ "$key_bytes" = "80" ] && [ "$key_owner" = "root:root" ]; then
            pass_msg "quic_host.key present with root:root mode 0600 and 80 bytes"
        else
            fail_msg "quic_host.key has unexpected ownership ($key_owner), permissions ($key_mode) or size ($key_bytes bytes)"
        fi
    else
        fail_msg "quic_host.key is missing: /etc/nginx/quic_host.key"
    fi

    if ! command -v sysctl >/dev/null 2>&1; then
        fail_msg "sysctl tooling is unavailable"
        return
    fi

    rmem=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
    wmem=$(sysctl -n net.core.wmem_max 2>/dev/null || echo 0)
    if [ "$rmem" -ge 2097152 ] && [ "$wmem" -ge 2097152 ]; then
        pass_msg "kernel socket buffers net.core.rmem_max ($rmem) and wmem_max ($wmem) meet 2 MiB floor"
    else
        fail_msg "kernel socket buffers below 2 MiB (rmem_max: $rmem, wmem_max: $wmem); install sysctl/99-nginx-quic.conf"
    fi
}

check_clock_synchronization() {
    printf 'Checking system clock synchronization...\n'
    synchronized=no
    if command -v timedatectl >/dev/null 2>&1; then
        ntp_state=$(timedatectl show --property=NTPSynchronized --value 2>/dev/null || true)
        [ "$ntp_state" = yes ] && synchronized=yes
    fi
    if [ "$synchronized" = no ] && command -v chronyc >/dev/null 2>&1; then
        if chronyc tracking 2>/dev/null \
            | grep -Eq '^Leap status[[:space:]]*:[[:space:]]*Normal$'; then
            synchronized=yes
        fi
    fi
    if [ "$synchronized" = yes ]; then
        pass_msg "system clock reports synchronized time"
    else
        fail_msg "system clock is not synchronized; ACME and TLS validation require reliable time"
    fi
}

check_certificate_health() {
    printf 'Checking managed certificate validity and expiration...\n'
    if [ ! -x "$CERTBOT_HEALTHCHECK" ]; then
        fail_msg "certificate healthcheck is missing: $CERTBOT_HEALTHCHECK"
        return
    fi
    if certificate_report=$("$CERTBOT_HEALTHCHECK" 2>&1); then
        pass_msg "all managed certificates are valid beyond the warning threshold"
        if [ -n "$certificate_report" ]; then
            while IFS= read -r certificate_line; do
                info_msg "$certificate_line"
            done <<EOF
$certificate_report
EOF
        fi
    else
        fail_msg "managed certificate healthcheck failed"
        if [ -n "$certificate_report" ]; then
            while IFS= read -r certificate_line; do
                info_msg "$certificate_line"
            done <<EOF
$certificate_report
EOF
        fi
    fi
}

resolve_certbot_backend() {
    case "$BACKEND" in
        auto)
            if [ -f "$CERTBOT_SNAP_RUNNER_DROPIN" ]; then
                RESOLVED_BACKEND=snap
            else
                RESOLVED_BACKEND=native
            fi
            pass_msg "detected $RESOLVED_BACKEND Certbot renewal backend"
            ;;
        native | snap)
            RESOLVED_BACKEND=$BACKEND
            ;;
        *)
            fail_msg "unknown backend: $BACKEND"
            return 1
            ;;
    esac
}

check_systemd_services() {
    printf 'Checking systemd services and timers...\n'
    if ! command -v systemctl >/dev/null 2>&1; then
        fail_msg "systemctl is unavailable"
        return
    fi

    if systemctl is-active --quiet nginx.service 2>/dev/null; then
        pass_msg "nginx.service is active"
    else
        fail_msg "nginx.service is not active"
    fi

    if systemctl is-active --quiet "$CERTBOT_TIMER_UNIT" 2>/dev/null; then
        pass_msg "$CERTBOT_TIMER_UNIT is active"
    else
        fail_msg "$CERTBOT_TIMER_UNIT is not active"
    fi
    if systemctl is-enabled --quiet "$CERTBOT_TIMER_UNIT" 2>/dev/null; then
        pass_msg "$CERTBOT_TIMER_UNIT is enabled"
    else
        fail_msg "$CERTBOT_TIMER_UNIT is not enabled"
    fi

    if systemctl is-active --quiet "$CERTBOT_HEALTHCHECK_TIMER" 2>/dev/null; then
        pass_msg "$CERTBOT_HEALTHCHECK_TIMER is active"
    else
        fail_msg "$CERTBOT_HEALTHCHECK_TIMER is not active"
    fi
    if systemctl is-enabled --quiet "$CERTBOT_HEALTHCHECK_TIMER" 2>/dev/null; then
        pass_msg "$CERTBOT_HEALTHCHECK_TIMER is enabled"
    else
        fail_msg "$CERTBOT_HEALTHCHECK_TIMER is not enabled"
    fi

    if systemctl is-active --quiet certbot-renew.timer 2>/dev/null; then
        fail_msg "certbot-renew.timer is active; repository timer must be the sole scheduler"
    else
        pass_msg "distribution certbot-renew.timer is inactive"
    fi

    resolve_certbot_backend || return
    case "$RESOLVED_BACKEND" in
        native)
            if [ -f "$CERTBOT_SNAP_RUNNER_DROPIN" ]; then
                fail_msg "snap runner drop-in present while native backend selected"
            else
                pass_msg "native certbot backend configuration verified"
            fi
            ;;
        snap)
            if [ -f "$CERTBOT_SNAP_RUNNER_DROPIN" ] && \
               [ -f "$CERTBOT_SNAP_NGINX_DROPIN" ]; then
                pass_msg "snap certbot drop-ins present"
            else
                fail_msg "snap certbot backend selected but drop-ins missing under /etc/systemd/system/"
            fi
            if systemctl is-active --quiet snap.certbot.renew.timer 2>/dev/null; then
                fail_msg "snap.certbot.renew.timer is active; must be disabled so repository timer is sole scheduler"
            fi
            ;;
    esac

    if [ -n "$SITE_TAG" ]; then
        site_service="php-fpm@$SITE_TAG.service"
        if systemctl is-active --quiet "$site_service" 2>/dev/null; then
            pass_msg "$site_service is active"
        else
            fail_msg "$site_service is not active"
        fi
    fi
}

check_shell_history() {
    printf 'Checking interactive shell policies...\n'
    if ! command -v stat >/dev/null 2>&1; then
        fail_msg "stat is unavailable for shell policy verification"
        return
    fi
    for shell_policy in \
        "$SHELL_ENVIRONMENT" \
        "$SHELL_PROMPT_POLICY" \
        "$SHELL_UMASK_POLICY" \
        "$SHELL_HISTORY_POLICY"
    do
        if [ ! -f "$shell_policy" ] || [ -L "$shell_policy" ]; then
            fail_msg "managed shell policy is missing or unsafe: $shell_policy"
            return
        fi
        policy_identity=$(stat -Lc '%U:%G:%a' "$shell_policy" 2>/dev/null || true)
        if [ "$policy_identity" = root:root:644 ]; then
            pass_msg "shell policy is root-owned and mode 0644: $shell_policy"
        else
            fail_msg "shell policy has unsafe ownership or mode: $shell_policy (${policy_identity:-unknown})"
        fi
    done
    if ! command -v awk >/dev/null 2>&1; then
        fail_msg "awk is unavailable for managed environment verification"
        return
    fi
    if managed_environment=$(awk '
        NR == 1 && /^(PROD|TEST|DEV)$/ { value = $0 }
        END { if (NR == 1 && value != "") print value; else exit 1 }
    ' "$SHELL_ENVIRONMENT" 2>/dev/null); then
        pass_msg "managed environment is $managed_environment"
    else
        fail_msg "managed environment must contain exactly PROD, TEST, or DEV"
        return
    fi
    if ! command -v bash >/dev/null 2>&1; then
        fail_msg "bash is unavailable for shell policy verification"
        return
    fi
    if ! command -v env >/dev/null 2>&1; then
        fail_msg "env is unavailable for clean shell policy verification"
        return
    fi
    # Expand history variables inside the clean child shells, not this verifier.
    # shellcheck disable=SC2016
    if env -u HISTFILE -u HISTSIZE -u HISTFILESIZE \
        "EXPECTED_MANAGED_ENVIRONMENT=$managed_environment" bash -lic '
        [ "${HISTFILE:-}" = /dev/null ] || exit 1
        [ "${HISTSIZE:-0}" -gt 0 ] 2>/dev/null || exit 1
        readonly -p HISTFILE >/dev/null 2>&1 || exit 1
        managed_verify_umask=$(umask)
        managed_verify_umask=${managed_verify_umask#0}
        [ "$((8#$managed_verify_umask & 8#027))" -eq "$((8#027))" ] || exit 1
        managed_expected_prompt_path="\\u@\\h:\\w"
        case "$PS1" in
            *"[$EXPECTED_MANAGED_ENVIRONMENT"*"$managed_expected_prompt_path"*) ;;
            *) exit 1 ;;
        esac
        if [ "$EXPECTED_MANAGED_ENVIRONMENT" = PROD ]; then
            case "$PS1" in *'[PROD ROOT]'*) ;; *) exit 1 ;; esac
        fi
        bash -ic "
            [ \"\${HISTFILE:-}\" = /dev/null ] || exit 1
            [ \"\${HISTSIZE:-0}\" -gt 0 ] 2>/dev/null || exit 1
            managed_verify_child_umask=\$(umask)
            managed_verify_child_umask=\${managed_verify_child_umask#0}
            [ \"\$((8#\$managed_verify_child_umask & 8#027))\" -eq \"\$((8#027))\" ]
        " >/dev/null 2>&1
    ' >/dev/null 2>&1; then
        pass_msg "Bash logins show the managed environment and enforce shell policies"
    else
        fail_msg "Bash login umask or history policy is not effective in interactive shells"
    fi
}

check_ssh_hardening() {
    printf 'Checking OpenSSH configuration...\n'
    if ! command -v sshd >/dev/null 2>&1; then
        fail_msg "sshd is unavailable"
        return
    fi

    if ! sshd -t 2>/dev/null; then
        fail_msg "sshd configuration test failed (sshd -t)"
        return
    fi

    effective_config=$(sshd -T 2>/dev/null || true)
    if [ -z "$effective_config" ]; then
        fail_msg "unable to read effective sshd configuration via sshd -T"
        return
    fi

    port_count=$(printf '%s\n' "$effective_config" | grep -c '^port ' || true)
    case "$SSH_PHASE" in
        prepare)
            if [ "$port_count" -eq 2 ] \
                && printf '%s\n' "$effective_config" | grep -qx 'port 22' \
                && printf '%s\n' "$effective_config" | grep -qx 'port 2356'; then
                pass_msg "sshd transition listens on exactly ports 22 and 2356"
            else
                fail_msg "sshd prepare state must expose exactly ports 22 and 2356 (found $port_count port entries)"
            fi
            ;;
        final)
            if [ "$port_count" -eq 1 ] \
                && printf '%s\n' "$effective_config" | grep -qx 'port 2356'; then
                pass_msg "sshd listens exclusively on hardened port 2356"
            else
                fail_msg "sshd final state must expose port 2356 alone (found $port_count port entries)"
            fi
            ;;
    esac

    if printf '%s\n' "$effective_config" | grep -qx 'permitrootlogin no' && \
       printf '%s\n' "$effective_config" | grep -qx 'passwordauthentication no' && \
       printf '%s\n' "$effective_config" | grep -qx 'kbdinteractiveauthentication no'; then
        pass_msg "sshd key-only authentication verified (root, password, and kbd-interactive disabled)"
    else
        fail_msg "sshd authentication baseline not fully enforced"
    fi
}

check_firewalld() {
    printf 'Checking firewalld configuration...\n'
    cmd=
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        cmd="firewall-cmd"
    elif command -v firewall-offline-cmd >/dev/null 2>&1; then
        cmd="firewall-offline-cmd"
    fi

    if [ -z "$cmd" ]; then
        fail_msg "firewalld is inactive and offline tooling is unavailable"
        return
    fi

    if ! "$cmd" --get-zones 2>/dev/null | tr ' ' '\n' | grep -qx "$ZONE"; then
        fail_msg "selected firewalld zone does not exist: $ZONE"
        return
    fi
    zone_services=$("$cmd" --zone="$ZONE" --list-services 2>/dev/null || true)

    if "$cmd" --info-service=nginx >/dev/null 2>&1; then
        pass_msg "firewalld service 'nginx' (TCP 80/443, UDP 443) is defined"
        if printf '%s\n' "$zone_services" | tr ' ' '\n' | grep -qxF nginx; then
            pass_msg "firewalld service 'nginx' is active in zone $ZONE"
        else
            fail_msg "firewalld service 'nginx' is defined but not active in zone $ZONE"
        fi
    else
        fail_msg "firewalld service 'nginx' is missing; install firewalld/services/nginx.xml"
    fi

    if "$cmd" --info-service=ssh-hardened >/dev/null 2>&1; then
        pass_msg "firewalld service 'ssh-hardened' (TCP 2356) is defined"
        if printf '%s\n' "$zone_services" | tr ' ' '\n' | grep -qxF ssh-hardened; then
            pass_msg "firewalld service 'ssh-hardened' is active in zone $ZONE"
        else
            fail_msg "firewalld service 'ssh-hardened' is defined but not active in zone $ZONE"
        fi
    else
        fail_msg "firewalld service 'ssh-hardened' is missing; install firewalld/services/ssh-hardened.xml"
    fi

    case "$SSH_PHASE" in
        prepare)
            if printf '%s\n' "$zone_services" | tr ' ' '\n' | grep -qxF ssh; then
                pass_msg "stock SSH service remains active in zone $ZONE during transition"
            else
                fail_msg "stock SSH service is missing from zone $ZONE during prepare phase"
            fi
            ;;
        final)
            if printf '%s\n' "$zone_services" | tr ' ' '\n' | grep -qxF ssh; then
                fail_msg "stock SSH service remains active in zone $ZONE after finalization"
            else
                pass_msg "stock SSH service is absent from zone $ZONE after finalization"
            fi
            ;;
    esac
}

fail2ban_jail_active() {
    checked_jail=$1
    fail2ban-client status "$checked_jail" >/dev/null 2>&1
}

check_fail2ban() {
    printf 'Checking Fail2ban runtime and topology policy...\n'
    if ! command -v fail2ban-client >/dev/null 2>&1; then
        fail_msg "fail2ban-client is unavailable"
        return
    fi
    if ! command -v systemctl >/dev/null 2>&1; then
        fail_msg "systemctl is unavailable for Fail2ban verification"
        return
    fi

    fail2ban_active=yes
    if systemctl is-enabled --quiet fail2ban.service 2>/dev/null; then
        pass_msg "fail2ban.service is enabled"
    else
        fail_msg "fail2ban.service is not enabled"
    fi
    if systemctl is-active --quiet fail2ban.service 2>/dev/null; then
        pass_msg "fail2ban.service is active"
    else
        fail_msg "fail2ban.service is not active"
        fail2ban_active=no
    fi
    if fail2ban-client -t >/dev/null 2>&1; then
        pass_msg "Fail2ban merged configuration test passed"
    else
        fail_msg "Fail2ban merged configuration test failed"
    fi

    if [ ! -f "$FAIL2BAN_POLICY" ] || [ -L "$FAIL2BAN_POLICY" ]; then
        fail_msg "generated Fail2ban policy is missing or unsafe: $FAIL2BAN_POLICY"
        return
    fi

    policy_ports=$(awk '
        /^\[sshd\][[:space:]]*$/ { in_sshd = 1; next }
        /^\[/ { in_sshd = 0 }
        in_sshd && /^[[:space:]]*port[[:space:]]*=/ {
            sub(/^[^=]*=[[:space:]]*/, "")
            print
            exit
        }
    ' "$FAIL2BAN_POLICY")
    expected_ports=2356
    [ "$SSH_PHASE" = prepare ] && expected_ports=22,2356
    if [ "$policy_ports" = "$expected_ports" ]; then
        pass_msg "Fail2ban sshd jail watches expected ports $expected_ports"
    else
        fail_msg "Fail2ban sshd jail ports are '${policy_ports:-missing}', expected $expected_ports"
    fi

    policy_ignore=$(awk '
        /^\[DEFAULT\][[:space:]]*$/ { in_default = 1; next }
        /^\[/ { in_default = 0 }
        in_default && /^[[:space:]]*ignoreip[[:space:]]*=/ {
            sub(/^[^=]*=[[:space:]]*/, "")
            print
            exit
        }
    ' "$FAIL2BAN_POLICY")
    policy_ignore_count=$(printf '%s\n' "$policy_ignore" | awk '{ print NF }')
    if [ "$policy_ignore_count" -gt 2 ] \
        && printf ' %s ' "$policy_ignore" | grep -F ' 127.0.0.1/8 ' >/dev/null \
        && printf ' %s ' "$policy_ignore" | grep -F ' ::1 ' >/dev/null; then
        pass_msg "Fail2ban policy contains loopback and administrative exclusions"
    else
        fail_msg "Fail2ban policy must contain loopback and at least one administrative ignore CIDR"
    fi
    for expected_ignore_ip in $EXPECTED_IGNORE_IPS; do
        if printf ' %s ' "$policy_ignore" \
            | grep -F " $expected_ignore_ip " >/dev/null; then
            pass_msg "Fail2ban policy excludes administrative CIDR $expected_ignore_ip"
        else
            fail_msg "Fail2ban policy is missing administrative CIDR $expected_ignore_ip"
        fi
    done

    [ "$fail2ban_active" = yes ] || return
    if fail2ban_jail_active sshd; then
        pass_msg "Fail2ban sshd jail is active"
    else
        fail_msg "Fail2ban sshd jail is not active"
    fi
    for nginx_jail in nginx-http-auth nginx-limit-req nginx-444; do
        case "$TOPOLOGY" in
            direct)
                if fail2ban_jail_active "$nginx_jail"; then
                    pass_msg "Fail2ban $nginx_jail jail is active for direct topology"
                else
                    fail_msg "Fail2ban $nginx_jail jail is not active for direct topology"
                fi
                ;;
            proxied)
                if fail2ban_jail_active "$nginx_jail"; then
                    fail_msg "Fail2ban $nginx_jail jail must be disabled for proxied topology"
                else
                    pass_msg "Fail2ban $nginx_jail jail is disabled for proxied topology"
                fi
                ;;
        esac
    done
}

check_selinux() {
    printf 'Checking SELinux policy and labels...\n'
    missing_tool=0
    for selinux_tool in selinuxenabled getenforce sestatus semanage getsebool; do
        if ! command -v "$selinux_tool" >/dev/null 2>&1; then
            fail_msg "required SELinux tool is unavailable: $selinux_tool"
            missing_tool=1
        fi
    done
    if [ "$missing_tool" -ne 0 ]; then
        return
    fi
    if ! selinuxenabled 2>/dev/null; then
        fail_msg "SELinux is disabled"
        return
    fi

    current_mode=$(getenforce 2>/dev/null || echo "Unknown")
    if [ "$current_mode" = "Enforcing" ]; then
        pass_msg "SELinux mode is Enforcing"
    else
        fail_msg "SELinux is in $current_mode mode (must be Enforcing)"
    fi

    if [ ! -f "$SELINUX_CONFIG" ]; then
        fail_msg "SELinux configuration is missing: $SELINUX_CONFIG"
    else
        configured_mode=$(awk -F= '$1 == "SELINUX" { print $2 }' "$SELINUX_CONFIG" | tail -n 1)
        configured_type=$(awk -F= '$1 == "SELINUXTYPE" { print $2 }' "$SELINUX_CONFIG" | tail -n 1)
        [ "$configured_mode" = enforcing ] \
            || fail_msg "$SELINUX_CONFIG must configure SELINUX=enforcing"
        [ "$configured_type" = targeted ] \
            || fail_msg "$SELINUX_CONFIG must configure SELINUXTYPE=targeted"
    fi

    loaded_policy=$(sestatus 2>/dev/null | awk -F: '/Loaded policy name/ { gsub(/^[[:space:]]+/, "", $2); print $2 }')
    if [ "$loaded_policy" = targeted ]; then
        pass_msg "loaded SELinux policy is targeted"
    else
        fail_msg "loaded SELinux policy is ${loaded_policy:-unknown} (must be targeted)"
    fi

    if ! port_list=$(semanage port -l 2>/dev/null); then
        fail_msg "unable to read SELinux port labels"
        return
    fi
    if printf '%s\n' "$port_list" | grep '^http_port_t' | grep -F 'udp' | grep -qw '443'; then
        pass_msg "UDP port 443 is labeled http_port_t for QUIC"
    else
        fail_msg "UDP port 443 is missing http_port_t label; run selinux/apply-nginx-policy"
    fi

    if printf '%s\n' "$port_list" | grep '^ssh_port_t' | grep -F 'tcp' | grep -qw '2356'; then
        pass_msg "TCP port 2356 is labeled ssh_port_t"
    else
        fail_msg "TCP port 2356 is missing ssh_port_t label"
    fi

    if getsebool httpd_setrlimit 2>/dev/null | grep -q -- '--> on'; then
        pass_msg "SELinux boolean httpd_setrlimit is on"
    else
        fail_msg "SELinux boolean httpd_setrlimit is off; workers cannot set worker_rlimit_nofile"
    fi
}

check_site_socket() {
    if [ -z "$SITE_TAG" ]; then
        return
    fi

    printf 'Checking PHP-FPM socket and permissions for site %s...\n' "$SITE_TAG"
    socket_path="/run/$SITE_TAG/php-fpm.sock"
    if [ -S "$socket_path" ]; then
        pass_msg "PHP-FPM socket exists: $socket_path"
        if ! command -v getfacl >/dev/null 2>&1; then
            fail_msg "getfacl is unavailable; cannot validate $socket_path"
        elif getfacl -p "$socket_path" 2>/dev/null | grep -q 'user:nginx:rw-'; then
            pass_msg "POSIX ACL grants nginx rw access on $socket_path"
        else
            fail_msg "POSIX ACL missing user:nginx:rw- on $socket_path"
        fi
    else
        fail_msg "PHP-FPM socket is not active: $socket_path"
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend)
            [ "$#" -ge 2 ] || { usage >&2; exit 1; }
            BACKEND=$2
            shift 2
            ;;
        --ignore-ip)
            [ "$#" -ge 2 ] || { usage >&2; exit 1; }
            append_expected_ignore_ip "$2"
            shift 2
            ;;
        --ssh-phase)
            [ "$#" -ge 2 ] || { usage >&2; exit 1; }
            SSH_PHASE=$2
            shift 2
            ;;
        --site)
            [ "$#" -ge 2 ] || { usage >&2; exit 1; }
            SITE_TAG=$2
            shift 2
            ;;
        --topology)
            [ "$#" -ge 2 ] || { usage >&2; exit 1; }
            TOPOLOGY=$2
            shift 2
            ;;
        --verbose | -v)
            VERBOSE=1
            shift
            ;;
        --zone)
            [ "$#" -ge 2 ] || { usage >&2; exit 1; }
            ZONE=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            printf '%s: unknown argument: %s\n' "$PROGRAM_NAME" "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

