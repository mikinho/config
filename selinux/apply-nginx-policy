#!/bin/sh

set -eu

PROGRAM_NAME=${0##*/}

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME

Registers the persistent SELinux policy the nginx baseline requires beyond
the distribution policy: file contexts for the unit's runtime directories,
the QUIC UDP port label, and the setrlimit boolean. Idempotent; run as root
on an SELinux-enabled RHEL-family host after installing
systemd/system/nginx.service.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    usage >&2
    exit 1
}

command -v semanage >/dev/null 2>&1 \
    || fail 'semanage not found; install policycoreutils-python-utils'
command -v restorecon >/dev/null 2>&1 \
    || fail 'restorecon not found; install policycoreutils'
command -v setsebool >/dev/null 2>&1 \
    || fail 'setsebool not found; install policycoreutils'
command -v selinuxenabled >/dev/null 2>&1 \
    || fail 'selinuxenabled not found; install libselinux-utils'
selinuxenabled || fail 'SELinux is not enabled on this host'

ensure_file_context() {
    context_type=$1
    path_specification=$2

    semanage fcontext --add --type "$context_type" "$path_specification" \
        2>/dev/null \
        || semanage fcontext --modify --type "$context_type" \
            "$path_specification"
}

remove_file_context_if_present() {
    path_specification=$1
    local_file_contexts=$(
        semanage fcontext --list --locallist --noheading
    )

    if printf '%s\n' "$local_file_contexts" |
        awk -v candidate="$path_specification" \
            '$1 == candidate { found = 1 } END { exit found ? 0 : 1 }'
    then
        semanage fcontext --delete "$path_specification"
    fi
}

ensure_port_type() {
    port_type=$1
    protocol=$2
    port_number=$3

    semanage port --add --type "$port_type" --proto "$protocol" \
        "$port_number" 2>/dev/null \
        || semanage port --modify --type "$port_type" --proto "$protocol" \
            "$port_number"
}

# The distribution policy already labels /var/log/nginx, /var/lib/nginx,
# /var/www, and /etc/nginx correctly. It covers only the /var/run/nginx.pid
# file, not the PID and lock directories that systemd/system/nginx.service
# creates, so those two need persistent local rules. RHEL-family policy maps
# /run to /var/run and /run/lock to /var/lock with fcontext equivalency rules:
# semanage therefore requires those canonical spellings even though the
# runtime paths and restorecon targets remain under /run.
ensure_file_context httpd_var_run_t '/var/run/nginx(/.*)?'
ensure_file_context httpd_var_run_t '/var/lock/nginx(/.*)?'
remove_file_context_if_present '/var/run/lock/nginx(/.*)?'

for runtime_directory in /run/nginx /run/lock/nginx; do
    [ -d "$runtime_directory" ] || continue
    restorecon -RF "$runtime_directory"
done

# SELinux checks port labels per protocol, and http_port_t historically
# lists only TCP ports. Without a UDP 443 label the QUIC listener cannot
# bind under enforcing mode. Policies that already define it are modified
# to the same value, which keeps this safe to re-run everywhere.
ensure_port_type http_port_t udp 443

# worker_rlimit_nofile requires setrlimit permission. Recent policies enable
# this boolean by default; setting it explicitly keeps the baseline correct
# on the ones that do not, and re-running is harmless.
setsebool -P httpd_setrlimit on

printf 'Registered nginx SELinux policy.\n'
