#!/bin/sh

set -eu

PROGRAM_NAME=${0##*/}

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME

Registers the persistent SELinux file contexts required by the nginx baseline
beyond the distribution policy, then relabels the affected paths when they
exist. Run as root on an SELinux-enabled RHEL-family host after installing
systemd/nginx.service.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    usage >&2
    exit 1
}

command -v semanage >/dev/null 2>&1 \
    || fail 'semanage not found; install policycoreutils-python-utils'
command -v restorecon >/dev/null 2>&1 \
    || fail 'restorecon not found; install policycoreutils'
command -v selinuxenabled >/dev/null 2>&1 \
    || fail 'selinuxenabled not found; install libselinux-utils'
selinuxenabled || fail 'SELinux is not enabled on this host'

ensure_file_context() {
    context_type=$1
    path_specification=$2

    semanage fcontext --add --type "$context_type" "$path_specification" \
        2>/dev/null \
        || semanage fcontext --modify --type "$context_type" \
            "$path_specification"
}

# The distribution policy already labels /var/log/nginx, /var/lib/nginx,
# /var/www, and /etc/nginx correctly. It covers only the /var/run/nginx.pid
# file, not the PID and lock directories that systemd/nginx.service creates,
# so those two need persistent local rules.
ensure_file_context httpd_var_run_t '/run/nginx(/.*)?'
ensure_file_context httpd_var_run_t '/run/lock/nginx(/.*)?'

for runtime_directory in /run/nginx /run/lock/nginx; do
    [ -d "$runtime_directory" ] || continue
    restorecon -RF "$runtime_directory"
done

printf 'Registered nginx runtime file contexts.\n'
