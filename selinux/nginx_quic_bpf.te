# selinux/nginx_quic_bpf.te

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

module nginx_quic_bpf 1.2;

# Optional: SELinux policy module for the quic-bpf deployment profile.
#
# The base RHEL httpd policy grants httpd_t no BPF permissions, so enabling
# quic_bpf under enforcing mode fails at startup without this module. Load it
# only on hosts that select stubs/quic-bpf.conf, and remove it with
# `semodule -r nginx_quic_bpf` when the profile is removed.
#
# RHEL 9.4 additionally checks net_admin when nginx creates the
# BPF_MAP_TYPE_REUSEPORT_SOCKARRAY and checks sys_admin plus perfmon when nginx
# loads the reuseport selector program. Keep any further capability additions
# tied to a reproduced AVC denial on the target kernel and nginx build.

require {
    type httpd_t;
    class bpf { map_create map_read map_write prog_load prog_run };
    class capability { net_admin sys_admin };
    class capability2 { bpf perfmon };
}

allow httpd_t self:capability { net_admin sys_admin };
allow httpd_t self:capability2 { bpf perfmon };
allow httpd_t self:bpf { map_create map_read map_write prog_load prog_run };
