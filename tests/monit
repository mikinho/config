#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
MONIT_DIRECTORY=$REPOSITORY_ROOT/monit
INSTALLER=$MONIT_DIRECTORY/install
SETUP=$MONIT_DIRECTORY/setup
VERIFIER=$MONIT_DIRECTORY/verify
VERSION_LIBRARY=$MONIT_DIRECTORY/lib/version.sh
SECURITY_LIBRARY=$MONIT_DIRECTORY/lib/security.sh
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/config-monit-tests.XXXXXX")

cleanup() {
    if [ -d "$TEST_ROOT" ]; then
        rm -rf -- "$TEST_ROOT"
    fi
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

assert_contains() {
    checked_file=$1
    expected_text=$2
    grep -F -- "$expected_text" "$checked_file" >/dev/null 2>&1 \
        || fail "expected text not found in $checked_file: $expected_text"
}

assert_mode() {
    checked_file=$1
    expected_mode=$2
    actual_mode=$(stat -c '%a' "$checked_file" 2>/dev/null \
        || stat -f '%Lp' "$checked_file")
    [ "$actual_mode" = "$expected_mode" ] \
        || fail "$checked_file mode is $actual_mode, expected $expected_mode"
}

file_mtime() {
    stat -c '%Y' "$1" 2>/dev/null || stat -f '%m' "$1"
}

expect_failure() {
    expected_error=$1
    shift
    if "$@" > "$TEST_ROOT/unexpected.stdout" 2> "$TEST_ROOT/expected.stderr"; then
        fail "command unexpectedly succeeded: $*"
    fi
    assert_contains "$TEST_ROOT/expected.stderr" "$expected_error"
}

extract_function() {
    function_name=$1
    source_file=$2
    sed -n "/^$function_name() {/,/^}/p" "$source_file"
}

make_os_release() {
    output_path=$1
    os_id=$2
    pretty_name=$3
    version_id=$4
    {
        printf 'ID=%s\n' "$os_id"
        printf 'PRETTY_NAME="%s"\n' "$pretty_name"
        printf 'VERSION_ID="%s"\n' "$version_id"
    } > "$output_path"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

make_os_release "$TEST_ROOT/rocky9" rocky 'Rocky Linux 9.6' 9.6
make_os_release "$TEST_ROOT/centos10" centos 'CentOS Stream 10' 10

"$INSTALLER" --check >/dev/null
"$SETUP" --check >/dev/null
"$VERIFIER" --check >/dev/null

# shellcheck disable=SC1090
. "$VERSION_LIBRARY"
monit_validate_version_policy \
    || fail 'Monit version policy is internally inconsistent'
for supported_version in 5.35.2 5.35.2.0 6.0.0 10.0; do
    monit_version_is_at_least "$supported_version" "$MONIT_SUPPORTED_VERSION" \
        || fail "supported Monit version was rejected: $supported_version"
done
for unsupported_version in 5.35.1 5.34.4 4.99.0 malformed; do
    if monit_version_is_at_least \
        "$unsupported_version" "$MONIT_SUPPORTED_VERSION"
    then
        fail "unsupported Monit version was accepted: $unsupported_version"
    fi
done

"$INSTALLER" --plan --os-release "$TEST_ROOT/rocky9" \
    > "$TEST_ROOT/install-rocky.plan"
assert_contains "$TEST_ROOT/install-rocky.plan" 'Monit installation target: Rocky Linux 9'
assert_contains "$TEST_ROOT/install-rocky.plan" \
    'Monit version policy: require 5.35.2 or newer; prefer 6.0.0 when EPEL supplies it.'
for package_name in acl audit iproute libselinux-utils logrotate monit openssl \
    policycoreutils procps-ng
do
    assert_contains "$TEST_ROOT/install-rocky.plan" "$package_name"
done
assert_contains "$TEST_ROOT/install-rocky.plan" \
    '/usr/local/libexec/config-monit'
assert_contains "$TEST_ROOT/install-rocky.plan" \
    'Plan complete; Monit policy would remain inactive.'

"$INSTALLER" --plan --os-release "$TEST_ROOT/centos10" \
    > "$TEST_ROOT/install-centos.plan"
assert_contains "$TEST_ROOT/install-centos.plan" 'Monit installation target: CentOS Stream 10'

"$SETUP" --output "$TEST_ROOT/rendered"
for rendered_path in \
    etc/monitrc \
    etc/monit.d/10-system.conf \
    etc/logrotate.d/monit \
    etc/systemd/system/monit.service.d/10-baseline.conf
do
    [ -f "$TEST_ROOT/rendered/$rendered_path" ] \
        || fail "rendered Monit path is missing: $rendered_path"
done
assert_mode "$TEST_ROOT/rendered/etc/monitrc" 600
assert_mode "$TEST_ROOT/rendered/etc/monit.d/10-system.conf" 600
assert_mode "$TEST_ROOT/rendered/etc/logrotate.d/monit" 644
assert_mode "$TEST_ROOT/rendered/etc/systemd/system/monit.service.d/10-baseline.conf" 644
assert_contains "$TEST_ROOT/rendered/etc/monitrc" 'include /etc/monit.d/*.conf'
assert_contains "$TEST_ROOT/rendered/etc/monitrc" '    use address 127.0.0.1'
if grep -F 'admin:monit' "$TEST_ROOT/rendered/etc/monitrc" >/dev/null 2>&1; then
    fail 'render retained the package default Monit credential'
fi
rendered_password=$(awk '
    $1 == "allow" && $2 ~ /^admin:/ {
        sub(/^admin:/, "", $2)
        print $2
    }
' "$TEST_ROOT/rendered/etc/monitrc")
printf '%s\n' "$rendered_password" | grep -Eq '^[0-9a-f]{64}$' \
    || fail 'rendered local control password is not 256-bit hexadecimal'
if grep -F '@@' "$TEST_ROOT/rendered/etc/monitrc" >/dev/null 2>&1; then
    fail 'rendered main control file retained a template token'
fi

install -d "$TEST_ROOT/gnu-stat-bin" "$TEST_ROOT/bsd-stat-bin"
cat > "$TEST_ROOT/gnu-stat-bin/stat" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = -c ] && [ "$2" = %a ]; then
    printf '600\n'
    exit 0
fi
if [ "$1" = -f ]; then
    printf 'GNU stat -f emitted filesystem metadata before failing\n'
    exit 1
fi
exit 1
EOF
cat > "$TEST_ROOT/bsd-stat-bin/stat" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = -c ]; then
    exit 1
fi
if [ "$1" = -f ] && [ "$2" = %Lp ]; then
    printf '600\n'
    exit 0
fi
exit 1
EOF
chmod 0755 "$TEST_ROOT/gnu-stat-bin/stat" "$TEST_ROOT/bsd-stat-bin/stat"
PATH="$TEST_ROOT/gnu-stat-bin:$PATH" \
    "$SETUP" --output "$TEST_ROOT/gnu-stat-rendered"
PATH="$TEST_ROOT/bsd-stat-bin:$PATH" \
    "$SETUP" --output "$TEST_ROOT/bsd-stat-rendered"

install -d "$TEST_ROOT/monit-bin"
cat > "$TEST_ROOT/monit-bin/monit" <<'EOF'
#!/usr/bin/env sh
[ "$1" = -t ] && [ "$2" = -c ] && [ -f "$3" ] || exit 2
for live_runtime_path in \
    '/var/log/monit/monit.log' \
    '/run/monit/monit.pid' \
    '/var/lib/monit/id' \
    '/var/lib/monit/state' \
    '/var/lib/monit/events'
do
    if grep -F "$live_runtime_path" "$3" >/dev/null 2>&1; then
        printf 'candidate parser received live runtime path: %s\n' \
            "$live_runtime_path" >&2
        exit 3
    fi
done
exit 0
EOF
chmod 0755 "$TEST_ROOT/monit-bin/monit"
PATH="$TEST_ROOT/monit-bin:$PATH" \
    "$SETUP" --output "$TEST_ROOT/runtime-safe-rendered"

install -d "$TEST_ROOT/control-bin"
cat > "$TEST_ROOT/control-bin/monit" <<'EOF'
#!/usr/bin/env sh
attempts=$(cat "$CONTROL_ATTEMPTS" 2>/dev/null || printf '0')
attempts=$((attempts + 1))
printf '%s\n' "$attempts" > "$CONTROL_ATTEMPTS"
[ "$attempts" -ge "${CONTROL_SUCCEEDS_ON:-999}" ]
EOF
cat > "$TEST_ROOT/control-bin/sleep" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
chmod 0755 "$TEST_ROOT/control-bin/monit" "$TEST_ROOT/control-bin/sleep"
wait_for_control_plane_function=$(extract_function wait_for_control_plane "$SETUP")
[ -n "$wait_for_control_plane_function" ] \
    || fail 'cannot extract Monit control-plane readiness function'
CONTROL_ATTEMPTS="$TEST_ROOT/control-attempts" CONTROL_SUCCEEDS_ON=3 \
    MONIT_MAIN=/test/monitrc PATH="$TEST_ROOT/control-bin:$PATH" \
    sh -c "$wait_for_control_plane_function
        wait_for_control_plane" \
    || fail 'control-plane readiness wait rejected eventual success'
[ "$(cat "$TEST_ROOT/control-attempts")" = 3 ] \
    || fail 'control-plane readiness wait did not retry to success'
rm -f "$TEST_ROOT/control-attempts"
if CONTROL_ATTEMPTS="$TEST_ROOT/control-attempts" CONTROL_SUCCEEDS_ON=999 \
    MONIT_MAIN=/test/monitrc PATH="$TEST_ROOT/control-bin:$PATH" \
    sh -c "$wait_for_control_plane_function
        wait_for_control_plane"
then
    fail 'control-plane readiness wait did not time out'
fi
[ "$(cat "$TEST_ROOT/control-attempts")" = 75 ] \
    || fail 'control-plane readiness wait used the wrong timeout bound'

rollback_target=$TEST_ROOT/rollback-target
rollback_relative_path=${rollback_target#/}
rollback_root=$TEST_ROOT/rollback
rollback_file=$rollback_root/files/$rollback_relative_path
rollback_present=$rollback_root/present/$rollback_relative_path
install -d "${rollback_file%/*}" "${rollback_present%/*}"
printf '%s\n' 'package original' > "$rollback_file"
chmod 0600 "$rollback_file"
touch -t 202001020304 "$rollback_file"
: > "$rollback_present"
printf '%s\n' 'managed replacement' > "$rollback_target"
chmod 0644 "$rollback_target"
restore_target_function=$(extract_function stage_path "$SETUP"; extract_function restore_target "$SETUP")
[ -n "$restore_target_function" ] \
    || fail 'cannot extract Monit rollback restore function'
# Production rollback uses GNU cp to preserve SELinux contexts and ACLs too.
# Translate its SELinux-specific options for this portable metadata fixture;
# full context/xattr acceptance still requires an enforcing target host.
install -d "$TEST_ROOT/metadata-bin"
cat > "$TEST_ROOT/metadata-bin/cp" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = --preserve=mode,ownership,timestamps,xattr,context ]; then
    shift
    exec /bin/cp -p "$@"
fi
exec /bin/cp "$@"
EOF
chmod 0755 "$TEST_ROOT/metadata-bin/cp"
BACKUP_DIRECTORY=$rollback_root PATH="$TEST_ROOT/metadata-bin:$PATH" sh -c "$restore_target_function
    restore_target '$rollback_target'"
cmp -s "$rollback_file" "$rollback_target" \
    || fail 'Monit rollback did not restore exact file content'
assert_mode "$rollback_target" 600
[ "$(file_mtime "$rollback_target")" = "$(file_mtime "$rollback_file")" ] \
    || fail 'Monit rollback did not preserve the original modification time'
# Atomic restore must sever a live hardlink rather than overwriting its alias.
ln "$rollback_target" "$TEST_ROOT/rollback-alias"
printf '%s\n' 'later mutation' > "$rollback_target"
BACKUP_DIRECTORY=$rollback_root PATH="$TEST_ROOT/metadata-bin:$PATH" sh -c "$restore_target_function
    restore_target '$rollback_target'"
assert_contains "$TEST_ROOT/rollback-alias" 'later mutation'
assert_contains "$rollback_target" 'package original'

# Staged copies live beside their target for an atomic rename. Under a
# logrotate include directory the staging name must carry a taboo extension,
# or logrotate would parse the half-copied file as a duplicate policy; other
# targets are read by exact name or *.conf glob and need only a plain suffix.
stage_path_function=$(extract_function stage_path "$SETUP")
install -d "$TEST_ROOT/stage/etc/logrotate.d" "$TEST_ROOT/stage/etc/monit.d"
if command -v mktemp >/dev/null 2>&1 && mktemp "$TEST_ROOT/stage/probe.XXXXXX.suffix" >/dev/null 2>&1; then
    rm -f "$TEST_ROOT/stage"/probe.*.suffix
    logrotate_stage=$(sh -c "$stage_path_function
        stage_path '$TEST_ROOT/stage/etc/logrotate.d/monit' tmp")
    case "$logrotate_stage" in
        "$TEST_ROOT/stage/etc/logrotate.d/monit.tmp."??????.disabled) ;;
        *) fail "logrotate staging name lacks the taboo extension: $logrotate_stage" ;;
    esac
    [ -f "$logrotate_stage" ] || fail 'logrotate staging file was not created'
else
    printf 'Skipping the logrotate staging-suffix case: mktemp lacks suffix support here.\n'
fi
fragment_stage=$(sh -c "$stage_path_function
    stage_path '$TEST_ROOT/stage/etc/monit.d/70-example.conf' rollback")
case "$fragment_stage" in
    "$TEST_ROOT/stage/etc/monit.d/70-example.conf.rollback."??????) ;;
    *) fail "fragment staging name is not the plain suffix form: $fragment_stage" ;;
esac
case "$fragment_stage" in
    *.conf) fail 'a staged fragment must not match the *.conf include glob' ;;
esac
[ -f "$fragment_stage" ] || fail 'fragment staging file was not created'

# Verification audits the transaction store: private identities, no unresolved
# transactions, and a warning once completed ones accumulate.
transaction_functions=$(extract_function warn "$VERIFIER"; extract_function verify_setup_transaction "$VERIFIER"; extract_function verify_transaction_evidence "$VERIFIER")
evidence_store=$TEST_ROOT/evidence
make_transaction() {
    install -d "$evidence_store/backups/transaction.$1"
    printf '%s\n' "$2" > "$evidence_store/backups/transaction.$1/status"
}
run_evidence_check() {
    env TRANSACTION_STORE="$evidence_store" BACKUP_ROOT="$evidence_store/backups" \
        RETAINED_TRANSACTION_WARNING=5 PROGRAM_NAME=monit-test SETUP_TRANSACTION='' \
        sh -c "set -eu; set -f
            fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
            require_directory_identity() { printf 'identity %s\\n' \"\$1\" >> '$TEST_ROOT/identity-checks'; }
            $transaction_functions
            verify_transaction_evidence"
}
rm -rf "$evidence_store"; : > "$TEST_ROOT/identity-checks"
install -d "$evidence_store/backups"
run_evidence_check 2> "$TEST_ROOT/evidence.stderr"
[ ! -s "$TEST_ROOT/evidence.stderr" ] || fail 'an empty transaction store produced diagnostics'
assert_contains "$TEST_ROOT/identity-checks" "identity $evidence_store"
assert_contains "$TEST_ROOT/identity-checks" "identity $evidence_store/backups"
make_transaction 00000001 committed
make_transaction 00000002 rolled-back
: > "$TEST_ROOT/identity-checks"
run_evidence_check 2> "$TEST_ROOT/evidence.stderr"
[ ! -s "$TEST_ROOT/evidence.stderr" ] || fail 'completed transactions produced diagnostics'
assert_contains "$TEST_ROOT/identity-checks" "identity $evidence_store/backups/transaction.00000002"
for unresolved_status in applying preparing rollback-incomplete; do
    make_transaction 00000003 "$unresolved_status"
    expect_failure '1 retained Monit transaction(s) are unresolved' run_evidence_check
    assert_contains "$TEST_ROOT/expected.stderr" "unresolved Monit transaction ($unresolved_status)"
done
rm -f "$evidence_store/backups/transaction.00000003/status"
expect_failure 'unresolved Monit transaction (missing)' run_evidence_check
rm -rf "$evidence_store/backups/transaction.00000003"
for transaction_index in 3 4 5; do make_transaction "0000000$transaction_index" committed; done
run_evidence_check 2> "$TEST_ROOT/evidence.stderr"
[ ! -s "$TEST_ROOT/evidence.stderr" ] || fail 'five completed transactions must not warn'
make_transaction 00000006 committed
run_evidence_check 2> "$TEST_ROOT/evidence.stderr"
assert_contains "$TEST_ROOT/evidence.stderr" 'warning: 6 completed Monit transactions are retained'

# Run the actual finalization and cleanup functions against a child verifier
# using the production argument parser, evidence checks, and shell options.
# Ownership and ACL enforcement require a Linux root fixture; these portable
# identity stubs still check actual types, modes, and hardlink counts.
transaction_verifier=$TEST_ROOT/transaction-verifier
{
    printf '%s\n' '#!/usr/bin/env sh' 'set -eu' 'set -f' \
        'PROGRAM_NAME=monit-test' 'MODE=verify' 'SETUP_TRANSACTION=' \
        'RETAINED_TRANSACTION_WARNING=5'
    extract_function fail "$VERIFIER"
    extract_function assert_mode "$0"
    cat <<'EOF'
require_directory_identity() {
    [ -d "$1" ] && [ ! -L "$1" ] || fail "invalid transaction directory: $1"
    assert_mode "$1" 700
}
require_regular_file_identity() {
    [ -f "$1" ] && [ ! -L "$1" ] || fail "invalid transaction file: $1"
    assert_mode "$1" 600
    file_links=$(stat -c '%h' "$1" 2>/dev/null || stat -f '%l' "$1")
    [ "$file_links" -eq 1 ] || fail "transaction file has aliases: $1"
}
# Sandboxed macOS may deny ps. The shell's real parent identity gives the same
# fixture relationship without permitting a caller-provided expected PID.
ps() {
    [ "$*" = "-o ppid= -p $$" ] || fail "unexpected process query: $*"
    printf '%s\n' "$PPID"
}
EOF
    printf '%s\n' "$transaction_functions"
    sed -n '/^while \[ "\$#" -gt 0 \]; do/,/^done$/p' "$VERIFIER"
    cat <<'EOF'
verify_transaction_evidence
[ "${MONIT_TEST_FINAL_AUDIT_FAIL:-no}" = no ] || fail "later acceptance check failed"
EOF
} > "$transaction_verifier"
chmod 0700 "$transaction_verifier"
transaction_commit=$TEST_ROOT/transaction-commit
{
    printf '%s\n' '#!/usr/bin/env sh' 'set -eu' 'set -f' 'umask 077' \
        'PROGRAM_NAME=monit-test' 'CHANGES_STARTED=yes' 'TRANSACTION_COMMITTED=no' \
        'TEMPORARY_DIRECTORY=' 'PENDING_STAGE=' 'BACKED_UP_TARGETS=/test/target' \
        'MONIT_MAIN=/test/monitrc' 'SERVICE_WAS_ENABLED=yes' 'SERVICE_WAS_ACTIVE=yes' \
        'SERVICE_RESTART_REQUIRED=no'
    extract_function rollback_transaction "$SETUP"
    extract_function cleanup "$SETUP"
    extract_function verify_and_commit_transaction "$SETUP"
    cat <<'EOF'
restore_target() { printf 'restored\n' >> "$MONIT_TEST_ROLLBACK_LOG"; }
monit() { return 0; }
systemctl() { printf '%s\n' "$*" >> "$MONIT_TEST_ROLLBACK_LOG"; }
trap 'cleanup "$?"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
verify_and_commit_transaction
EOF
} > "$transaction_commit"
reset_commit_fixture() {
    rm -rf "$evidence_store"
    install -d -m 0700 "$evidence_store" "$evidence_store/backups" \
        "$evidence_store/backups/transaction.00000001"
    printf '%s\n' applying > "$evidence_store/backups/transaction.00000001/status"
    chmod 0600 "$evidence_store/backups/transaction.00000001/status"
    : > "$TEST_ROOT/commit-rollback.log"
}
run_commit_fixture() {
    env TRANSACTION_STORE="$evidence_store" BACKUP_ROOT="$evidence_store/backups" \
        BACKUP_DIRECTORY="$evidence_store/backups/transaction.00000001" \
        VERIFIER_SOURCE="$transaction_verifier" \
        MONIT_TEST_ROLLBACK_LOG="$TEST_ROOT/commit-rollback.log" \
        "$@" sh "$transaction_commit"
}
# Arguments are supplied indirectly through expect_failure below.
# shellcheck disable=SC2120
run_transaction_verifier() {
    env TRANSACTION_STORE="$evidence_store" BACKUP_ROOT="$evidence_store/backups" \
        "$transaction_verifier" "$@"
}
reset_commit_fixture
if ! run_commit_fixture MONIT_TEST_FINAL_AUDIT_FAIL=no \
    > "$TEST_ROOT/commit.stdout" 2> "$TEST_ROOT/commit.stderr"
then
    cat "$TEST_ROOT/commit.stderr" >&2
    fail 'setup acceptance did not commit its own applying transaction'
fi
assert_contains "$evidence_store/backups/transaction.00000001/status" committed
assert_mode "$evidence_store/backups/transaction.00000001/setup-pid" 600
[ ! -s "$TEST_ROOT/commit-rollback.log" ] || fail 'successful acceptance rolled back setup'
# Exercise standalone acceptance with no internal context.
# shellcheck disable=SC2119
run_transaction_verifier

reset_commit_fixture
make_transaction 00000002 applying
chmod 0700 "$evidence_store/backups/transaction.00000002"
chmod 0600 "$evidence_store/backups/transaction.00000002/status"
expect_failure '1 retained Monit transaction(s) are unresolved' run_commit_fixture
assert_contains "$evidence_store/backups/transaction.00000001/status" rolled-back
assert_contains "$evidence_store/backups/transaction.00000002/status" applying
assert_contains "$TEST_ROOT/commit-rollback.log" restored

reset_commit_fixture
expect_failure 'later acceptance check failed' run_commit_fixture MONIT_TEST_FINAL_AUDIT_FAIL=yes
assert_contains "$evidence_store/backups/transaction.00000001/status" rolled-back
assert_contains "$TEST_ROOT/commit-rollback.log" restored

reset_commit_fixture
current_transaction=$evidence_store/backups/transaction.00000001
expect_failure '1 retained Monit transaction(s) are unresolved' run_transaction_verifier
printf '%s\n' 2147483647 > "$current_transaction/setup-pid"
chmod 0600 "$current_transaction/setup-pid"
expect_failure "does not belong to the verifier's live parent" \
    run_transaction_verifier --setup-transaction "$current_transaction"
chmod 0644 "$current_transaction/setup-pid"
expect_failure 'mode is 644, expected 600' \
    run_transaction_verifier --setup-transaction "$current_transaction"
chmod 0600 "$current_transaction/setup-pid"
ln "$current_transaction/setup-pid" "$evidence_store/pid-alias"
expect_failure 'transaction file has aliases' \
    run_transaction_verifier --setup-transaction "$current_transaction"
rm "$evidence_store/pid-alias"
expect_failure 'setup transaction must be directly under' \
    run_transaction_verifier --setup-transaction "$evidence_store/backups/../backups/transaction.00000001"
ln -s "$current_transaction" "$evidence_store/backups/transaction.00000002"
expect_failure 'invalid transaction directory' \
    run_transaction_verifier --setup-transaction "$evidence_store/backups/transaction.00000002"
rm "$evidence_store/backups/transaction.00000002"
printf '%s\n' committed > "$current_transaction/status"
expect_failure 'setup transaction must still be applying' \
    run_transaction_verifier --setup-transaction "$current_transaction"
for mode_order in before after; do
    if [ "$mode_order" = before ]; then
        set -- --check --setup-transaction "$current_transaction"
    else
        set -- --setup-transaction "$current_transaction" --check
    fi
    expect_failure 'setup transaction requires an acceptance audit' "$VERIFIER" "$@"
done
expect_failure 'setup transaction may be supplied only once' "$VERIFIER" \
    --setup-transaction "$current_transaction" --setup-transaction "$current_transaction"

install -d "$TEST_ROOT/fragments-a" "$TEST_ROOT/fragments-b"
printf '%s\n' 'check process example with pidfile /run/example.pid' \
    > "$TEST_ROOT/fragments-a/70-example.conf"
printf '%s\n' 'check host example with address 127.0.0.1' \
    > "$TEST_ROOT/fragments-b/70-example.conf"
"$SETUP" --output "$TEST_ROOT/fragment-render" \
    --fragment "$TEST_ROOT/fragments-a/70-example.conf"
cmp -s "$TEST_ROOT/fragments-a/70-example.conf" \
    "$TEST_ROOT/fragment-render/etc/monit.d/70-example.conf" \
    || fail 'requested deployment fragment was not copied exactly'
assert_mode "$TEST_ROOT/fragment-render/etc/monit.d/70-example.conf" 600

expect_failure 'duplicate fragment basename' \
    "$SETUP" --plan \
    --fragment "$TEST_ROOT/fragments-a/70-example.conf" \
    --fragment "$TEST_ROOT/fragments-b/70-example.conf"
cp "$TEST_ROOT/fragments-a/70-example.conf" "$TEST_ROOT/fragments-a/-example.conf"
cp "$TEST_ROOT/fragments-b/70-example.conf" "$TEST_ROOT/fragments-b/-example.conf"
expect_failure 'duplicate fragment basename: -example.conf' \
    "$SETUP" --output "$TEST_ROOT/duplicate-dash-render" \
    --fragment "$TEST_ROOT/fragments-a/-example.conf" \
    --fragment "$TEST_ROOT/fragments-b/-example.conf"
[ ! -e "$TEST_ROOT/duplicate-dash-render" ] || fail 'duplicate fragments produced an output tree'
(
    cd "$TEST_ROOT/fragments-a"
    "$SETUP" --output "$TEST_ROOT/dash-render" --fragment -example.conf
)
cmp -s "$TEST_ROOT/fragments-a/-example.conf" "$TEST_ROOT/dash-render/etc/monit.d/-example.conf" \
    || fail 'a leading-dash fragment was not rendered exactly'
expect_failure 'fragment name is reserved' \
    "$SETUP" --plan --fragment "$MONIT_DIRECTORY/conf.d/10-system.conf"

# Whitespace anywhere in a fragment path is rejected as a whole string before
# the newline-delimited list is word-split. A newline inside a directory
# component is the case a line-oriented check lets through.
newline_directory="$TEST_ROOT/frag$(printf '\nments')"
install -d "$newline_directory"
cp "$TEST_ROOT/fragments-a/70-example.conf" "$newline_directory/70-example.conf"
expect_failure 'fragment paths must not contain whitespace' \
    "$SETUP" --plan --fragment "$newline_directory/70-example.conf"

# The include scan must read the fragment itself, never standard input: awk
# treats a relative operand shaped like NAME=value as a variable assignment.
install -d "$TEST_ROOT/dir=evil"
