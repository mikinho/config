# Rollback service handling. The mocks record every systemctl invocation so
# each branch can prove which service commands ran and, as importantly, which
# did not. MONIT_TEST_RESTORE_FAIL, MONIT_TEST_RELOAD_FAIL, and
# MONIT_TEST_CONFIG_INVALID select the failing step.
rollback_function=$(extract_function rollback_transaction "$SETUP")
rollback_log=$TEST_ROOT/rollback-systemctl.log
rollback_state=$TEST_ROOT/rollback-active
rollback_check="PROGRAM_NAME=monit-test
    set -eu; set -f
    printf '%s\\n' \"\${MONIT_TEST_CURRENT_ACTIVE:-yes}\" > '$rollback_state'
    restore_target() { [ \"\${MONIT_TEST_RESTORE_FAIL:-no}\" = no ]; }
    monit() { [ \"\${MONIT_TEST_CONFIG_INVALID:-no}\" = no ]; }
    systemctl() {
        printf '%s\\n' \"\$*\" >> '$rollback_log'
        case \"\$1\" in
            daemon-reload) [ \"\${MONIT_TEST_RELOAD_FAIL:-no}\" = no ] ;;
            is-active) [ \"\$(cat '$rollback_state')\" = yes ] ;;
            stop) printf 'no\\n' > '$rollback_state' ;;
            restart|start)
                printf 'no\\n' > '$rollback_state'
                [ \"\${MONIT_TEST_LAUNCH_FAIL:-no}\" = no ] || return 1
                printf 'yes\\n' > '$rollback_state'
                ;;
            kill) [ \"\${MONIT_TEST_SIGNAL_FAIL:-no}\" = no ] ;;
            *) return 0 ;;
        esac
    }
    $rollback_function
    rollback_transaction"
run_rollback() {
    : > "$rollback_log"
    env BACKUP_DIRECTORY="$TEST_ROOT/retained-transaction" BACKED_UP_TARGETS=/test/target \
        MONIT_MAIN=/test/monitrc SERVICE_WAS_ENABLED=yes "$@" sh -c "$rollback_check"
}
assert_service_command() {
    grep -x -- "$1 monit.service" "$rollback_log" >/dev/null \
        || fail "rollback did not run: systemctl $1 monit.service"
}
refuse_service_command() {
    if grep -x -- "$1 monit.service" "$rollback_log" >/dev/null; then
        fail "rollback must not run: systemctl $1 monit.service"
    fi
}

