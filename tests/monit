#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
MONIT_DIRECTORY=$REPOSITORY_ROOT/monit
INSTALLER=$MONIT_DIRECTORY/install
SETUP=$MONIT_DIRECTORY/setup
VERIFIER=$MONIT_DIRECTORY/verify
VERSION_LIBRARY=$MONIT_DIRECTORY/lib/version.sh
SECURITY_LIBRARY=$MONIT_DIRECTORY/lib/security.sh
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/config-monit-tests.XXXXXX")

cleanup() {
    if [ -d "$TEST_ROOT" ]; then
        rm -rf -- "$TEST_ROOT"
    fi
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

assert_contains() {
    checked_file=$1
    expected_text=$2
    grep -F -- "$expected_text" "$checked_file" >/dev/null 2>&1 \
        || fail "expected text not found in $checked_file: $expected_text"
}

assert_mode() {
    checked_file=$1
    expected_mode=$2
    actual_mode=$(stat -c '%a' "$checked_file" 2>/dev/null \
        || stat -f '%Lp' "$checked_file")
    [ "$actual_mode" = "$expected_mode" ] \
        || fail "$checked_file mode is $actual_mode, expected $expected_mode"
}

file_mtime() {
    stat -c '%Y' "$1" 2>/dev/null || stat -f '%m' "$1"
}

expect_failure() {
    expected_error=$1
    shift
    if "$@" > "$TEST_ROOT/unexpected.stdout" 2> "$TEST_ROOT/expected.stderr"; then
        fail "command unexpectedly succeeded: $*"
    fi
    assert_contains "$TEST_ROOT/expected.stderr" "$expected_error"
}

extract_function() {
    function_name=$1
    source_file=$2
    sed -n "/^$function_name() {/,/^}/p" "$source_file"
}

make_os_release() {
    output_path=$1
    os_id=$2
    pretty_name=$3
    version_id=$4
    {
        printf 'ID=%s\n' "$os_id"
        printf 'PRETTY_NAME="%s"\n' "$pretty_name"
        printf 'VERSION_ID="%s"\n' "$version_id"
    } > "$output_path"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

make_os_release "$TEST_ROOT/rocky9" rocky 'Rocky Linux 9.6' 9.6
make_os_release "$TEST_ROOT/centos10" centos 'CentOS Stream 10' 10

"$INSTALLER" --check >/dev/null
"$SETUP" --check >/dev/null
"$VERIFIER" --check >/dev/null

# shellcheck disable=SC1090
. "$VERSION_LIBRARY"
monit_validate_version_policy \
    || fail 'Monit version policy is internally inconsistent'
for supported_version in 5.35.2 5.35.2.0 6.0.0 10.0; do
    monit_version_is_at_least "$supported_version" "$MONIT_SUPPORTED_VERSION" \
        || fail "supported Monit version was rejected: $supported_version"
done
for unsupported_version in 5.35.1 5.34.4 4.99.0 malformed; do
    if monit_version_is_at_least \
        "$unsupported_version" "$MONIT_SUPPORTED_VERSION"
    then
        fail "unsupported Monit version was accepted: $unsupported_version"
    fi
done

"$INSTALLER" --plan --os-release "$TEST_ROOT/rocky9" \
    > "$TEST_ROOT/install-rocky.plan"
assert_contains "$TEST_ROOT/install-rocky.plan" 'Monit installation target: Rocky Linux 9'
assert_contains "$TEST_ROOT/install-rocky.plan" \
    'Monit version policy: require 5.35.2 or newer; prefer 6.0.0 when EPEL supplies it.'
for package_name in acl audit iproute libselinux-utils logrotate monit openssl \
    policycoreutils procps-ng
do
    assert_contains "$TEST_ROOT/install-rocky.plan" "$package_name"
done
assert_contains "$TEST_ROOT/install-rocky.plan" \
    '/usr/local/libexec/config-monit'
assert_contains "$TEST_ROOT/install-rocky.plan" \
    'Plan complete; Monit policy would remain inactive.'

"$INSTALLER" --plan --os-release "$TEST_ROOT/centos10" \
    > "$TEST_ROOT/install-centos.plan"
assert_contains "$TEST_ROOT/install-centos.plan" 'Monit installation target: CentOS Stream 10'

"$SETUP" --output "$TEST_ROOT/rendered"
for rendered_path in \
    etc/monitrc \
    etc/monit.d/10-system.conf \
    etc/logrotate.d/monit \
    etc/systemd/system/monit.service.d/10-baseline.conf
do
    [ -f "$TEST_ROOT/rendered/$rendered_path" ] \
        || fail "rendered Monit path is missing: $rendered_path"
done
assert_mode "$TEST_ROOT/rendered/etc/monitrc" 600
assert_mode "$TEST_ROOT/rendered/etc/monit.d/10-system.conf" 600
assert_mode "$TEST_ROOT/rendered/etc/logrotate.d/monit" 644
assert_mode "$TEST_ROOT/rendered/etc/systemd/system/monit.service.d/10-baseline.conf" 644
assert_contains "$TEST_ROOT/rendered/etc/monitrc" 'include /etc/monit.d/*.conf'
assert_contains "$TEST_ROOT/rendered/etc/monitrc" '    use address 127.0.0.1'
if grep -F 'admin:monit' "$TEST_ROOT/rendered/etc/monitrc" >/dev/null 2>&1; then
    fail 'render retained the package default Monit credential'
fi
rendered_password=$(awk '
    $1 == "allow" && $2 ~ /^admin:/ {
        sub(/^admin:/, "", $2)
        print $2
    }
' "$TEST_ROOT/rendered/etc/monitrc")
printf '%s\n' "$rendered_password" | grep -Eq '^[0-9a-f]{64}$' \
    || fail 'rendered local control password is not 256-bit hexadecimal'
if grep -F '@@' "$TEST_ROOT/rendered/etc/monitrc" >/dev/null 2>&1; then
    fail 'rendered main control file retained a template token'
fi

install -d "$TEST_ROOT/gnu-stat-bin" "$TEST_ROOT/bsd-stat-bin"
cat > "$TEST_ROOT/gnu-stat-bin/stat" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = -c ] && [ "$2" = %a ]; then
    printf '600\n'
    exit 0
fi
if [ "$1" = -f ]; then
    printf 'GNU stat -f emitted filesystem metadata before failing\n'
    exit 1
fi
exit 1
EOF
cat > "$TEST_ROOT/bsd-stat-bin/stat" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = -c ]; then
    exit 1
fi
if [ "$1" = -f ] && [ "$2" = %Lp ]; then
    printf '600\n'
    exit 0
fi
exit 1
EOF
chmod 0755 "$TEST_ROOT/gnu-stat-bin/stat" "$TEST_ROOT/bsd-stat-bin/stat"
PATH="$TEST_ROOT/gnu-stat-bin:$PATH" \
    "$SETUP" --output "$TEST_ROOT/gnu-stat-rendered"
PATH="$TEST_ROOT/bsd-stat-bin:$PATH" \
    "$SETUP" --output "$TEST_ROOT/bsd-stat-rendered"

install -d "$TEST_ROOT/monit-bin"
cat > "$TEST_ROOT/monit-bin/monit" <<'EOF'
#!/usr/bin/env sh
[ "$1" = -t ] && [ "$2" = -c ] && [ -f "$3" ] || exit 2
for live_runtime_path in \
    '/var/log/monit/monit.log' \
    '/run/monit/monit.pid' \
    '/var/lib/monit/id' \
    '/var/lib/monit/state' \
    '/var/lib/monit/events'
do
    if grep -F "$live_runtime_path" "$3" >/dev/null 2>&1; then
        printf 'candidate parser received live runtime path: %s\n' \
            "$live_runtime_path" >&2
        exit 3
    fi
done
exit 0
EOF
chmod 0755 "$TEST_ROOT/monit-bin/monit"
PATH="$TEST_ROOT/monit-bin:$PATH" \
    "$SETUP" --output "$TEST_ROOT/runtime-safe-rendered"

install -d "$TEST_ROOT/control-bin"
cat > "$TEST_ROOT/control-bin/monit" <<'EOF'
#!/usr/bin/env sh
attempts=$(cat "$CONTROL_ATTEMPTS" 2>/dev/null || printf '0')
attempts=$((attempts + 1))
printf '%s\n' "$attempts" > "$CONTROL_ATTEMPTS"
[ "$attempts" -ge "${CONTROL_SUCCEEDS_ON:-999}" ]
EOF
cat > "$TEST_ROOT/control-bin/sleep" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
chmod 0755 "$TEST_ROOT/control-bin/monit" "$TEST_ROOT/control-bin/sleep"
wait_for_control_plane_function=$(extract_function wait_for_control_plane "$SETUP")
[ -n "$wait_for_control_plane_function" ] \
    || fail 'cannot extract Monit control-plane readiness function'
CONTROL_ATTEMPTS="$TEST_ROOT/control-attempts" CONTROL_SUCCEEDS_ON=3 \
    MONIT_MAIN=/test/monitrc PATH="$TEST_ROOT/control-bin:$PATH" \
    sh -c "$wait_for_control_plane_function
        wait_for_control_plane" \
    || fail 'control-plane readiness wait rejected eventual success'
[ "$(cat "$TEST_ROOT/control-attempts")" = 3 ] \
    || fail 'control-plane readiness wait did not retry to success'
rm -f "$TEST_ROOT/control-attempts"
if CONTROL_ATTEMPTS="$TEST_ROOT/control-attempts" CONTROL_SUCCEEDS_ON=999 \
    MONIT_MAIN=/test/monitrc PATH="$TEST_ROOT/control-bin:$PATH" \
    sh -c "$wait_for_control_plane_function
        wait_for_control_plane"
then
    fail 'control-plane readiness wait did not time out'
fi
[ "$(cat "$TEST_ROOT/control-attempts")" = 75 ] \
    || fail 'control-plane readiness wait used the wrong timeout bound'

rollback_target=$TEST_ROOT/rollback-target
rollback_relative_path=${rollback_target#/}
rollback_root=$TEST_ROOT/rollback
rollback_file=$rollback_root/files/$rollback_relative_path
rollback_present=$rollback_root/present/$rollback_relative_path
install -d "${rollback_file%/*}" "${rollback_present%/*}"
printf '%s\n' 'package original' > "$rollback_file"
chmod 0600 "$rollback_file"
touch -t 202001020304 "$rollback_file"
: > "$rollback_present"
printf '%s\n' 'managed replacement' > "$rollback_target"
chmod 0644 "$rollback_target"
restore_target_function=$(extract_function restore_target "$SETUP")
[ -n "$restore_target_function" ] \
    || fail 'cannot extract Monit rollback restore function'
# Production rollback uses GNU cp to preserve SELinux contexts and ACLs too.
# Translate its SELinux-specific options for this portable metadata fixture;
# full context/xattr acceptance still requires an enforcing target host.
install -d "$TEST_ROOT/metadata-bin"
cat > "$TEST_ROOT/metadata-bin/cp" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = --preserve=mode,ownership,timestamps,xattr,context ]; then
    shift
    exec /bin/cp -p "$@"
fi
exec /bin/cp "$@"
EOF
chmod 0755 "$TEST_ROOT/metadata-bin/cp"
BACKUP_DIRECTORY=$rollback_root PATH="$TEST_ROOT/metadata-bin:$PATH" sh -c "$restore_target_function
    restore_target '$rollback_target'"
cmp -s "$rollback_file" "$rollback_target" \
    || fail 'Monit rollback did not restore exact file content'
assert_mode "$rollback_target" 600
[ "$(file_mtime "$rollback_target")" = "$(file_mtime "$rollback_file")" ] \
    || fail 'Monit rollback did not preserve the original modification time'
# Atomic restore must sever a live hardlink rather than overwriting its alias.
ln "$rollback_target" "$TEST_ROOT/rollback-alias"
printf '%s\n' 'later mutation' > "$rollback_target"
BACKUP_DIRECTORY=$rollback_root PATH="$TEST_ROOT/metadata-bin:$PATH" sh -c "$restore_target_function
    restore_target '$rollback_target'"
assert_contains "$TEST_ROOT/rollback-alias" 'later mutation'
assert_contains "$rollback_target" 'package original'

install -d "$TEST_ROOT/fragments-a" "$TEST_ROOT/fragments-b"
printf '%s\n' 'check process example with pidfile /run/example.pid' \
    > "$TEST_ROOT/fragments-a/70-example.conf"
printf '%s\n' 'check host example with address 127.0.0.1' \
    > "$TEST_ROOT/fragments-b/70-example.conf"
"$SETUP" --output "$TEST_ROOT/fragment-render" \
    --fragment "$TEST_ROOT/fragments-a/70-example.conf"
cmp -s "$TEST_ROOT/fragments-a/70-example.conf" \
    "$TEST_ROOT/fragment-render/etc/monit.d/70-example.conf" \
    || fail 'requested deployment fragment was not copied exactly'
assert_mode "$TEST_ROOT/fragment-render/etc/monit.d/70-example.conf" 600

expect_failure 'duplicate fragment basename' \
    "$SETUP" --plan \
    --fragment "$TEST_ROOT/fragments-a/70-example.conf" \
    --fragment "$TEST_ROOT/fragments-b/70-example.conf"
expect_failure 'fragment name is reserved' \
    "$SETUP" --plan --fragment "$MONIT_DIRECTORY/conf.d/10-system.conf"

# Whitespace anywhere in a fragment path is rejected as a whole string before
# the newline-delimited list is word-split. A newline inside a directory
# component is the case a line-oriented check lets through.
newline_directory="$TEST_ROOT/frag$(printf '\nments')"
install -d "$newline_directory"
cp "$TEST_ROOT/fragments-a/70-example.conf" "$newline_directory/70-example.conf"
expect_failure 'fragment paths must not contain whitespace' \
    "$SETUP" --plan --fragment "$newline_directory/70-example.conf"

# The include scan must read the fragment itself, never standard input: awk
# treats a relative operand shaped like NAME=value as a variable assignment.
install -d "$TEST_ROOT/dir=evil"
printf '%s\n' 'include /etc/monit.d/*.conf' > "$TEST_ROOT/dir=evil/70-nested.conf"
expect_failure 'nested include directives are unsupported' \
    sh -c "cd '$TEST_ROOT' && exec '$SETUP' --plan --fragment 'dir=evil/70-nested.conf' </dev/null"

# Name validation runs before any content is inspected.
printf '%s\n' 'include /etc/monit.d/*.conf' > "$TEST_ROOT/fragments-a/70-example.conf.conf"
expect_failure 'invalid fragment basename' \
    "$SETUP" --plan --fragment "$TEST_ROOT/fragments-a/70-example.conf.conf"
expect_failure 'output path already exists' \
    "$SETUP" --output "$TEST_ROOT/rendered"
expect_failure '--replace-main is not valid with --output' \
    "$SETUP" --output "$TEST_ROOT/replace-render" --replace-main

"$SETUP" --plan --replace-main \
    --fragment "$TEST_ROOT/fragments-a/70-example.conf" \
    > "$TEST_ROOT/setup.plan"
assert_contains "$TEST_ROOT/setup.plan" \
    'explicitly replace a modified unmanaged /etc/monitrc'
assert_contains "$TEST_ROOT/setup.plan" \
    'preserve existing /etc/monit.d/*.conf fragments'
assert_contains "$TEST_ROOT/setup.plan" \
    'restore default SELinux labels and reject any Monit AVC denial'

assert_contains "$MONIT_DIRECTORY/conf.d/10-system.conf" \
    'if memory usage > 90% for 5 cycles then alert'
assert_contains "$MONIT_DIRECTORY/conf.d/10-system.conf" \
    'if space usage > 85% for 3 cycles then alert'
if grep -E 'then (start|stop|restart|exec)' \
    "$MONIT_DIRECTORY/conf.d/10-system.conf" >/dev/null 2>&1
then
    fail 'generic Monit checks contain a mutating action'
fi

assert_contains "$MONIT_DIRECTORY/logrotate/monit" 'create 0600 root root'
assert_contains "$MONIT_DIRECTORY/logrotate/monit" \
    'systemctl kill --kill-who=main --signal=SIGHUP monit.service'
if grep -F 'copytruncate' "$MONIT_DIRECTORY/logrotate/monit" >/dev/null 2>&1; then
    fail 'Monit logrotate policy uses copytruncate instead of signal reopen'
fi

# shellcheck disable=SC2016
for systemd_line in \
    'UMask=0077' \
    'RuntimeDirectory=monit' \
    'StateDirectory=monit' \
    'LogsDirectory=monit' \
    'Restart=on-failure' \
    'ExecReload=/bin/kill -HUP $MAINPID'
do
    assert_contains "$MONIT_DIRECTORY/systemd/monit.service.conf" "$systemd_line"
done

# shellcheck disable=SC2016
assert_contains "$SETUP" 'refusing modified unmanaged $MONIT_MAIN'
# shellcheck disable=SC2016
assert_contains "$SETUP" 'monit -t -c "$MONIT_MAIN"'
assert_contains "$SETUP" 'systemctl reload monit.service'
assert_contains "$VERIFIER" 'ausearch -m AVC,USER_AVC -ts boot -c monit --raw'
assert_contains "$VERIFIER" 'must bind only to 127.0.0.1:2812'
assert_contains "$VERSION_LIBRARY" 'MONIT_SUPPORTED_VERSION=5.35.2'
assert_contains "$VERSION_LIBRARY" 'MONIT_PREFERRED_VERSION=6.0.0'
assert_contains "$VERIFIER" \
    'is the supported compatibility release; prefer'

install -d "$TEST_ROOT/security-bin"
cat > "$TEST_ROOT/security-bin/stat" <<'EOF'
#!/usr/bin/env sh
if [ "$1" = -c ] && [ "$2" = '%u:%g:%a:%h' ]; then
    if [ "$(uname -s)" = Darwin ]; then
        file_modes=$(/usr/bin/stat -f '%Lp:%l' "$3") || exit 1
    else
        file_modes=$(/usr/bin/stat -c '%a:%h' "$3") || exit 1
    fi
    printf '%s:%s\n' "${MONIT_TEST_OWNER:-0:0}" "$file_modes"
    exit 0
fi
if [ "$1" = -c ] && [ "$2" = '%u:%g:%h' ]; then
    if [ "$(uname -s)" = Darwin ]; then
        file_links=$(/usr/bin/stat -f '%l' "$3") || exit 1
    else
        file_links=$(/usr/bin/stat -c '%h' "$3") || exit 1
    fi
    printf '%s:%s\n' "${MONIT_TEST_OWNER:-0:0}" "$file_links"
    exit 0
fi
if [ "$1" = -c ] && [ "$2" = '%a' ] && [ "$(uname -s)" = Darwin ]; then
    exec /usr/bin/stat -f '%Lp' "$3"
fi
exec /usr/bin/stat "$@"
EOF
cat > "$TEST_ROOT/security-bin/getfacl" <<'EOF'
#!/usr/bin/env sh
printf 'user::rw-\ngroup::---\nother::---\n'
case "${MONIT_TEST_ACL:-basic}" in
    basic) ;;
    named) printf 'user:1000:rw-\nmask::rw-\n' ;;
    default) printf 'default:user::rwx\n' ;;
    unavailable) exit 1 ;;
esac
EOF
chmod 0755 "$TEST_ROOT/security-bin/stat" "$TEST_ROOT/security-bin/getfacl"
security_fixture=$TEST_ROOT/private-fragment.conf
printf 'check file sample with path /var/lib/include/data\n' > "$security_fixture"
chmod 0600 "$security_fixture"
security_check=". '$SECURITY_LIBRARY'
    fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
    monit_require_private_fragment '$security_fixture'"
PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
chmod 0660 "$security_fixture"
expect_failure 'root:root mode 0600 with one link' \
    env PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
chmod 0600 "$security_fixture"
expect_failure 'root:root mode 0600 with one link' \
    env MONIT_TEST_OWNER=1000:0 PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
ln "$security_fixture" "$TEST_ROOT/private-fragment-alias"
expect_failure 'root:root mode 0600 with one link' \
    env PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
rm -f "$TEST_ROOT/private-fragment-alias"
for rejected_acl in named default; do
    expect_failure 'extended or default ACL requires explicit remediation' \
        env MONIT_TEST_ACL="$rejected_acl" PATH="$TEST_ROOT/security-bin:$PATH" \
        sh -c "$security_check"
done
expect_failure 'cannot inspect ACL' \
    env MONIT_TEST_ACL=unavailable PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
mv "$security_fixture" "$security_fixture.real"
ln -s "$security_fixture.real" "$security_fixture"
expect_failure 'non-symbolic regular file' \
    env PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
rm -f "$security_fixture"
mv "$security_fixture.real" "$security_fixture"

adoption_check=". '$SECURITY_LIBRARY'
    fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
    monit_require_adoption_source '$security_fixture'"
for adoptable_mode in 0644 0640 0600; do
    chmod "$adoptable_mode" "$security_fixture"
    PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$adoption_check"
done
chmod 0664 "$security_fixture"
expect_failure 'must not be writable by group or other' \
    env PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$adoption_check"
chmod 0644 "$security_fixture"
expect_failure 'root:root with one link' \
    env MONIT_TEST_OWNER=1000:0 PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$adoption_check"
ln "$security_fixture" "$TEST_ROOT/adoption-alias"
expect_failure 'root:root with one link' \
    env PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$adoption_check"
rm -f "$TEST_ROOT/adoption-alias"

# A trusted 0644 live fragment is rejected when merely preserved, but can be
# explicitly adopted by its own path without first altering the live tree.
install -d "$TEST_ROOT/adoption-live" "$TEST_ROOT/adoption-stage"
cp "$security_fixture" "$TEST_ROOT/adoption-live/50-private.conf"
chmod 0644 "$TEST_ROOT/adoption-live/50-private.conf"
existing_copy_function=$(extract_function copy_existing_fragments "$SETUP")
requested_copy_function=$(extract_function copy_requested_fragments "$SETUP")
copy_check="set -eu
    . '$SECURITY_LIBRARY'
    fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
    $existing_copy_function
    $requested_copy_function
    copy_existing_fragments '$TEST_ROOT/adoption-stage'
    copy_requested_fragments '$TEST_ROOT/adoption-stage'"
expect_failure 'root:root mode 0600 with one link' \
    env MONIT_FRAGMENT_DIRECTORY="$TEST_ROOT/adoption-live" FRAGMENT_NAMES='' \
    FRAGMENT_SOURCES='' PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$copy_check"
MONIT_FRAGMENT_DIRECTORY="$TEST_ROOT/adoption-live" FRAGMENT_NAMES=50-private.conf \
    FRAGMENT_SOURCES="$TEST_ROOT/adoption-live/50-private.conf" \
    PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$copy_check"
cmp -s "$TEST_ROOT/adoption-live/50-private.conf" "$TEST_ROOT/adoption-stage/50-private.conf" \
    || fail 'explicit fragment adoption changed its reviewed contents'
assert_mode "$TEST_ROOT/adoption-live/50-private.conf" 644
assert_mode "$TEST_ROOT/adoption-stage/50-private.conf" 600
chmod 0600 "$security_fixture"

cat > "$security_fixture" <<'EOF'
# include /not/an/include.conf
check file "include" with path "/var/lib/include/data"
    if content = "include /also/not/a/directive" then alert
EOF
PATH="$TEST_ROOT/security-bin:$PATH" sh -c "$security_check"
for nested_directive in \
    'include /private/external.conf' \
    'check filesystem root with path / InClUdE "/private/external.conf"' \
    'include"/private/external.conf"'
do
    printf '%s\n' "$nested_directive" > "$security_fixture"
    expect_failure 'nested include directives are unsupported' \
        "$SETUP" --plan --fragment "$security_fixture"
done

# Global policy comparison rejects extra includes before trusting Monit syntax.
control_validation=$(extract_function verify_control_file "$VERIFIER")
line_validation=$(extract_function require_exact_line "$VERIFIER")
control_check="fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
    require_regular_file_identity() { :; }
    $line_validation
    $control_validation
    verify_control_file"
MONIT_MAIN="$TEST_ROOT/rendered/etc/monitrc" \
    MAIN_TEMPLATE="$MONIT_DIRECTORY/templates/monitrc.in" \
    MANAGED_MARKER='Managed by mikinho/config monit/setup.' \
    PACKAGE_BINARY=/usr/bin/true sh -c "$control_check"
cp "$TEST_ROOT/rendered/etc/monitrc" "$TEST_ROOT/canonical-monitrc"
printf '\ninclude /unreviewed/external.conf\n' >> "$TEST_ROOT/rendered/etc/monitrc"
expect_failure 'differs from the managed global policy' \
    env MONIT_MAIN="$TEST_ROOT/rendered/etc/monitrc" \
    MAIN_TEMPLATE="$MONIT_DIRECTORY/templates/monitrc.in" \
    MANAGED_MARKER='Managed by mikinho/config monit/setup.' \
    PACKAGE_BINARY=/usr/bin/true sh -c "$control_check"
awk '/^    allow admin:/ { $0 = $0 " include /unreviewed/external.conf" }
    { print }' "$TEST_ROOT/canonical-monitrc" > "$TEST_ROOT/rendered/etc/monitrc"
expect_failure 'differs from the managed global policy' \
    env MONIT_MAIN="$TEST_ROOT/rendered/etc/monitrc" \
    MAIN_TEMPLATE="$MONIT_DIRECTORY/templates/monitrc.in" \
    MANAGED_MARKER='Managed by mikinho/config monit/setup.' \
    PACKAGE_BINARY=/usr/bin/true sh -c "$control_check"

# Retained backup storage is deliberately separate from disposable candidates.
cleanup_function=$(extract_function cleanup "$SETUP")
install -d "$TEST_ROOT/cleanup-temporary" "$TEST_ROOT/retained-transaction"
printf '%s\n' 'recovery original' > "$TEST_ROOT/retained-transaction/original"
TEMPORARY_DIRECTORY="$TEST_ROOT/cleanup-temporary" \
    BACKUP_DIRECTORY="$TEST_ROOT/retained-transaction" \
    CHANGES_STARTED=yes TRANSACTION_COMMITTED=yes PENDING_STAGE='' \
    sh -c "$cleanup_function
        cleanup 0" > "$TEST_ROOT/cleanup.stdout" 2> "$TEST_ROOT/cleanup.stderr"
[ ! -e "$TEST_ROOT/cleanup-temporary" ] || fail 'cleanup retained disposable candidates'
assert_contains "$TEST_ROOT/retained-transaction/original" 'recovery original'
assert_contains "$TEST_ROOT/cleanup.stderr" 'Retained root-only Monit transaction:'

# Rollback service handling. The mocks record every systemctl invocation so
# each branch can prove which service commands ran and, as importantly, which
# did not. MONIT_TEST_RESTORE_FAIL, MONIT_TEST_RELOAD_FAIL, and
# MONIT_TEST_CONFIG_INVALID select the failing step.
rollback_function=$(extract_function rollback_transaction "$SETUP")
rollback_log=$TEST_ROOT/rollback-systemctl.log
rollback_check="PROGRAM_NAME=monit-test
    restore_target() { [ \"\${MONIT_TEST_RESTORE_FAIL:-no}\" = no ]; }
    monit() { [ \"\${MONIT_TEST_CONFIG_INVALID:-no}\" = no ]; }
    systemctl() {
        printf '%s\\n' \"\$*\" >> '$rollback_log'
        case \"\$1\" in
            daemon-reload) [ \"\${MONIT_TEST_RELOAD_FAIL:-no}\" = no ] ;;
            *) return 0 ;;
        esac
    }
    $rollback_function
    rollback_transaction"
run_rollback() {
    : > "$rollback_log"
    env BACKUP_DIRECTORY="$TEST_ROOT/retained-transaction" BACKED_UP_TARGETS=/test/target \
        MONIT_MAIN=/test/monitrc SERVICE_WAS_ENABLED=yes "$@" sh -c "$rollback_check"
}
assert_service_command() {
    grep -x -- "$1 monit.service" "$rollback_log" >/dev/null \
        || fail "rollback did not run: systemctl $1 monit.service"
}
refuse_service_command() {
    if grep -x -- "$1 monit.service" "$rollback_log" >/dev/null; then
        fail "rollback must not run: systemctl $1 monit.service"
    fi
}

# A failed restoration is reported, stops the daemon so it cannot consume a
# partially restored tree, and retains the original for operator repair.
expect_failure 'rollback incomplete' run_rollback \
    MONIT_TEST_RESTORE_FAIL=yes SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=no
assert_contains "$TEST_ROOT/retained-transaction/status" rollback-incomplete
assert_contains "$TEST_ROOT/retained-transaction/original" 'recovery original'
assert_service_command stop
refuse_service_command reload
refuse_service_command restart

# A failed daemon-reload after a complete file restoration is reported without
# withdrawing monitoring: the restored files are authoritative, so the prior
# service state is still re-established and the operator finishes the reload.
expect_failure 'daemon-reload failed' run_rollback \
    MONIT_TEST_RELOAD_FAIL=yes SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=no
assert_contains "$TEST_ROOT/expected.stderr" 'rollback incomplete'
assert_contains "$TEST_ROOT/retained-transaction/status" rollback-incomplete
assert_service_command reload
refuse_service_command stop
expect_failure 'daemon-reload failed' run_rollback \
    MONIT_TEST_RELOAD_FAIL=yes SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=yes
assert_service_command restart
refuse_service_command stop
# An inactive prior state is still restored by stopping.
expect_failure 'daemon-reload failed' run_rollback \
    MONIT_TEST_RELOAD_FAIL=yes SERVICE_WAS_ACTIVE=no SERVICE_RESTART_REQUIRED=no
assert_service_command stop
refuse_service_command reload

# Restored files that no longer validate are neither relaunched nor stopped.
expect_failure 'restored Monit configuration failed validation' run_rollback \
    MONIT_TEST_CONFIG_INVALID=yes SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=yes
assert_contains "$TEST_ROOT/retained-transaction/status" rollback-incomplete
refuse_service_command stop
refuse_service_command restart
refuse_service_command reload

# A clean rollback re-establishes the prior state and records success.
run_rollback SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=yes > "$TEST_ROOT/rollback.stdout" 2>&1
assert_contains "$TEST_ROOT/retained-transaction/status" rolled-back
grep -x daemon-reload "$rollback_log" >/dev/null || fail 'rollback did not reload the manager'
assert_service_command restart
assert_service_command enable
refuse_service_command stop

# Activate an existing daemon only as required by execution-policy changes.
selection_function=$(extract_function select_activation_policy "$SETUP")
activation_function=$(extract_function activate_service "$SETUP")
activation_check="fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
    systemctl() {
        if [ \"\$1\" = show ]; then printf '123\\n';
        else printf '%s\\n' \"\$*\"; fi
    }
    monit_read_process_umask() { printf '%s\\n' \"\$MONIT_TEST_UMASK\"; }
    $selection_function
    $activation_function
    select_activation_policy
    activate_service"
cp "$MONIT_DIRECTORY/systemd/monit.service.conf" "$TEST_ROOT/current-systemd.conf"
SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=no MONIT_TEST_UMASK=0077 \
    SYSTEMD_SOURCE="$MONIT_DIRECTORY/systemd/monit.service.conf" \
    SYSTEMD_TARGET="$TEST_ROOT/current-systemd.conf" sh -c "$activation_check" \
    > "$TEST_ROOT/reload-activation"
assert_contains "$TEST_ROOT/reload-activation" 'reload monit.service'
if grep -F 'restart monit.service' "$TEST_ROOT/reload-activation" >/dev/null; then
    fail 'configuration-only adoption restarted Monit'
fi
SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=no MONIT_TEST_UMASK=0022 \
    SYSTEMD_SOURCE="$MONIT_DIRECTORY/systemd/monit.service.conf" \
    SYSTEMD_TARGET="$TEST_ROOT/current-systemd.conf" sh -c "$activation_check" \
    > "$TEST_ROOT/umask-activation"
assert_contains "$TEST_ROOT/umask-activation" 'restart monit.service'
printf '\nRestartSec=10s\n' >> "$TEST_ROOT/current-systemd.conf"
SERVICE_WAS_ACTIVE=yes SERVICE_RESTART_REQUIRED=no MONIT_TEST_UMASK=0077 \
    SYSTEMD_SOURCE="$MONIT_DIRECTORY/systemd/monit.service.conf" \
    SYSTEMD_TARGET="$TEST_ROOT/current-systemd.conf" sh -c "$activation_check" \
    > "$TEST_ROOT/policy-activation"
assert_contains "$TEST_ROOT/policy-activation" 'restart monit.service'
SERVICE_WAS_ACTIVE=no SERVICE_RESTART_REQUIRED=no sh -c "$activation_check" \
    > "$TEST_ROOT/fresh-activation"
assert_contains "$TEST_ROOT/fresh-activation" 'enable --now monit.service'

# Configured systemd UMask alone must not conceal a stale running process mask.
systemd_verification=$(extract_function verify_systemd_policy "$VERIFIER")
systemd_check="fail() { printf '%s\\n' \"\$*\" >&2; exit 1; }
    systemctl() {
        [ \"\$1\" = show ] || return 0
        case \"\$3\" in
            --property=RuntimeDirectory|--property=StateDirectory|--property=LogsDirectory)
                printf 'monit\\n' ;;
            --property=StateDirectoryMode|--property=LogsDirectoryMode) printf '0700\\n' ;;
            --property=RuntimeDirectoryMode) printf '0750\\n' ;;
            --property=UMask) printf '0077\\n' ;;
            --property=MainPID) printf '123\\n' ;;
            --property=Restart) printf 'on-failure\\n' ;;
            *) return 1 ;;
        esac
    }
    monit_read_process_umask() { printf '%s\\n' \"\$MONIT_TEST_UMASK\"; }
    $systemd_verification
    verify_systemd_policy"
MONIT_TEST_UMASK=0077 sh -c "$systemd_check"
expect_failure 'running Monit process UMask is not 0077' \
    env MONIT_TEST_UMASK=0022 sh -c "$systemd_check"

python3 "$MONIT_DIRECTORY/build-operations-standard-pdf.py" --check >/dev/null

python3 "$SCRIPT_DIRECTORY/client-neutrality.py" monit

