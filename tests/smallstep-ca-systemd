#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

# Exercise the component helpers against representative systemctl output,
# including permissive drop-ins. This test never contacts a service manager.
set -eu
set -f
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/config-unit-policy-tests.XXXXXX")
trap 'rm -rf -- "$TEST_ROOT"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() { printf '%s\n' "$*" >&2; exit 1; }
# shellcheck disable=SC1091
. "$REPOSITORY_ROOT/smallstep-ca/lib/systemd.sh"
# shellcheck disable=SC1091
. "$REPOSITORY_ROOT/redis/lib/common.sh"
printf '10.20.0.0/16\n' > "$TEST_ROOT/networks"
printf 'IPAddressAllow=localhost\nIPAddressAllow=10.20.30.21/32\n' > "$TEST_ROOT/redis.conf"

MOCK_ALLOW='127.0.0.0/8 ::1/128 10.20.0.0/16'
MOCK_DENY='0.0.0.0/0 ::/0'
MOCK_UMASK=0077
MOCK_PROTECT_SYSTEM=strict
MOCK_PARENT_ALLOW=
MOCK_SLICE=system.slice
systemctl() {
    case "$*" in
        *--property=Slice*) printf '%s\n' "$MOCK_SLICE" ;;
        'show --property=IPAddressAllow --value -- system.slice' | 'show --property=IPAddressAllow --value -- -.slice')
            printf '%s\n' "$MOCK_PARENT_ALLOW" ;;
        *--property=IPAddressAllow*) printf '%s\n' "$MOCK_ALLOW" ;;
        *--property=IPAddressDeny*) printf '%s\n' "$MOCK_DENY" ;;
        'show redis.service --property=UMask --value') printf '%s\n' "$MOCK_UMASK" ;;
        *)
            printf 'UMask=%s\nProtectSystem=%s\n' "$MOCK_UMASK" "$MOCK_PROTECT_SYSTEM"
            printf '%s\n' NoNewPrivileges=yes ProtectHome=yes PrivateTmp=yes PrivateDevices=yes \
                ReadWritePaths=/var/lib/step-ca ReadOnlyPaths=/etc/step-ca \
                CapabilityBoundingSet= AmbientCapabilities= MemoryDenyWriteExecute=yes
            ;;
    esac
}

verify_step_fixture() ( step_ca_verify_effective_unit "$TEST_ROOT/networks"; )
verify_redis_fixture() ( redis_verify_effective_systemd_policy "$TEST_ROOT/redis.conf"; )
expect_failure() {
    expected=$1
    shift
    if "$@" > "$TEST_ROOT/stdout" 2> "$TEST_ROOT/stderr"; then fail "unsafe effective unit unexpectedly passed"; fi
    grep -F "$expected" "$TEST_ROOT/stderr" >/dev/null || fail "unexpected unit-policy failure"
}

verify_step_fixture
MOCK_PARENT_ALLOW=any
expect_failure 'parent slices must not broaden' verify_step_fixture
MOCK_PARENT_ALLOW=
MOCK_SLICE=unreviewed.slice
expect_failure 'reviewed system.slice hierarchy' verify_step_fixture
MOCK_SLICE=system.slice
MOCK_ALLOW='localhost 10.20.0.0/17 10.20.128.0/17 10.20.1.2/32'
verify_step_fixture
MOCK_ALLOW='any'
expect_failure 'allowlist differs' verify_step_fixture
MOCK_ALLOW='localhost 10.20.0.0/15'
expect_failure 'allowlist differs' verify_step_fixture
MOCK_ALLOW='localhost 10.20.0.0/16'
MOCK_UMASK=0022
expect_failure 'UMask=0077' verify_step_fixture
MOCK_UMASK=0077
MOCK_PROTECT_SYSTEM=no
expect_failure 'ProtectSystem=strict' verify_step_fixture
MOCK_PROTECT_SYSTEM=strict
MOCK_DENY='0.0.0.0/0'
expect_failure 'default-deny IPv4 and IPv6' verify_step_fixture
MOCK_DENY=any
MOCK_ALLOW='localhost 10.20.30.21'
verify_redis_fixture
MOCK_PARENT_ALLOW=any
expect_failure 'parent slices must not broaden' verify_redis_fixture
MOCK_PARENT_ALLOW=
MOCK_ALLOW='localhost 10.20.30.21/32 0.0.0.0/0'
expect_failure 'allowlist differs' verify_redis_fixture
MOCK_ALLOW=''
expect_failure 'allowlist differs' verify_redis_fixture
MOCK_ALLOW='localhost 10.20.30.21/32'
MOCK_UMASK=0000
expect_failure 'UMask=0077' verify_redis_fixture
printf 'Validated effective CA/Redis masks, normalized network sets, and weakened-unit rejection.\n'
