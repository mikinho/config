#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
SCAN_LIST=$(mktemp "${TMPDIR:-/tmp}/config-script-conventions.XXXXXX")
AUTHOR_LINE='Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho'

cleanup() {
    if [ -f "$SCAN_LIST" ]; then
        rm -f -- "$SCAN_LIST"
    fi
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

read_line() {
    line_number=$1
    checked_file=$2
    sed -n "${line_number}p" "$checked_file"
}

require_terminating_signal_traps() {
    # A trap action that only cleans up leaves the shell running after the
    # signal: a SIGTERM delivered to the shell alone (timeout, KillMode=mixed)
    # removes the working files and then continues into later steps, and a
    # terminal interrupt runs cleanup twice. Cleanup belongs on EXIT; HUP, INT,
    # and TERM must exit with the conventional 128+signal status so EXIT fires
    # once and the caller sees the interruption. Resets (`trap -`) are allowed.
    if LC_ALL=C grep -nE '^[[:space:]]*trap[[:space:]].*[[:space:]](HUP|INT|TERM)([[:space:]]|$)' "$1" \
        | LC_ALL=C grep -vE "^[0-9]+:[[:space:]]*trap[[:space:]]+(-|'exit [0-9]+')[[:space:]]" >/dev/null
    then
        fail "signal trap must exit after cleanup; trap cleanup on EXIT and 'exit 128+N' on HUP/INT/TERM: $2"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

git -C "$REPOSITORY_ROOT" ls-files --cached --others --exclude-standard \
    > "$SCAN_LIST"

while IFS= read -r relative_file; do
    checked_file=$REPOSITORY_ROOT/$relative_file
    [ -f "$checked_file" ] || continue

    if LC_ALL=C grep -E 'tests/[[:alnum:]_-]+\.sh([^[:alnum:]_.-]|$)' \
        "$checked_file" >/dev/null 2>&1; then
        fail "file references a test command with a .sh extension: $relative_file"
    fi

    case $relative_file in
        *.sh)
            [ ! -x "$checked_file" ] \
                || fail "executable shell command retains a .sh extension: $relative_file"
            ;;
    esac

    first_line=$(read_line 1 "$checked_file")
    case $first_line in
        '#!'*)
            case $first_line in
                '#!/usr/bin/env '*) ;;
                *) fail "script does not use a /usr/bin/env shebang: $relative_file" ;;
            esac

            case $first_line in
                '#!/usr/bin/env node') comment_marker=// ;;
                *) comment_marker='#' ;;
            esac
            case $first_line in
                '#!/usr/bin/env sh' | '#!/usr/bin/env bash')
                    require_terminating_signal_traps "$checked_file" "$relative_file"
                    ;;
            esac

            [ -z "$(read_line 2 "$checked_file")" ] \
                || fail "author block lacks a blank line above it: $relative_file"
            [ "$(read_line 3 "$checked_file")" = "$comment_marker" ] \
                || fail "author block has an invalid opening marker: $relative_file"
            [ "$(read_line 4 "$checked_file")" = "$comment_marker $AUTHOR_LINE" ] \
                || fail "author block is missing or inconsistent: $relative_file"
            [ "$(read_line 5 "$checked_file")" = "$comment_marker" ] \
                || fail "author block has an invalid closing marker: $relative_file"
            [ -z "$(read_line 6 "$checked_file")" ] \
                || fail "author block lacks a blank line below it: $relative_file"
            ;;
    esac
done < "$SCAN_LIST"

printf 'Validated extensionless executable shell commands, env shebangs, author blocks, and terminating signal traps.\n'
