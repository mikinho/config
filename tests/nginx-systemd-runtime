#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

# Real Linux/systemd acceptance for the startup checker's execution context.
# Run only on an explicitly disposable CI host, never on a deployment host.
set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
UNIT_SOURCE=$REPOSITORY_ROOT/systemd/system/nginx.service
VERIFIER_SOURCE=$REPOSITORY_ROOT/nginx/verify-runtime
QUIC_DROPIN_SOURCE=$REPOSITORY_ROOT/nginx/templates/quic-bpf.service.conf
TEST_DIRECTORY=
UNIT_NAME=
UNIT_PATH=
UNIT_INSTALLED=no
DRAIN_CLIENT_PID=
DRAIN_MASTER_PID=
DRAIN_OLD_WORKERS=

usage() {
    cat <<EOF
Usage: $PROGRAM_NAME --check
       sudo $PROGRAM_NAME --disposable-ci-host

--check validates fixture sources without changing the host. Execution requires
GITHUB_ACTIONS=true, root, Linux with systemd as PID 1, /usr/sbin/nginx, and an
existing nginx user/group. It creates and cleans up one uniquely named service,
its managed directories, and a private fixture tree under /run. No production
unit is changed. This gate proves Linux/systemd behavior, not EL9 SELinux policy.
EOF
}

fail() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 1; }

cleanup() {
    stop_drain_client
    if [ "$UNIT_INSTALLED" = yes ]; then
        systemctl stop "$UNIT_NAME" >/dev/null 2>&1 || :
        systemctl clean --what=runtime,state,logs "$UNIT_NAME" >/dev/null 2>&1 || :
        systemctl reset-failed "$UNIT_NAME" >/dev/null 2>&1 || :
        rm -f -- "$UNIT_PATH"
        systemctl daemon-reload >/dev/null 2>&1 || :
    fi
    [ -z "$TEST_DIRECTORY" ] || rm -rf -- "$TEST_DIRECTORY"
}

diagnostics() {
    systemctl --no-pager --full status "$UNIT_NAME" >&2 || :
    journalctl --no-pager -u "$UNIT_NAME" -o cat >&2 || :
}

assert_contains() {
    grep -F -- "$2" "$1" >/dev/null || fail "$1 is missing: $2"
}

journal_snapshot() {
    # Stream output from Exec* commands reaches journald asynchronously; flush
    # before reading so an assertion never races the entry it looks for.
    journalctl --sync
    journalctl --no-pager -u "$UNIT_NAME" -o cat > "$1"
}

need_daemon_reload() {
    systemctl show "$UNIT_NAME" --property=NeedDaemonReload --value 2>/dev/null
}

stop_drain_client() {
    if [ -n "$DRAIN_CLIENT_PID" ]; then
        kill -TERM "$DRAIN_CLIENT_PID" 2>/dev/null || :
        wait "$DRAIN_CLIENT_PID" 2>/dev/null || :
        DRAIN_CLIENT_PID=
    fi
}

start_drain_client() {
    DRAIN_MASTER_PID=$(systemctl show "$UNIT_NAME" --property=MainPID --value)
    DRAIN_OLD_WORKERS=$(cat "/proc/$DRAIN_MASTER_PID/task/$DRAIN_MASTER_PID/children")
    [ -n "$DRAIN_OLD_WORKERS" ] || fail 'drain fixture has no original workers'
    : > "$TEST_DIRECTORY/drain.body"
    curl --fail --silent --show-error --no-buffer --connect-timeout 2 --max-time 20 \
        --unix-socket "/run/$fixture_name/http.sock" \
        --dump-header "$TEST_DIRECTORY/drain.headers" \
        --output "$TEST_DIRECTORY/drain.body" http://localhost/slow.txt \
        2> "$TEST_DIRECTORY/drain.stderr" &
    DRAIN_CLIENT_PID=$!
    drain_attempt=0
    until [ -s "$TEST_DIRECTORY/drain.body" ]; do
        kill -0 "$DRAIN_CLIENT_PID" 2>/dev/null || {
            cat "$TEST_DIRECTORY/drain.stderr" >&2
            fail 'slow drain request exited before receiving its response body'
        }
        drain_attempt=$((drain_attempt + 1))
        [ "$drain_attempt" -lt 50 ] || fail 'slow drain response did not start'
        sleep 0.1
    done
    assert_contains "$TEST_DIRECTORY/drain.headers" '200 OK'
}

read_drain_children() {
    drain_children=$(cat "/proc/$DRAIN_MASTER_PID/task/$DRAIN_MASTER_PID/children") \
        || fail 'drain fixture master exited unexpectedly'
}

old_generation_present() {
    read_drain_children
    for drain_worker in $DRAIN_OLD_WORKERS; do
        case " $drain_children " in *" $drain_worker "*) return 0 ;; esac
    done
    return 1
}

wait_for_replacement_workers() {
    drain_attempt=0
    while :; do
        read_drain_children
        replacement_count=0
        for drain_worker in $drain_children; do
            case " $DRAIN_OLD_WORKERS " in *" $drain_worker "*) continue ;; esac
            drain_title=$(tr '\000' ' ' < "/proc/$drain_worker/cmdline" | sed 's/ *$//')
            [ "$drain_title" != 'nginx: worker process' ] \
                || replacement_count=$((replacement_count + 1))
        done
        [ "$replacement_count" -eq 2 ] && return 0
        drain_attempt=$((drain_attempt + 1))
        [ "$drain_attempt" -lt 50 ] || fail 'reload did not create two replacement workers'
        sleep 0.1
    done
}

wait_for_old_generation_exit() {
    drain_attempt=0
    while old_generation_present; do
        drain_attempt=$((drain_attempt + 1))
        [ "$drain_attempt" -lt 50 ] || fail 'superseded workers did not finish draining'
        sleep 0.1
    done
}

expect_wrong_worker_count() {
    asserted_count=$1
    if "$TEST_DIRECTORY/verify" --workers "$asserted_count" --timeout-seconds 0 \
        > "$TEST_DIRECTORY/count.stdout" 2> "$TEST_DIRECTORY/count.stderr"; then
        fail "two actual workers unexpectedly satisfied --workers $asserted_count"
    fi
    assert_contains "$TEST_DIRECTORY/count.stderr" "expected exactly $asserted_count"
}

[ "$#" -eq 1 ] || { usage >&2; exit 1; }
case "$1" in
    --help | -h) usage; exit 0 ;;
    --check | --disposable-ci-host) mode=$1 ;;
    *) fail "unknown argument: $1" ;;
esac
for source_file in "$UNIT_SOURCE" "$VERIFIER_SOURCE" "$QUIC_DROPIN_SOURCE"; do
    [ -f "$source_file" ] && [ ! -L "$source_file" ] || fail "source must be a real file: $source_file"
done
[ -x "$VERIFIER_SOURCE" ] || fail 'runtime verifier source must be executable'
# The literal systemd variable is part of the source contract, not this shell.
# shellcheck disable=SC2016
assert_contains "$UNIT_SOURCE" 'ExecStartPost=!/usr/local/libexec/nginx-runtime-verify --master-pid $MAINPID --startup'
assert_contains "$UNIT_SOURCE" 'Group=nginx'
assert_contains "$UNIT_SOURCE" 'ProtectProc=invisible'
if grep -E '^CapabilityBoundingSet=.*CAP_SYS_PTRACE' "$UNIT_SOURCE" >/dev/null; then
    fail 'the regression must not grant ptrace to nginx'
fi
if [ "$mode" = --check ]; then
    printf 'Validated sources for the disposable Linux/systemd runtime regression.\n'
    exit 0
fi

[ "${GITHUB_ACTIONS:-false}" = true ] || fail 'execution is restricted to an explicitly disposable GitHub Actions host'
[ "$(uname -s)" = Linux ] || fail 'execution requires Linux'
[ "$(id -u)" -eq 0 ] || fail 'execution requires root on a disposable CI host'
[ "$(cat /proc/1/comm)" = systemd ] || fail 'execution requires systemd as PID 1'
[ -x /usr/sbin/nginx ] || fail '/usr/sbin/nginx is required'
for required_command in awk curl getent install journalctl mktemp sed setpriv systemctl systemd-analyze timeout; do
    command -v "$required_command" >/dev/null 2>&1 || fail "required command not found: $required_command"
done
id nginx >/dev/null 2>&1 || fail 'nginx user is required'
getent group nginx >/dev/null || fail 'nginx group is required'

TEST_DIRECTORY=$(mktemp -d /run/config-nginx-systemd.XXXXXX)
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
chmod 0755 "$TEST_DIRECTORY"
fixture_name=${TEST_DIRECTORY##*/}-service
UNIT_NAME=$fixture_name.service
UNIT_PATH=/run/systemd/system/$UNIT_NAME
[ ! -e "$UNIT_PATH" ] && [ ! -L "$UNIT_PATH" ] || fail 'generated fixture unit already exists'

# Reuse the actual repository unit and verifier. Only names/paths are rebased;
# Restart=no prevents an expected failure from becoming a retry loop.
sed \
    -e "s|^NGINX_PID_FILE=.*|NGINX_PID_FILE=/run/$fixture_name/nginx.pid|" \
    -e "s|^NGINX_LOG_DIRECTORY=.*|NGINX_LOG_DIRECTORY=/var/log/$fixture_name|" \
    -e "s|^NGINX_SYSTEMD_UNIT=.*|NGINX_SYSTEMD_UNIT=$UNIT_NAME|" \
    "$VERIFIER_SOURCE" > "$TEST_DIRECTORY/verify"
chmod 0755 "$TEST_DIRECTORY/verify"
sed \
    -e 's|/usr/sbin/%p|/usr/sbin/nginx|g' \
    -e "s|/usr/sbin/nginx |/usr/sbin/nginx -e /var/log/$fixture_name/bootstrap.log |g" \
    -e "s|%E/%p/%p.conf|$TEST_DIRECTORY/nginx.conf|g" \
    -e "s|/usr/local/libexec/nginx-runtime-verify|$TEST_DIRECTORY/verify|g" \
    -e "s|%p|$fixture_name|g" \
    -e 's|^Restart=on-failure$|Restart=no|' \
    "$UNIT_SOURCE" > "$TEST_DIRECTORY/positive.service"
cat > "$TEST_DIRECTORY/nginx.conf" <<EOF
user nginx nginx;
worker_processes 2;
# drain-timeout-fixture
pid /run/$fixture_name/nginx.pid;
error_log /var/log/$fixture_name/error.log warn;
events { worker_connections 16; }
http {
    access_log off;
    # Override every package default: the fixture's StateDirectory is the
    # writable state root under ProtectSystem=strict, not /var/lib/nginx.
    client_body_temp_path /var/lib/$fixture_name/client_body;
    proxy_temp_path /var/lib/$fixture_name/proxy;
    fastcgi_temp_path /var/lib/$fixture_name/fastcgi;
    uwsgi_temp_path /var/lib/$fixture_name/uwsgi;
    scgi_temp_path /var/lib/$fixture_name/scgi;
    server {
        listen unix:/run/$fixture_name/http.sock;
        location = /slow.txt {
            root $TEST_DIRECTORY;
            limit_rate 1024;
        }
        location / { return 200 "fixture-ready\\n"; }
    }
}
EOF
dd if=/dev/zero of="$TEST_DIRECTORY/slow.txt" bs=1024 count=64 2>/dev/null
chmod 0644 "$TEST_DIRECTORY/slow.txt"
install -m 0644 "$TEST_DIRECTORY/positive.service" "$UNIT_PATH"
UNIT_INSTALLED=yes
systemctl daemon-reload
if ! systemctl start "$UNIT_NAME"; then
    diagnostics
    fail 'current ! startup verifier failed under the real unit sandbox'
fi
systemctl is-active --quiet "$UNIT_NAME" || fail 'fixture is not active after startup verification'
"$TEST_DIRECTORY/verify" --workers 2 --timeout-seconds 0
expect_wrong_worker_count 1
expect_wrong_worker_count 3
curl --fail --silent --show-error --max-time 5 \
    --unix-socket "/run/$fixture_name/http.sock" http://localhost/ \
    > "$TEST_DIRECTORY/http.stdout"
assert_contains "$TEST_DIRECTORY/http.stdout" 'fixture-ready'

# The timeout belongs to each worker's configuration generation. Adding it
# through HUP cannot impose a deadline on workers created without it.
start_drain_client
sed 's/^# drain-timeout-fixture$/worker_shutdown_timeout 2s;/' \
    "$TEST_DIRECTORY/nginx.conf" > "$TEST_DIRECTORY/with-timeout.conf"
assert_contains "$TEST_DIRECTORY/with-timeout.conf" 'worker_shutdown_timeout 2s;'
mv "$TEST_DIRECTORY/with-timeout.conf" "$TEST_DIRECTORY/nginx.conf"
systemctl reload "$UNIT_NAME"
wait_for_replacement_workers
sleep 3
old_generation_present || fail 'adding the timeout retroactively bounded the original generation'
kill -0 "$DRAIN_CLIENT_PID" 2>/dev/null || fail 'the pre-timeout request ended before its control observation'
stop_drain_client
wait_for_old_generation_exit

# The replacement workers inherited 2s. A second reload must close their slow
# response and retire that generation within the five-second polling budget.
start_drain_client
systemctl reload "$UNIT_NAME"
wait_for_replacement_workers
wait_for_old_generation_exit
drain_client_status=0
wait "$DRAIN_CLIENT_PID" || drain_client_status=$?
DRAIN_CLIENT_PID=
[ "$drain_client_status" -eq 18 ] \
    || fail "the timed drain must truncate its slow response (curl 18), received $drain_client_status"
[ "$(wc -c < "$TEST_DIRECTORY/drain.body")" -lt 65536 ] \
    || fail 'the slow response finished instead of exercising the shutdown timeout'
"$TEST_DIRECTORY/verify" --workers 2 --timeout-seconds 0

# Editing the unit on disk without daemon-reload must not turn the next
# restart into an outage: the loaded policy is what the new master received.
# The unit's own --startup gate warns once; an operator run still fails closed
# on the same drift, and daemon-reload clears it.
printf '# on-disk drift fixture\n' >> "$UNIT_PATH"
[ "$(need_daemon_reload)" = yes ] || fail 'the drift fixture did not produce stale manager metadata'
if ! systemctl restart "$UNIT_NAME"; then
    diagnostics
    fail 'stale manager metadata turned a restart into a startup failure'
fi
systemctl is-active --quiet "$UNIT_NAME" || fail 'fixture is not active after the drift restart'
journal_snapshot "$TEST_DIRECTORY/drift-journal"
assert_contains "$TEST_DIRECTORY/drift-journal" "warning: $UNIT_NAME was started from its loaded configuration"
if "$TEST_DIRECTORY/verify" --workers 2 --timeout-seconds 0 \
    > "$TEST_DIRECTORY/drift.stdout" 2> "$TEST_DIRECTORY/drift.stderr"; then
    fail 'operator verification accepted stale manager metadata'
fi
assert_contains "$TEST_DIRECTORY/drift.stderr" 'manager metadata is stale'
systemctl daemon-reload
[ "$(need_daemon_reload)" = no ] || fail 'daemon-reload did not clear the drift fixture'
"$TEST_DIRECTORY/verify" --workers 2 --timeout-seconds 0

# Removing ! must reproduce the cross-UID /proc failure. This makes the test
# fail if ProtectProc is ignored, root group membership accidentally bypasses
# it, or the test environment otherwise fails to exercise the actual boundary.
systemctl stop "$UNIT_NAME"
sed 's|^ExecStartPost=!|ExecStartPost=|' "$TEST_DIRECTORY/positive.service" \
    > "$TEST_DIRECTORY/negative.service"
install -m 0644 "$TEST_DIRECTORY/negative.service" "$UNIT_PATH"
systemctl daemon-reload
if systemctl start "$UNIT_NAME"; then
    diagnostics
    fail 'removing the checker credential exception unexpectedly passed startup'
fi
journal_snapshot "$TEST_DIRECTORY/journal"
assert_contains "$TEST_DIRECTORY/journal" 'nginx has 0 active workers; expected at least 1'

# Simulate a later site drop-in clearing @mount, while retaining the optional
# QUIC capabilities and unrelated seccomp restrictions. Disable only this
# fixture's startup checker first so the read-only checker can inspect the
# deliberately incorrect running service. No mount operation is attempted.
sed '/^ExecStartPost=/d' "$TEST_DIRECTORY/positive.service" \
    > "$TEST_DIRECTORY/mount-negative.service"
cat "$QUIC_DROPIN_SOURCE" >> "$TEST_DIRECTORY/mount-negative.service"
printf '\nSystemCallFilter=\nSystemCallFilter=~@clock\n' \
    >> "$TEST_DIRECTORY/mount-negative.service"
install -m 0644 "$TEST_DIRECTORY/mount-negative.service" "$UNIT_PATH"
systemctl daemon-reload
systemctl reset-failed "$UNIT_NAME"
if ! systemctl start "$UNIT_NAME"; then
    diagnostics
    fail 'the weakened-filter fixture could not start'
fi
mount_fixture_pid=$(systemctl show "$UNIT_NAME" --property=MainPID --value)
quic_capabilities=$(sed -n 's/^QUIC_CAPABILITIES=//p' "$VERIFIER_SOURCE")
[ "$(awk '$1 == "Seccomp:" { print $2 }' "/proc/$mount_fixture_pid/status")" = 2 ] \
    || fail 'the weakened-filter fixture did not retain seccomp filtering'
for capability_field in CapBnd CapEff CapPrm; do
    [ "$(awk -v field="$capability_field:" '$1 == field { print $2 }' "/proc/$mount_fixture_pid/status")" = "$quic_capabilities" ] \
        || fail "the weakened-filter fixture did not retain its QUIC $capability_field set"
done
if "$TEST_DIRECTORY/verify" --quic-bpf --workers 2 --timeout-seconds 0 \
    > "$TEST_DIRECTORY/mount.stdout" 2> "$TEST_DIRECTORY/mount.stderr"; then
    fail 'Seccomp=2 hid the missing mount barrier from the runtime checker'
fi
assert_contains "$TEST_DIRECTORY/mount.stderr" 'SystemCallFilter does not deny required mount syscalls:'

# Restore the actual startup checker and require the same composed weakening
# to fail activation too, before any caller could report a verified startup.
systemctl stop "$UNIT_NAME"
grep '^ExecStartPost=' "$TEST_DIRECTORY/positive.service" \
    >> "$TEST_DIRECTORY/mount-negative.service"
install -m 0644 "$TEST_DIRECTORY/mount-negative.service" "$UNIT_PATH"
systemctl daemon-reload
if systemctl start "$UNIT_NAME"; then
    diagnostics
    fail 'startup accepted a QUIC-capable master without the mount barrier'
fi
journal_snapshot "$TEST_DIRECTORY/mount-journal"
assert_contains "$TEST_DIRECTORY/mount-journal" 'SystemCallFilter does not deny required mount syscalls:'

printf 'Validated nginx startup, worker counts, drain-timeout adoption, stale-metadata start-gate tolerance, checker credentials, and mandatory mount denial despite retained QUIC capabilities and Seccomp=2.\n'
