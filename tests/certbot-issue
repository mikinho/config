#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

# Runtime shell snippets below intentionally preserve positional expansions.
# shellcheck disable=SC2016

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
ISSUER=$REPOSITORY_ROOT/certbot/issue
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/config-certbot-issue.XXXXXX")

cleanup() {
    if [ -d "$TEST_ROOT" ]; then
        rm -rf -- "$TEST_ROOT"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

expect_failure() {
    expected_message=$1
    shift
    if "$@" >"$TEST_ROOT/command.stdout" 2>"$TEST_ROOT/command.stderr"; then
        fail "command unexpectedly succeeded: $*"
    fi
    grep -F -- "$expected_message" "$TEST_ROOT/command.stderr" >/dev/null \
        || fail "command failed without expected message: $expected_message"
}

assert_contains() {
    checked_file=$1
    expected_text=$2
    grep -F -- "$expected_text" "$checked_file" >/dev/null \
        || fail "$checked_file is missing: $expected_text"
}

assert_not_contains() {
    checked_file=$1
    rejected_text=$2
    if grep -F -- "$rejected_text" "$checked_file" >/dev/null; then
        fail "$checked_file unexpectedly contains: $rejected_text"
    fi
}

[ -x "$ISSUER" ] || fail "Certbot issuer is not executable"
"$ISSUER" --help >/dev/null
"$ISSUER" --check >/dev/null

"$ISSUER" \
    --plan \
    --staging \
    --email ops@example.com \
    --domain Example.COM \
    --domain www.example.com \
    > "$TEST_ROOT/staging.plan"
assert_contains "$TEST_ROOT/staging.plan" 'environment=staging, backend=native, primary=example.com'
assert_contains "$TEST_ROOT/staging.plan" 'through 127.0.0.2 for every requested name'
assert_contains "$TEST_ROOT/staging.plan" '/bin/certbot certonly --non-interactive --agree-tos'
assert_contains "$TEST_ROOT/staging.plan" '--preferred-challenges http'
assert_contains "$TEST_ROOT/staging.plan" '--server https://acme-staging-v02.api.letsencrypt.org/directory'
assert_contains "$TEST_ROOT/staging.plan" '--config-dir /etc/letsencrypt --work-dir /var/lib/letsencrypt --logs-dir /var/log/letsencrypt'
assert_contains "$TEST_ROOT/staging.plan" '--domain example.com --domain www.example.com --dry-run'
assert_not_contains "$TEST_ROOT/staging.plan" 'certbot-healthcheck'

"$ISSUER" \
    --plan \
    --production \
    --staging-passed \
    --backend snap \
    --email ops@example.com \
    --domain example.com \
    > "$TEST_ROOT/production.plan"
assert_contains "$TEST_ROOT/production.plan" 'environment=production, backend=snap, primary=example.com'
assert_contains "$TEST_ROOT/production.plan" '/usr/local/bin/certbot certonly'
assert_contains "$TEST_ROOT/production.plan" \
    '--preferred-challenges http --server https://acme-v02.api.letsencrypt.org/directory'
assert_contains "$TEST_ROOT/production.plan" \
    '/usr/local/bin/certbot renew --cert-name example.com --dry-run --no-random-sleep-on-renew --server https://acme-staging-v02.api.letsencrypt.org/directory'
assert_contains "$TEST_ROOT/production.plan" '/usr/local/bin/certbot-healthcheck'
assert_not_contains "$TEST_ROOT/production.plan" '--domain example.com --dry-run'

# Exercise the real command construction and issuance sequence with a recording
# Certbot boundary. Only host validation and the HTTP-01 probe are stubbed out;
# no certificate authority, system service, or production directory is touched.
# The function definitions end where argument parsing begins; the marker must
# be unique or the slice silently drops or keeps the wrong code.
[ "$(grep -c -x 'while \[ "\$#" -gt 0 \]; do' "$ISSUER")" -eq 1 ] \
    || fail 'cannot isolate the issuer function definitions: parse-loop marker is not unique'
sed '/^while \[ "\$#" -gt 0 \]; do/,$d' "$ISSUER" > "$TEST_ROOT/issuer-functions"
cat > "$TEST_ROOT/record-certbot" <<'EOF'
#!/usr/bin/env sh
set -eu
command_name=$1
shift
server=$(sed -n 's/^server = //p' "$FAKE_CERTBOT_CONFIG")
dry_run=no
config_dir=uncontrolled
work_dir=uncontrolled
logs_dir=uncontrolled
while [ "$#" -gt 0 ]; do
    case "$1" in
        --server) server=$2; shift 2 ;;
        --dry-run) dry_run=yes; shift ;;
        --config-dir) config_dir=$2; shift 2 ;;
        --work-dir) work_dir=$2; shift 2 ;;
        --logs-dir) logs_dir=$2; shift 2 ;;
        *) shift ;;
    esac
done
printf 'command=%s server=%s dry_run=%s config=%s work=%s logs=%s\n' \
    "$command_name" "$server" "$dry_run" "$config_dir" "$work_dir" "$logs_dir" >> "$FAKE_CERTBOT_CALLS"
EOF
cat > "$TEST_ROOT/record-healthcheck" <<'EOF'
#!/usr/bin/env sh
exit 0
EOF
chmod 0755 "$TEST_ROOT/record-certbot" "$TEST_ROOT/record-healthcheck"

for selected_environment in staging production; do
    case "$selected_environment" in
        staging) conflicting_server=https://acme-v02.api.letsencrypt.org/directory ;;
        production) conflicting_server=https://acme-staging-v02.api.letsencrypt.org/directory ;;
    esac
    printf 'server = %s\n' "$conflicting_server" > "$TEST_ROOT/cli.ini"
    FAKE_CERTBOT_CONFIG="$TEST_ROOT/cli.ini" \
    FAKE_CERTBOT_CALLS="$TEST_ROOT/$selected_environment.calls" \
        sh -c '
            . "$1/issuer-functions"
            ENVIRONMENT=$2
            CERTBOT_BINARY=$1/record-certbot
            HEALTHCHECK=$1/record-healthcheck
            EMAIL=ops@example.com
            DOMAINS=example.com
            PRIMARY_DOMAIN=example.com
            STAGING_PASSED=yes
            SYSTEM_CERTBOT_CONFIG=$1/cli.ini
            USER_CERTBOT_CONFIG=$1/user-cli.ini
            resolve_user_config() { :; }
            require_trusted_configuration_source() { :; }
            validate_selection
            validate_live_host() { :; }
            verify_local_webroot() { :; }
            issue_certificate
        ' issue-test "$TEST_ROOT" "$selected_environment" > "$TEST_ROOT/$selected_environment.result"
done
assert_contains "$TEST_ROOT/staging.calls" \
    'command=certonly server=https://acme-staging-v02.api.letsencrypt.org/directory dry_run=yes'
[ "$(wc -l < "$TEST_ROOT/staging.calls" | tr -d ' ')" = 1 ] \
    || fail 'staging unexpectedly ran an additional Certbot operation'
assert_contains "$TEST_ROOT/production.calls" \
    'command=certonly server=https://acme-v02.api.letsencrypt.org/directory dry_run=no'
assert_contains "$TEST_ROOT/production.calls" \
    'command=renew server=https://acme-staging-v02.api.letsencrypt.org/directory dry_run=yes'
[ "$(wc -l < "$TEST_ROOT/production.calls" | tr -d ' ')" = 2 ] \
    || fail 'production did not issue once and test renewal once'
for executed_calls in "$TEST_ROOT/staging.calls" "$TEST_ROOT/production.calls"; do
    if grep -F 'uncontrolled' "$executed_calls" >/dev/null; then
        fail 'an executed Certbot command omitted a managed state directory'
    fi
    assert_contains "$executed_calls" \
        'config=/etc/letsencrypt work=/var/lib/letsencrypt logs=/var/log/letsencrypt'
done

# No global mode directive is acceptable, including false settings and aliases.
# These checks call the production guard without reading any host configuration.
for inherited_setting in \
    'staging = true' 'test-cert: true' '--dry-run' 'dry-run yes' \
    '  --staging = false' 'test-cert = off' 'dry-run = 0' \
    'test_cert = true' '--dry_run = true'
do
    printf '%s\n' "$inherited_setting" > "$TEST_ROOT/conflicting.ini"
    expect_failure 'remove staging, test-cert, and dry-run settings' \
        sh -c '. "$1/issuer-functions"; validate_inherited_config_file "$1/conflicting.ini"' \
        config-test "$TEST_ROOT"
done
printf '# staging = true\n; dry-run = true\n[settings]\nserver = https://acme.example.invalid/directory\n' \
    > "$TEST_ROOT/benign.ini"
sh -c '. "$1/issuer-functions"; validate_inherited_config_file "$1/benign.ini"' \
    config-test "$TEST_ROOT"
ln -s "$TEST_ROOT/not-present" "$TEST_ROOT/dangling.ini"
expect_failure 'inherited Certbot configuration must be a readable non-symlink file' \
    sh -c '. "$1/issuer-functions"; validate_inherited_config_file "$1/dangling.ini"' \
    config-test "$TEST_ROOT"
mkdir "$TEST_ROOT/config-directory"
expect_failure 'inherited Certbot configuration must be a readable non-symlink file' \
    sh -c '. "$1/issuer-functions"; validate_inherited_config_file "$1/config-directory"' \
    config-test "$TEST_ROOT"
ln -s "$TEST_ROOT/benign.ini" "$TEST_ROOT/readable-symlink.ini"
expect_failure 'inherited Certbot configuration must be a readable non-symlink file' \
    sh -c '. "$1/issuer-functions"; validate_inherited_config_file "$1/readable-symlink.ini"' \
    config-test "$TEST_ROOT"
if [ "$(id -u)" -ne 0 ]; then
    cp "$TEST_ROOT/benign.ini" "$TEST_ROOT/unreadable.ini"
    chmod 0000 "$TEST_ROOT/unreadable.ini"
    expect_failure 'inherited Certbot configuration must be a readable non-symlink file' \
        sh -c '. "$1/issuer-functions"; validate_inherited_config_file "$1/unreadable.ini"' \
        config-test "$TEST_ROOT"
    chmod 0600 "$TEST_ROOT/unreadable.ini"
fi

# Certbot runs as root and executes hooks named in cli.ini, so a default file is
# trusted only when root owns it and every directory above it, and none of them
# is writable by group or other. Identities come from a mock so the check is
# exercised regardless of who runs the tests or where TMPDIR lives.
mkdir -p "$TEST_ROOT/trusted/letsencrypt"
printf 'server = https://acme.example.invalid/directory\n' > "$TEST_ROOT/trusted/letsencrypt/cli.ini"
ln -s "$TEST_ROOT/trusted/letsencrypt/cli.ini" "$TEST_ROOT/trusted/letsencrypt/link.ini"
trust_check='
    . "$1/issuer-functions"
    TRUST_ROOT=$1
    path_identity() {
        case "$1" in
            "$TRUST_ROOT/trusted/letsencrypt/cli.ini") printf "%s\n" "$FILE_IDENTITY" ;;
            "$TRUST_ROOT/trusted/letsencrypt") printf "%s\n" "$DIRECTORY_IDENTITY" ;;
            "$TRUST_ROOT/trusted") printf "%s\n" "$PARENT_IDENTITY" ;;
            *) printf "0:755\n" ;;
        esac
    }
    require_trusted_configuration_source "$1/$2"'
run_trust_check() {
    env FILE_IDENTITY="$1" DIRECTORY_IDENTITY="$2" PARENT_IDENTITY="$3" \
        sh -c "$trust_check" config-test "$TEST_ROOT" "$4"
}
run_trust_check 0:600 0:700 0:755 trusted/letsencrypt/cli.ini
run_trust_check 0:644 0:755 0:1755 trusted/letsencrypt/cli.ini
run_trust_check 1000:666 1000:777 1000:1777 absent/cli.ini
expect_failure 'configuration file must be owned by root' \
    run_trust_check 1000:600 0:700 0:755 trusted/letsencrypt/cli.ini
for writable_mode in 620 602 666; do
    expect_failure 'configuration file must not be writable by group or other' \
        run_trust_check "0:$writable_mode" 0:700 0:755 trusted/letsencrypt/cli.ini
done
expect_failure 'configuration directory must be owned by root' \
    run_trust_check 0:600 1000:700 0:755 trusted/letsencrypt/cli.ini
expect_failure 'configuration directory must not be writable by group or other' \
    run_trust_check 0:600 0:770 0:755 trusted/letsencrypt/cli.ini
# A sticky world-writable ancestor such as /tmp is still writable by other.
expect_failure 'configuration directory must not be writable by group or other' \
    run_trust_check 0:600 0:700 0:1777 trusted/letsencrypt/cli.ini
expect_failure 'cannot interpret inherited Certbot configuration file mode' \
    run_trust_check 0:rw-r--r-- 0:700 0:755 trusted/letsencrypt/cli.ini
expect_failure 'must be a regular file, not a symbolic link' \
    run_trust_check 0:600 0:700 0:755 trusted/letsencrypt/link.ini
# Ownership is established before any content is parsed.
printf 'staging = true\n' > "$TEST_ROOT/trusted/letsencrypt/untrusted-staging.ini"
expect_failure 'configuration file must be owned by root' \
    sh -c '
        . "$1/issuer-functions"
        path_identity() { printf "1000:600\n"; }
        SYSTEM_CERTBOT_CONFIG=$1/trusted/letsencrypt/untrusted-staging.ini
        USER_CERTBOT_CONFIG=$1/absent-user.ini
        resolve_user_config() { :; }
        validate_inherited_config
    ' config-test "$TEST_ROOT"
assert_not_contains "$TEST_ROOT/command.stderr" 'remove staging, test-cert, and dry-run settings'

for config_source in system user; do
    printf 'staging = true\n' > "$TEST_ROOT/$config_source-conflict.ini"
    expect_failure 'remove staging, test-cert, and dry-run settings' \
        sh -c '
            . "$1/issuer-functions"
            SYSTEM_CERTBOT_CONFIG=$1/absent-system.ini
            USER_CERTBOT_CONFIG=$1/absent-user.ini
            case "$2" in
                system) SYSTEM_CERTBOT_CONFIG=$1/system-conflict.ini ;;
                user) USER_CERTBOT_CONFIG=$1/user-conflict.ini ;;
            esac
            resolve_user_config() { :; }
            require_trusted_configuration_source() { :; }
            CERTBOT_BINARY=$1/not-an-executable
            run_certbot certonly
        ' config-test "$TEST_ROOT" "$config_source"
done

expect_failure \
    'production issuance requires --staging-passed' \
    "$ISSUER" \
    --plan \
    --production \
    --email ops@example.com \
    --domain example.com
expect_failure \
    'select exactly one issuance environment' \
    "$ISSUER" \
    --plan \
    --email ops@example.com \
    --domain example.com
expect_failure \
    'at least one --domain is required' \
    "$ISSUER" --plan --staging --email ops@example.com
expect_failure \
    'duplicate DNS name' \
    "$ISSUER" \
    --plan \
    --staging \
    --email ops@example.com \
    --domain example.com \
    --domain EXAMPLE.COM
expect_failure \
    'wildcard names require a reviewed DNS-01 workflow' \
    "$ISSUER" \
    --plan \
    --staging \
    --email ops@example.com \
    --domain '*.example.com'
expect_failure \
    'invalid DNS label' \
    "$ISSUER" \
    --plan \
    --staging \
    --email ops@example.com \
    --domain bad-.example.com
expect_failure \
    'invalid ACME account email address' \
    "$ISSUER" \
    --plan \
    --staging \
    --email invalid \
    --domain example.com
expect_failure \
    'unsupported Certbot backend' \
    "$ISSUER" \
    --plan \
    --staging \
    --backend arbitrary \
    --email ops@example.com \
    --domain example.com
expect_failure \
    '--check does not accept issuance options' \
    "$ISSUER" --check --backend snap

printf 'Validated Certbot issuance plans and execution with explicit ACME endpoints.\n'
