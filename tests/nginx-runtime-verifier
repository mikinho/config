#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

# Exercise the read-only verifier against kernel-shaped fixtures, including a
# fixture monotonic clock so window and retry behavior is exact and instant. No
# systemd, Linux namespaces, service users, or host permission changes are
# simulated.
set -eu
PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/config-nginx-verifier.XXXXXX")
export TEST_ROOT
VERIFY=$TEST_ROOT/verify
BASE_CAPABILITIES=00000000010004eb
QUIC_CAPABILITIES=000000c0012014eb
MOUNT_SYSCALLS='chroot fsconfig fsmount fsopen fspick mount mount_setattr move_mount open_tree pivot_root umount umount2'
export MOUNT_SYSCALLS

cleanup() { rm -rf -- "$TEST_ROOT"; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
fail() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 1; }
assert_contains() { grep -F -- "$2" "$1" >/dev/null || fail "missing expected text: $2"; }
expect_failure() {
    expected_message=$1
    shift
    if "$@" > "$TEST_ROOT/stdout" 2> "$TEST_ROOT/stderr"; then fail 'invalid runtime unexpectedly passed'; fi
    assert_contains "$TEST_ROOT/stderr" "$expected_message"
}
expect_success() {
    if ! "$@" > "$TEST_ROOT/stdout" 2> "$TEST_ROOT/stderr"; then
        cat "$TEST_ROOT/stderr" >&2
        fail 'valid runtime unexpectedly failed'
    fi
}

write_process() {
    fixture_process_pid=$1
    fixture_process_role=$2
    if [ "$fixture_process_role" = master ]; then process_uid=0; effective_caps=$BASE_CAPABILITIES;
    else process_uid=991; effective_caps=0000000000000000; fi
    mkdir -p "$TEST_ROOT/proc/$fixture_process_pid"
    cat > "$TEST_ROOT/proc/$fixture_process_pid/status" <<EOF
Name:	nginx
Umask:	0027
Uid:	$process_uid	$process_uid	$process_uid	$process_uid
Gid:	990	990	990	990
Groups:	990
CapBnd:	$BASE_CAPABILITIES
CapEff:	$effective_caps
CapPrm:	$effective_caps
CapAmb:	0000000000000000
NoNewPrivs:	1
Seccomp:	2
EOF
    if [ "$fixture_process_role" = master ]; then
        printf 'nginx: master process /usr/sbin/nginx -g daemon off;\000' > "$TEST_ROOT/proc/$fixture_process_pid/cmdline"
    else
        printf 'nginx: worker process\000' > "$TEST_ROOT/proc/$fixture_process_pid/cmdline"
    fi
}

reset_fixture() {
    rm -rf -- "$TEST_ROOT/proc"
    mkdir -p "$TEST_ROOT/proc/101/task/101"
    write_process 101 master
    write_process 201 worker
    write_process 202 worker
    write_process 301 worker
    write_process 401 worker
    printf 'nginx: cache manager process\000' > "$TEST_ROOT/proc/301/cmdline"
    printf 'nginx: worker process is shutting down\000' > "$TEST_ROOT/proc/401/cmdline"
    printf '201 202 301 401\n' > "$TEST_ROOT/proc/101/task/101/children"
    # The verifier's deadline reads this fixture clock; mocked sleeps and
    # stalled manager queries advance it, so no test waits in real time.
    printf '1000.00 4000.00\n' > "$TEST_ROOT/proc/uptime"
    printf '101\n' > "$TEST_ROOT/nginx.pid"
    rm -f "$TEST_ROOT/slept" "$TEST_ROOT/stalls"
    : > "$TEST_ROOT/commands"
}

stall_manager_queries() {
    # The next N timeout-wrapped manager queries miss their five-second
    # deadline; each consumes the deadline plus the one-second kill grace.
    printf '%s\n' "$1" > "$TEST_ROOT/stalls"
}

count_commands() {
    grep -c -x -- "$1" "$TEST_ROOT/commands" || :
}

replace_status() {
    awk -v key="$2:" -v value="$3" '$1 == key { print key "\t" value; next } { print }' \
        "$TEST_ROOT/proc/$1/status" > "$TEST_ROOT/new-status"
    mv "$TEST_ROOT/new-status" "$TEST_ROOT/proc/$1/status"
}

mkdir -p "$TEST_ROOT/bin" "$TEST_ROOT/logs"
sed \
    -e "s|^PROC_ROOT=.*|PROC_ROOT=$TEST_ROOT/proc|" \
    -e "s|^NGINX_PID_FILE=.*|NGINX_PID_FILE=$TEST_ROOT/nginx.pid|" \
    -e "s|^NGINX_LOG_DIRECTORY=.*|NGINX_LOG_DIRECTORY=$TEST_ROOT/logs|" \
    "$REPOSITORY_ROOT/nginx/verify-runtime" > "$VERIFY"
chmod 0755 "$VERIFY"
cat > "$TEST_ROOT/bin/id" <<'MOCK'
#!/usr/bin/env sh
case "$*" in
    -u) printf '%s\n' "${TEST_CALLER_UID:-0}" ;;
    '-u nginx') printf '991\n' ;;
    '-g nginx') printf '990\n' ;;
    *) exit 1 ;;
esac
MOCK
cat > "$TEST_ROOT/bin/stat" <<'MOCK'
#!/usr/bin/env sh
[ "$*" = "-c %u:%g:%a $TEST_ROOT/logs" ] || exit 1
printf '%s\n' "${TEST_LOG_METADATA:-0:990:750}"
MOCK
cat > "$TEST_ROOT/bin/setpriv" <<'MOCK'
#!/usr/bin/env sh
[ "$*" = "--reuid 991 --regid 990 --init-groups -- /usr/bin/test -x $TEST_ROOT/logs" ] || exit 1
printf 'worker traversal\n' >> "$TEST_ROOT/commands"
[ "${TEST_TRAVERSAL_DENIED:-no}" = no ]
MOCK
cat > "$TEST_ROOT/advance-clock" <<'MOCK'
#!/usr/bin/env sh
read -r fixture_seconds _ < "$TEST_ROOT/proc/uptime"
printf '%s.00 4000.00\n' "$((${fixture_seconds%%.*} + $1))" > "$TEST_ROOT/proc/uptime"
MOCK
cat > "$TEST_ROOT/bin/sleep" <<'MOCK'
#!/usr/bin/env sh
[ "$*" = 1 ] || exit 1
printf 'wait\n' >> "$TEST_ROOT/commands"
: > "$TEST_ROOT/slept"
"$TEST_ROOT/advance-clock" 1
if [ "${TEST_DELAYED_WORKERS:-no}" = yes ]; then
    printf '201 202\n' > "$TEST_ROOT/proc/101/task/101/children"
fi
MOCK
cat > "$TEST_ROOT/bin/timeout" <<'MOCK'
#!/usr/bin/env sh
[ "$1 $2" = '--kill-after=1 5' ] || exit 1
shift 2
if [ -f "$TEST_ROOT/stalls" ]; then
    read -r remaining_stalls < "$TEST_ROOT/stalls"
    if [ "$remaining_stalls" -gt 0 ]; then
        printf '%s\n' "$((remaining_stalls - 1))" > "$TEST_ROOT/stalls"
        printf 'stall %s\n' "$1" >> "$TEST_ROOT/commands"
        "$TEST_ROOT/advance-clock" 6
        exit 124
    fi
fi
printf 'query %s\n' "$1" >> "$TEST_ROOT/commands"
exec "$@"
MOCK
cat > "$TEST_ROOT/bin/systemctl" <<'MOCK'
#!/usr/bin/env sh
[ "$*" = '--no-pager show --property=LoadState,NeedDaemonReload,SystemCallFilter,SystemCallErrorNumber,MainPID nginx.service' ] || exit 1
[ "${TEST_MANAGER_UNAVAILABLE:-no}" = no ] || exit 1
printf 'LoadState=%s\nNeedDaemonReload=%s\nSystemCallErrorNumber=%s\nMainPID=%s\nSystemCallFilter=%s\n' \
    "${TEST_UNIT_LOAD:-loaded}" "${TEST_UNIT_STALE:-no}" "${TEST_SYSCALL_ERRNO:-1}" \
    "${TEST_UNIT_PID:-101}" "${TEST_SYSCALL_FILTER-~$MOUNT_SYSCALLS}"
MOCK
cat > "$TEST_ROOT/bin/systemd-analyze" <<'MOCK'
#!/usr/bin/env sh
[ "$*" = 'syscall-filter @mount' ] || exit 1
[ "${TEST_ANALYZE_UNAVAILABLE:-no}" = no ] || exit 1
if [ "${TEST_ANALYZE_MALFORMED:-no}" = yes ]; then
    printf 'unexpected analyzer output\n'
    exit 0
fi
printf '@mount\n    # Mounting and unmounting of file systems\n'
for syscall in $MOUNT_SYSCALLS; do printf '    %s\n' "$syscall"; done
MOCK
chmod 0755 "$TEST_ROOT/bin/"* "$TEST_ROOT/advance-clock"
PATH=$TEST_ROOT/bin:$PATH
export PATH

reset_fixture
"$VERIFY" --timeout-seconds 0 --workers 2 > "$TEST_ROOT/stdout"
assert_contains "$TEST_ROOT/stdout" 'master PID 101 and 2 active worker(s)'
expect_failure 'expected exactly 3' "$VERIFY" --workers 3 --timeout-seconds 0
expect_failure 'expected exactly 1' "$VERIFY" --workers 1 --timeout-seconds 0
# Default readiness remains a minimum; the explicit sizing assertion is exact.
"$VERIFY" --timeout-seconds 0 > "$TEST_ROOT/stdout"
assert_contains "$TEST_ROOT/stdout" 'master PID 101 and 2 active worker(s)'
expect_failure 'master did not change' "$VERIFY" --previous-master-pid 101 --timeout-seconds 0
expect_failure 'PID file does not match' env TEST_UNIT_PID=202 "$VERIFY" --master-pid 202 --timeout-seconds 0
expect_failure 'unit whose mount policy was inspected' env TEST_UNIT_PID=202 "$VERIFY" --timeout-seconds 0
expect_failure 'run as root' env TEST_CALLER_UID=501 "$VERIFY" --timeout-seconds 0
expect_failure 'root:nginx with mode 0750' env TEST_LOG_METADATA=0:0:750 "$VERIFY" --timeout-seconds 0
expect_failure 'root:nginx with mode 0750' env TEST_LOG_METADATA=991:990:750 "$VERIFY" --timeout-seconds 0
expect_failure 'root:nginx with mode 0750' env TEST_LOG_METADATA=0:990:755 "$VERIFY" --timeout-seconds 0
expect_failure 'cannot traverse' env TEST_TRAVERSAL_DENIED=yes "$VERIFY" --timeout-seconds 0
"$VERIFY" --policy-only > "$TEST_ROOT/stdout"
assert_contains "$TEST_ROOT/stdout" 'composed mount-syscall denial'
expect_failure 'does not accept process assertions' "$VERIFY" --policy-only --workers 1
expect_failure 'does not accept process assertions or --startup' "$VERIFY" --policy-only --startup
# A manager that answers wrongly fails at once; one that cannot answer is
# retried until the window closes, then reported with the attempt count.
reset_fixture
expect_failure 'cannot inspect the composed' env TEST_MANAGER_UNAVAILABLE=yes "$VERIFY" --policy-only
assert_contains "$TEST_ROOT/stderr" 'systemctl show exited with status 1 after 11 attempt(s) within the 10-second window'
[ "$(count_commands wait)" -eq 10 ] || fail 'an unavailable manager was not retried across the default window'
reset_fixture
expect_failure 'must be loaded' env TEST_UNIT_LOAD=not-found "$VERIFY" --policy-only
[ ! -f "$TEST_ROOT/slept" ] || fail 'an unloaded unit was retried'
expect_failure 'manager metadata is stale' env TEST_UNIT_STALE=yes "$VERIFY" --policy-only
assert_contains "$TEST_ROOT/stderr" 'run systemctl daemon-reload, then restart nginx.service'
expect_failure 'manager metadata is unknown' env TEST_UNIT_STALE=maybe "$VERIFY" --policy-only
reset_fixture
expect_failure 'cannot expand the local' env TEST_ANALYZE_UNAVAILABLE=yes "$VERIFY" --policy-only --timeout-seconds 3
assert_contains "$TEST_ROOT/stderr" 'systemd-analyze exited with status 1 after 4 attempt(s) within the 3-second window'
expect_failure 'cannot interpret the local' env TEST_ANALYZE_MALFORMED=yes "$VERIFY" --policy-only
expect_failure 'must retain SystemCallErrorNumber=EPERM' env TEST_SYSCALL_ERRNO=0 "$VERIFY" --policy-only
# Stalled queries consume their deadline and kill grace on the fixture clock:
# two stalls fit a twenty-second window, exhaust a ten-second one, and a
# zero-second window makes exactly one attempt.
reset_fixture
stall_manager_queries 2
expect_success "$VERIFY" --timeout-seconds 20
assert_contains "$TEST_ROOT/stdout" 'master PID 101 and 2 active worker(s)'
[ "$(count_commands 'stall systemctl')" -eq 2 ] || fail 'stalled manager queries were not retried'
[ "$(count_commands wait)" -eq 2 ] || fail 'manager retries did not pause between attempts'
reset_fixture
stall_manager_queries 2
expect_failure 'systemctl show did not answer within 5 seconds' "$VERIFY" --timeout-seconds 10
assert_contains "$TEST_ROOT/stderr" 'after 2 attempt(s) within the 10-second window'
reset_fixture
stall_manager_queries 1
expect_failure 'did not answer within 5 seconds' "$VERIFY" --timeout-seconds 0
[ ! -f "$TEST_ROOT/slept" ] || fail 'a zero-second window must not wait'
reset_fixture
stall_manager_queries 1
expect_success "$VERIFY" --policy-only --timeout-seconds 10
assert_contains "$TEST_ROOT/stdout" 'composed mount-syscall denial'
# The @mount expansion is cached once obtained; only systemctl is re-queried.
reset_fixture
: > "$TEST_ROOT/proc/101/task/101/children"
expect_success env TEST_DELAYED_WORKERS=yes "$VERIFY" --workers 2 --timeout-seconds 2
[ "$(count_commands 'query systemd-analyze')" -eq 1 ] || fail 'the mount group expansion was not cached across retries'
[ "$(count_commands 'query systemctl')" -eq 2 ] || fail 'the composed policy was not re-read on every attempt'
# Policy violations never consume the window, even when it is open.
reset_fixture
expect_failure 'must retain SystemCallErrorNumber=EPERM' env TEST_SYSCALL_ERRNO=0 "$VERIFY" --timeout-seconds 5
[ ! -f "$TEST_ROOT/slept" ] || fail 'a policy violation was retried'
# Only the unit's own start gate tolerates on-disk changes that daemon-reload
# has not activated, and it says so exactly once.
reset_fixture
: > "$TEST_ROOT/proc/101/task/101/children"
expect_success env TEST_UNIT_STALE=yes TEST_DELAYED_WORKERS=yes "$VERIFY" --startup --workers 2 --timeout-seconds 2
assert_contains "$TEST_ROOT/stdout" 'master PID 101 and 2 active worker(s)'
assert_contains "$TEST_ROOT/stderr" 'warning: nginx.service was started from its loaded configuration'
assert_contains "$TEST_ROOT/stderr" 'run systemctl daemon-reload and restart nginx.service'
[ "$(grep -c 'warning:' "$TEST_ROOT/stderr")" -eq 1 ] || fail 'the stale metadata warning was not reported exactly once'
[ -f "$TEST_ROOT/slept" ] || fail 'the start gate did not retry delayed workers'
reset_fixture
expect_failure 'manager metadata is stale' env TEST_UNIT_STALE=yes "$VERIFY" --timeout-seconds 0
expect_failure 'manager metadata is unknown' env TEST_UNIT_STALE=maybe "$VERIFY" --startup --timeout-seconds 0
expect_failure 'must be loaded' env TEST_UNIT_LOAD=not-found "$VERIFY" --startup --timeout-seconds 0
# Ordering, redundant entries, additional restrictions, and denying errno
# suffixes do not weaken the mandatory set.
env TEST_SYSCALL_FILTER="~umount2 mount:EPERM $MOUNT_SYSCALLS reboot:kill" \
    "$VERIFY" --policy-only > "$TEST_ROOT/stdout"

for process_pid in 101 201; do
    for bad_field in Umask NoNewPrivs Seccomp CapBnd CapEff CapPrm CapAmb Uid Gid; do
        reset_fixture
        case "$bad_field" in
            Umask) bad_value=0000; expected='does not retain Umask 0027' ;;
            NoNewPrivs) bad_value=0; expected='does not have NoNewPrivileges' ;;
            Seccomp) bad_value=0; expected='does not have seccomp filtering' ;;
            CapBnd) bad_value=000001ffffffffff; expected='unexpected capability bounding set' ;;
            CapEff | CapPrm | CapAmb) bad_value=0000000000000001; expected='unexpected effective, permitted, or ambient capabilities' ;;
            Uid | Gid) bad_value='0 0 0 991'; expected='unexpected user or group identity' ;;
        esac
        replace_status "$process_pid" "$bad_field" "$bad_value"
        expect_failure "$expected" "$VERIFY" --timeout-seconds 0
        case "$bad_field" in
            CapBnd | CapEff | CapPrm | CapAmb)
                assert_contains "$TEST_ROOT/stderr" "$bad_field=$bad_value"
                ;;
        esac
    done
done
reset_fixture
replace_status 101 Groups '0 990'
expect_failure 'unexpected supplementary groups: Groups=0 990; expected 990' "$VERIFY" --timeout-seconds 0
reset_fixture
: > "$TEST_ROOT/proc/101/task/101/children"
env TEST_DELAYED_WORKERS=yes "$VERIFY" --workers 2 --timeout-seconds 2 > "$TEST_ROOT/stdout"
[ -f "$TEST_ROOT/slept" ] || fail 'foreground startup was not polled'
assert_contains "$TEST_ROOT/stdout" '2 active worker(s)'
reset_fixture
: > "$TEST_ROOT/proc/101/task/101/children"
expect_failure 'expected at least 1' "$VERIFY" --timeout-seconds 2
[ "$(grep -c '^wait$' "$TEST_ROOT/commands")" -eq 2 ] || fail 'polling did not honor its bound'

reset_fixture
for process_pid in 101 201 202; do replace_status "$process_pid" CapBnd "$QUIC_CAPABILITIES"; done
replace_status 101 CapEff "$QUIC_CAPABILITIES"
replace_status 101 CapPrm "$QUIC_CAPABILITIES"
expect_failure 'unexpected capability bounding set' "$VERIFY" --timeout-seconds 0
"$VERIFY" --quic-bpf --timeout-seconds 0 > "$TEST_ROOT/stdout"
env NGINX_QUIC_BPF=yes "$VERIFY" --timeout-seconds 0 > "$TEST_ROOT/stdout"
# Keep valid QUIC capabilities and Seccomp=2 in every process. These cases must
# fail because the composed mount barrier is missing, not because filtering or
# CAP_SYS_ADMIN disappeared. Exercise every member, including newer mount APIs.
for missing_syscall in $MOUNT_SYSCALLS; do
    remaining_syscalls=
    for syscall in $MOUNT_SYSCALLS; do
        [ "$syscall" = "$missing_syscall" ] || remaining_syscalls="$remaining_syscalls $syscall"
    done
    expect_failure "does not deny required mount syscalls: $missing_syscall" \
        env TEST_SYSCALL_FILTER="~$remaining_syscalls" "$VERIFY" --quic-bpf --timeout-seconds 0
done
expect_failure 'does not deny required mount syscalls' env TEST_SYSCALL_FILTER='~' "$VERIFY" --quic-bpf --timeout-seconds 0
expect_failure 'must use a SystemCallFilter deny-list' env TEST_SYSCALL_FILTER= "$VERIFY" --quic-bpf --timeout-seconds 0
expect_failure 'must use a SystemCallFilter deny-list' env TEST_SYSCALL_FILTER='@system-service mount' "$VERIFY" --quic-bpf --timeout-seconds 0
expect_failure 'unsupported SystemCallFilter entry' env TEST_SYSCALL_FILTER="~$MOUNT_SYSCALLS mount:0" "$VERIFY" --quic-bpf --timeout-seconds 0
assert_contains "$TEST_ROOT/proc/101/status" "Seccomp:$(printf '\t')2"
assert_contains "$TEST_ROOT/proc/101/status" "CapEff:$(printf '\t')$QUIC_CAPABILITIES"
expect_failure 'must be yes or no' env NGINX_QUIC_BPF=maybe "$VERIFY"
for invalid_value in 00 08 -1 1.5 '1+1'; do
    expect_failure 'canonical decimal integer' "$VERIFY" --timeout-seconds "$invalid_value"
done
expect_failure 'timeout must be from 0 to 300' "$VERIFY" --timeout-seconds 301
expect_failure 'workers must be from 1 to 32767' "$VERIFY" --workers 0

printf 'Validated nginx runtime identity, mask, capability, directory, monotonic-window retry, and start-gate checks with isolated fixtures.\n'
