#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/config-bundle-stat-tests.XXXXXX")

cleanup() {
    if [ -d "$TEST_ROOT" ]; then
        rm -rf -- "$TEST_ROOT"
    fi
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

trap cleanup EXIT HUP INT TERM

mkdir "$TEST_ROOT/gnu-bin" "$TEST_ROOT/bsd-bin"
cat > "$TEST_ROOT/gnu-bin/stat" <<'EOF'
#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

if [ "$#" -eq 3 ] && [ "$1" = -c ] && [ "$2" = %h ]; then
    printf '1\n'
    exit 0
fi

if [ "$#" -eq 3 ] && [ "$1" = -f ] && [ "$2" = %l ]; then
    printf '  File: "%s"\nFilesystem metadata from GNU stat -f\n' "$3"
    exit 1
fi

printf 'unexpected stat invocation:' >&2
printf ' %s' "$@" >&2
printf '\n' >&2
exit 2
EOF
cat > "$TEST_ROOT/bsd-bin/stat" <<'EOF'
#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

if [ "$#" -eq 3 ] && [ "$1" = -c ] && [ "$2" = %h ]; then
    exit 1
fi

if [ "$#" -eq 3 ] && [ "$1" = -f ] && [ "$2" = %l ]; then
    printf '1\n'
    exit 0
fi

printf 'unexpected stat invocation:' >&2
printf ' %s' "$@" >&2
printf '\n' >&2
exit 2
EOF
chmod 0755 "$TEST_ROOT/gnu-bin/stat" "$TEST_ROOT/bsd-bin/stat"

for stat_fixture in "$TEST_ROOT/gnu-bin" "$TEST_ROOT/bsd-bin"
do
    for bundle_builder in \
        "$REPOSITORY_ROOT/mongodb/build-bundle" \
        "$REPOSITORY_ROOT/redis/build-bundle"
    do
        PATH="$stat_fixture:$PATH" "$bundle_builder" --check >/dev/null \
            || fail "bundle builder rejected stat fixture $stat_fixture: $bundle_builder"
    done
done

printf 'Validated GNU-first and BSD-fallback bundle hard-link inspection.\n'
