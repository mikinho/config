#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
ACME_WEBROOT=/var/www/letsencrypt
HTTP_PROBE_ADDRESS=127.0.0.2
NGINX_BINARY=/usr/sbin/nginx
NGINX_CONFIG=/etc/nginx/nginx.conf
NATIVE_CERTBOT=/bin/certbot
SNAP_CERTBOT=/usr/local/bin/certbot
HEALTHCHECK=/usr/local/bin/certbot-healthcheck
CERTBOT_CONFIG_DIR=/etc/letsencrypt
CERTBOT_WORK_DIR=/var/lib/letsencrypt
CERTBOT_LOGS_DIR=/var/log/letsencrypt
SYSTEM_CERTBOT_CONFIG=/etc/letsencrypt/cli.ini
STAGING_ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
PRODUCTION_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

MODE=apply
BACKEND=native
ENVIRONMENT=
EMAIL=
DOMAINS=
PRIMARY_DOMAIN=
STAGING_PASSED=no
SELECTION_OPTIONS=no
PROBE_FILE=

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME --check
  $PROGRAM_NAME --plan --staging|--production --email ADDRESS \
      --domain DNS_NAME [--domain DNS_NAME ...] [--backend native|snap] \
      [--staging-passed]
  sudo $PROGRAM_NAME --staging --email ADDRESS \
      --domain DNS_NAME [--domain DNS_NAME ...] [--backend native|snap]
  sudo $PROGRAM_NAME --production --staging-passed --email ADDRESS \
      --domain DNS_NAME [--domain DNS_NAME ...] [--backend native|snap]

Tests or obtains the first certificate lineage with the repository HTTP-01
webroot. Staging uses Certbot's non-persistent --dry-run. Production requires
an explicit assertion that the same names passed staging. Existing lineages
are never modified; use 'certbot reconfigure' for a managed certificate.
The selected environment pins the corresponding Let's Encrypt ACME endpoint.
Inherited cli.ini files must not contain staging, test-cert, or dry-run settings,
including false values; remove those mode controls from global defaults first.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

cleanup() {
    if [ -n "$PROBE_FILE" ] && [ -f "$PROBE_FILE" ]; then
        rm -f -- "$PROBE_FILE"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

print_command() {
    printf '+'
    for command_argument do
        printf ' %s' "$command_argument"
    done
    printf '\n'
}

validate_dns_name() {
    dns_name=$1
    case "$dns_name" in
        \*.*) fail "wildcard names require a reviewed DNS-01 workflow: $dns_name" ;;
        '' | -* | *- | .* | *. | *..* | *[!A-Za-z0-9.-]*)
            fail "invalid DNS name: $dns_name"
            ;;
    esac
    [ "${#dns_name}" -le 253 ] || fail "DNS name exceeds 253 characters: $dns_name"
    printf '%s\n' "$dns_name" | awk -F. '
        NF < 2 { exit 1 }
        {
            for (label_index = 1; label_index <= NF; label_index++) {
                if (length($label_index) < 1 || length($label_index) > 63 ||
                    $label_index ~ /^-/ || $label_index ~ /-$/) {
                    exit 1
                }
            }
        }
    ' || fail "invalid DNS label in name: $dns_name"
}

append_domain() {
    requested_domain=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    validate_dns_name "$requested_domain"
    if printf '%s\n' "$DOMAINS" | grep -qxF "$requested_domain"; then
        fail "duplicate DNS name: $requested_domain"
    fi
    DOMAINS=$DOMAINS${DOMAINS:+"
"}$requested_domain
    [ -n "$PRIMARY_DOMAIN" ] || PRIMARY_DOMAIN=$requested_domain
}

validate_email() {
    case "$EMAIL" in
        '' | -* | .*@* | *.@* | *@.* | *..* | *[!A-Za-z0-9@._%+-]*)
            fail "invalid ACME account email address: $EMAIL"
            ;;
    esac
    email_local=${EMAIL%%@*}
    email_domain=${EMAIL#*@}
    [ -n "$email_local" ] && [ "$email_domain" != "$EMAIL" ] \
        && [ -n "$email_domain" ] \
        && [ "${email_domain#*@}" = "$email_domain" ] \
        || fail "invalid ACME account email address: $EMAIL"
    validate_dns_name "$email_domain"
}

validate_selection() {
    case "$BACKEND" in
        native | snap) ;;
        *) fail "unsupported Certbot backend: $BACKEND" ;;
    esac
    case "$ENVIRONMENT" in
        staging) ACME_SERVER=$STAGING_ACME_SERVER ;;
        production)
            [ "$STAGING_PASSED" = yes ] \
                || fail "production issuance requires --staging-passed"
            ACME_SERVER=$PRODUCTION_ACME_SERVER
            ;;
        '') fail "select exactly one issuance environment: --staging or --production" ;;
        *) fail "unsupported issuance environment: $ENVIRONMENT" ;;
    esac
    [ -n "$DOMAINS" ] || fail "at least one --domain is required"
    validate_email
}

select_certbot_binary() {
    case "$BACKEND" in
        native) CERTBOT_BINARY=$NATIVE_CERTBOT ;;
        snap) CERTBOT_BINARY=$SNAP_CERTBOT ;;
    esac
}

validate_inherited_config_file() {
    inherited_config=$1
    if [ ! -e "$inherited_config" ] && [ ! -L "$inherited_config" ]; then
        return
    fi
    [ -f "$inherited_config" ] && [ -r "$inherited_config" ] && [ ! -L "$inherited_config" ] \
        || fail "inherited Certbot configuration must be a readable non-symlink file: $inherited_config"
    # ConfigArgParse accepts bare flags, optional -- prefixes, and =, :, or
    # whitespace separators. Reject mode controls regardless of their value:
    # false values and aliases are not reliable overrides of another file.
    # Do not print configuration values, which may contain private settings.
    if LC_ALL=C awk '
        { sub(/\r$/, "") }
        /\r/ { exit 2 }
        /^[[:space:]]*(#|;|\[|---)/ { next }
        /[^[:print:][:space:]]/ { exit 2 }
        /^[[:space:]]*(--)?(staging|test[-_]cert|dry[-_]run)([[:space:]:=]|$)/ { exit 1 }
    ' "$inherited_config"; then
        return
    else
        inherited_status=$?
    fi
    case "$inherited_status" in
        1) fail "remove staging, test-cert, and dry-run settings from inherited Certbot configuration: $inherited_config" ;;
        *) fail "inherited Certbot configuration must use readable ASCII settings with LF or CRLF lines: $inherited_config" ;;
    esac
}

resolve_user_config() {
    # Match Certbot's documented XDG source without accepting paths whose glob
    # or tilde expansion could select files other than the one checked here.
    if [ "${XDG_CONFIG_HOME+x}" = x ]; then
        certbot_user_directory=$XDG_CONFIG_HOME
    else
        [ -n "${HOME:-}" ] || fail "HOME must identify an absolute home directory"
        certbot_user_directory=$HOME/.config
    fi
    case "$certbot_user_directory" in
        /*) ;;
        *) fail "Certbot user configuration directory must be absolute" ;;
    esac
    case "$certbot_user_directory" in
        *\** | *\?* | *\[* | *\]*)
            fail "Certbot user configuration directory must not contain glob characters"
            ;;
    esac
    USER_CERTBOT_CONFIG=$certbot_user_directory/letsencrypt/cli.ini
}

path_identity() {
    # Owner UID and permission bits of the path itself, never of a link target.
    # GNU stat serves the target hosts; the BSD form keeps local tests honest.
    stat -c '%u:%a' "$1" 2>/dev/null || stat -f '%u:%Lp' "$1" 2>/dev/null
}

require_trusted_path() {
    trusted_path=$1
    trusted_kind=$2
    trusted_identity=$(path_identity "$trusted_path") \
        || fail "cannot inspect inherited Certbot configuration $trusted_kind: $trusted_path"
    trusted_owner=${trusted_identity%%:*}
    trusted_mode=${trusted_identity#*:}
    case "$trusted_mode" in
        [0-7][0-7][0-7] | [0-7][0-7][0-7][0-7]) ;;
        *) fail "cannot interpret inherited Certbot configuration $trusted_kind mode: $trusted_path" ;;
    esac
    [ "$trusted_owner" = 0 ] \
        || fail "inherited Certbot configuration $trusted_kind must be owned by root: $trusted_path"
    [ "$((0$trusted_mode & 0022))" -eq 0 ] \
        || fail "inherited Certbot configuration $trusted_kind must not be writable by group or other: $trusted_path"
}

require_trusted_configuration_source() {
    inherited_source=$1
    if [ ! -e "$inherited_source" ] && [ ! -L "$inherited_source" ]; then
        return
    fi
    # Certbot runs here as root and executes any pre-, post-, or deploy-hook a
    # default file names, so only a file no other account can write or replace
    # is a trusted default. That includes every directory above it: a writable
    # ancestor lets its owner swap the file between this check and Certbot's
    # read, whatever the file's own ownership says.
    [ -f "$inherited_source" ] && [ ! -L "$inherited_source" ] \
        || fail "inherited Certbot configuration must be a regular file, not a symbolic link: $inherited_source"
    require_trusted_path "$inherited_source" file
    inherited_parent=${inherited_source%/*}
    while [ -n "$inherited_parent" ]; do
        [ -d "$inherited_parent" ] && [ ! -L "$inherited_parent" ] \
            || fail "inherited Certbot configuration ancestor must be a real directory: $inherited_parent"
        require_trusted_path "$inherited_parent" directory
        inherited_parent=${inherited_parent%/*}
    done
}

validate_inherited_config() {
    resolve_user_config
    # Establish who controls each default file before reading its content.
    for inherited_config_path in "$SYSTEM_CERTBOT_CONFIG" "$USER_CERTBOT_CONFIG"; do
        require_trusted_configuration_source "$inherited_config_path"
        validate_inherited_config_file "$inherited_config_path"
    done
}

run_certbot() {
    validate_inherited_config
    "$CERTBOT_BINARY" "$@"
}

build_certbot_command() {
    set -- \
        certonly \
        --non-interactive \
        --agree-tos \
        --email "$EMAIL" \
        --cert-name "$PRIMARY_DOMAIN" \
        --webroot \
        --webroot-path "$ACME_WEBROOT" \
        --preferred-challenges http \
        --server "$ACME_SERVER" \
        --config-dir "$CERTBOT_CONFIG_DIR" \
        --work-dir "$CERTBOT_WORK_DIR" \
        --logs-dir "$CERTBOT_LOGS_DIR"
    for issuance_domain in $DOMAINS; do
        set -- "$@" --domain "$issuance_domain"
    done
    if [ "$ENVIRONMENT" = staging ]; then
        set -- "$@" --dry-run
    fi
    run_certbot "$@"
}

print_certbot_command() {
    set -- \
        "$CERTBOT_BINARY" \
        certonly \
        --non-interactive \
        --agree-tos \
        --email "$EMAIL" \
        --cert-name "$PRIMARY_DOMAIN" \
        --webroot \
        --webroot-path "$ACME_WEBROOT" \
        --preferred-challenges http \
        --server "$ACME_SERVER" \
        --config-dir "$CERTBOT_CONFIG_DIR" \
        --work-dir "$CERTBOT_WORK_DIR" \
        --logs-dir "$CERTBOT_LOGS_DIR"
    for issuance_domain in $DOMAINS; do
        set -- "$@" --domain "$issuance_domain"
    done
    if [ "$ENVIRONMENT" = staging ]; then
        set -- "$@" --dry-run
    fi
    print_command "$@"
}

validate_certbot_binary() {
    [ -x "$CERTBOT_BINARY" ] || fail "Certbot binary is missing: $CERTBOT_BINARY"
    case "$BACKEND" in
        native)
            case $(readlink -f "$CERTBOT_BINARY" 2>/dev/null || true) in
                /snap/*) fail "native Certbot binary resolves to the Snap launcher" ;;
            esac
            ;;
        snap)
            [ -L "$CERTBOT_BINARY" ] \
                && [ "$(readlink "$CERTBOT_BINARY")" = /snap/bin/certbot ] \
                || fail "$CERTBOT_BINARY is not the expected Certbot Snap link"
            ;;
    esac
}

validate_live_host() {
    [ "$(id -u)" -eq 0 ] || fail "run as root or use --plan"
    for required_command in awk curl install mktemp readlink systemctl tr; do
        command -v "$required_command" >/dev/null 2>&1 \
            || fail "required command not found: $required_command"
    done
    validate_certbot_binary
    [ -x "$NGINX_BINARY" ] || fail "nginx binary is missing: $NGINX_BINARY"
    [ -f "$NGINX_CONFIG" ] && [ ! -L "$NGINX_CONFIG" ] \
        || fail "nginx configuration must be a regular file: $NGINX_CONFIG"
    [ -d "$ACME_WEBROOT" ] && [ ! -L "$ACME_WEBROOT" ] \
        || fail "ACME webroot must be a real directory: $ACME_WEBROOT"
    [ ! -e "$CERTBOT_CONFIG_DIR/renewal/$PRIMARY_DOMAIN.conf" ] \
        && [ ! -L "$CERTBOT_CONFIG_DIR/renewal/$PRIMARY_DOMAIN.conf" ] \
        || fail "certificate lineage already exists; use certbot reconfigure: $PRIMARY_DOMAIN"
    systemctl is-active --quiet nginx.service \
        || fail "nginx.service must be active for HTTP-01 validation"
    "$NGINX_BINARY" -t -q -c "$NGINX_CONFIG" \
        || fail "nginx configuration failed before HTTP-01 validation"
}

verify_local_webroot() {
    challenge_directory=$ACME_WEBROOT/.well-known/acme-challenge
    install -d -o root -g nginx -m 0755 "$challenge_directory"
    PROBE_FILE=$(mktemp "$challenge_directory/config-probe.XXXXXX")
    chmod 0644 "$PROBE_FILE"
    probe_name=${PROBE_FILE##*/}
    probe_token=config-certbot-webroot-$probe_name
    printf '%s\n' "$probe_token" > "$PROBE_FILE"
    if command -v restorecon >/dev/null 2>&1; then
        restorecon "$PROBE_FILE"
    fi
    for probe_domain in $DOMAINS; do
        probe_response=$(curl \
            --fail \
            --noproxy '*' \
            --silent \
            --show-error \
            --max-time 10 \
            --resolve "$probe_domain:80:$HTTP_PROBE_ADDRESS" \
            "http://$probe_domain/.well-known/acme-challenge/$probe_name") \
            || fail "nginx did not serve the local HTTP-01 probe for $probe_domain"
        [ "$probe_response" = "$probe_token" ] \
            || fail "nginx returned unexpected HTTP-01 content for $probe_domain"
    done
    rm -f -- "$PROBE_FILE"
    PROBE_FILE=
}

print_plan() {
    printf 'Certbot first-lineage plan: environment=%s, backend=%s, primary=%s\n' \
        "$ENVIRONMENT" "$BACKEND" "$PRIMARY_DOMAIN"
    printf '+ require root-owned, non-writable system and user cli.ini defaults with root-controlled ancestors\n'
    printf '+ reject staging, test-cert, and dry-run directives in system and user cli.ini defaults before Certbot runs\n'
    printf '+ verify active nginx serves %s/.well-known/acme-challenge/ through %s for every requested name\n' \
        "$ACME_WEBROOT" "$HTTP_PROBE_ADDRESS"
    print_certbot_command
    if [ "$ENVIRONMENT" = production ]; then
        print_command \
            "$CERTBOT_BINARY" renew --cert-name "$PRIMARY_DOMAIN" --dry-run \
            --no-random-sleep-on-renew --server "$STAGING_ACME_SERVER" \
            --config-dir "$CERTBOT_CONFIG_DIR" --work-dir "$CERTBOT_WORK_DIR" \
            --logs-dir "$CERTBOT_LOGS_DIR"
        print_command "$HEALTHCHECK"
    fi
    printf 'Plan complete; no certificate or host state was changed.\n'
}

issue_certificate() {
    validate_live_host
    validate_inherited_config
    verify_local_webroot
    build_certbot_command
    if [ "$ENVIRONMENT" = production ]; then
        run_certbot renew --cert-name "$PRIMARY_DOMAIN" --dry-run \
            --no-random-sleep-on-renew --server "$STAGING_ACME_SERVER" \
            --config-dir "$CERTBOT_CONFIG_DIR" --work-dir "$CERTBOT_WORK_DIR" \
            --logs-dir "$CERTBOT_LOGS_DIR"
        [ -x "$HEALTHCHECK" ] \
            || fail "certificate healthcheck is missing: $HEALTHCHECK"
        "$HEALTHCHECK"
        printf 'Issued and renewal-tested production certificate lineage: %s\n' \
            "$PRIMARY_DOMAIN"
    else
        printf 'Staging validation passed for: %s\n' \
            "$(printf '%s' "$DOMAINS" | tr '\n' ' ')"
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend)
            [ "$#" -ge 2 ] || fail "--backend requires native or snap"
            BACKEND=$2
            SELECTION_OPTIONS=yes
            shift 2
            ;;
        --check)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --domain)
            [ "$#" -ge 2 ] || fail "--domain requires a DNS name"
            append_domain "$2"
            SELECTION_OPTIONS=yes
            shift 2
            ;;
        --email)
            [ "$#" -ge 2 ] || fail "--email requires an address"
            EMAIL=$2
            SELECTION_OPTIONS=yes
            shift 2
            ;;
        --plan)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --production)
            [ -z "$ENVIRONMENT" ] || fail "select exactly one issuance environment"
            ENVIRONMENT=production
            SELECTION_OPTIONS=yes
            shift
            ;;
        --staging)
            [ -z "$ENVIRONMENT" ] || fail "select exactly one issuance environment"
            ENVIRONMENT=staging
            SELECTION_OPTIONS=yes
            shift
            ;;
        --staging-passed)
            STAGING_PASSED=yes
            SELECTION_OPTIONS=yes
            shift
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

if [ "$MODE" = check ]; then
    [ "$SELECTION_OPTIONS" = no ] \
        || fail "--check does not accept issuance options"
    printf 'Validated Certbot first-lineage issuance helper.\n'
    exit 0
fi

validate_selection
select_certbot_binary
case "$MODE" in
    plan) print_plan ;;
    apply) issue_certificate ;;
esac
