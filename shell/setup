#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PROMPT_SOURCE=$SCRIPT_DIRECTORY/profile.d/70-managed-environment-prompt.sh
UMASK_SOURCE=$SCRIPT_DIRECTORY/profile.d/80-admin-umask.sh
HISTORY_SOURCE=$SCRIPT_DIRECTORY/profile.d/90-no-persistent-history.sh
TARGET_DIRECTORY=/etc/profile.d
ENVIRONMENT_TARGET=/etc/managed-environment
PROMPT_TARGET=$TARGET_DIRECTORY/70-managed-environment-prompt.sh
UMASK_TARGET=$TARGET_DIRECTORY/80-admin-umask.sh
HISTORY_TARGET=$TARGET_DIRECTORY/90-no-persistent-history.sh

MODE=apply
ENVIRONMENT=
REPLACED_POLICY=
SCRATCH_DIRECTORY=
ROLLBACK_REQUIRED=no

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME --check
  $PROGRAM_NAME --plan --environment PROD|TEST|DEV \
      [--replace /etc/profile.d/OLD.sh]
  sudo $PROGRAM_NAME --environment PROD|TEST|DEV \
      [--replace /etc/profile.d/OLD.sh]

Installs the interactive Bash policies that enforce an administrative umask of
at least 027, retain history only for the active session, and show a trusted
host classification in the prompt. --environment is required rather than
guessing from the hostname. Existing history files are not removed; review
their retention separately. --replace atomically retires one explicitly named
legacy history fragment after validating its path.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

validate_source() {
    for policy_source in "$PROMPT_SOURCE" "$UMASK_SOURCE" "$HISTORY_SOURCE"; do
        [ -f "$policy_source" ] && [ ! -L "$policy_source" ] \
            || fail "repository source must be a regular file: $policy_source"
    done
    command -v bash >/dev/null 2>&1 \
        || fail "bash is required to validate the shell policy"
    bash --noprofile --norc -n \
        "$PROMPT_SOURCE" "$UMASK_SOURCE" "$HISTORY_SOURCE" \
        || fail "repository shell policies failed Bash syntax validation"

    bash --noprofile --norc -c '
        PS1=unchanged
        . "$1"
        [ "$PS1" = unchanged ]
    ' sh "$PROMPT_SOURCE" \
        || fail "repository prompt policy changed a non-interactive shell"

    bash --noprofile --norc -c '
        umask 0022
        . "$1"
        [ "$(umask)" = 0022 ]
    ' sh "$UMASK_SOURCE" \
        || fail "repository umask policy changed a non-interactive shell"

    for umask_case in 0002:0027 0022:0027 0027:0027 0037:0037 0077:0077; do
        initial_umask=${umask_case%:*}
        expected_umask=${umask_case#*:}
        bash --noprofile --norc -ic '
            umask "$2"
            . "$1"
            [ "$(umask)" = "$3" ]
        ' sh "$UMASK_SOURCE" "$initial_umask" "$expected_umask" \
            >/dev/null 2>&1 \
            || fail "repository umask policy failed $initial_umask to $expected_umask"
    done

    bash --noprofile --norc -c '
        HISTFILE=/tmp/config-noninteractive-history
        HISTSIZE=73
        . "$1"
        [ "$HISTFILE" = /tmp/config-noninteractive-history ]
        [ "$HISTSIZE" = 73 ]
    ' sh "$HISTORY_SOURCE" \
        || fail "repository shell policy changed a non-interactive shell"

    bash --noprofile --norc -ic '
        HISTFILE=/tmp/config-interactive-history
        HISTSIZE=73
        . "$1"
        [ "$HISTFILE" = /dev/null ]
        [ "$HISTSIZE" = 73 ]
        readonly -p HISTFILE >/dev/null 2>&1
    ' sh "$HISTORY_SOURCE" >/dev/null 2>&1 \
        || fail "repository shell policy does not enforce non-persistent interactive history"
}

validate_target() {
    if [ ! -d "$TARGET_DIRECTORY" ] || [ -L "$TARGET_DIRECTORY" ]; then
        fail "shell policy target must be a real directory: $TARGET_DIRECTORY"
    fi
    target_directory_identity=$(stat -Lc '%U:%G:%a' "$TARGET_DIRECTORY" 2>/dev/null) \
        || fail "cannot inspect shell policy target: $TARGET_DIRECTORY"
    [ "$target_directory_identity" = root:root:755 ] \
        || fail "$TARGET_DIRECTORY must be owned by root:root with mode 0755"
    for policy_target in \
        "$ENVIRONMENT_TARGET" \
        "$PROMPT_TARGET" \
        "$UMASK_TARGET" \
        "$HISTORY_TARGET"
    do
        if [ -e "$policy_target" ] || [ -L "$policy_target" ]; then
            [ -f "$policy_target" ] && [ ! -L "$policy_target" ] \
                || fail "shell policy target must be a regular file: $policy_target"
        fi
    done
}

validate_environment() {
    case "$ENVIRONMENT" in
        PROD | TEST | DEV) ;;
        '') fail "--environment PROD|TEST|DEV is required" ;;
        *) fail "unsupported managed environment: $ENVIRONMENT" ;;
    esac
}

validate_replacement_path() {
    [ -n "$REPLACED_POLICY" ] || return 0
    case "$REPLACED_POLICY" in
        /etc/profile.d/*) replacement_name=${REPLACED_POLICY#/etc/profile.d/} ;;
        *) fail "replacement must name one .sh file directly under /etc/profile.d" ;;
    esac
    case "$replacement_name" in
        '' | .* | -* | */* | *[!A-Za-z0-9._-]*)
            fail "replacement must name one .sh file directly under /etc/profile.d"
            ;;
        *.sh) ;;
        *) fail "replacement must name one .sh file directly under /etc/profile.d" ;;
    esac
    [ "$REPLACED_POLICY" != "$UMASK_TARGET" ] \
        && [ "$REPLACED_POLICY" != "$PROMPT_TARGET" ] \
        && [ "$REPLACED_POLICY" != "$HISTORY_TARGET" ] \
        || fail "replacement policy must differ from the managed targets"
}

validate_replaced_policy() {
    [ -n "$REPLACED_POLICY" ] || return 0
    validate_replacement_path
    if [ -e "$REPLACED_POLICY" ] || [ -L "$REPLACED_POLICY" ]; then
        [ -f "$REPLACED_POLICY" ] && [ ! -L "$REPLACED_POLICY" ] \
            || fail "replacement policy must be a regular file: $REPLACED_POLICY"
        replaced_identity=$(stat -Lc '%U:%G:%a' "$REPLACED_POLICY" 2>/dev/null) \
            || fail "cannot inspect replacement policy: $REPLACED_POLICY"
        [ "$replaced_identity" = root:root:644 ] \
            || fail "replacement policy has unsafe ownership or mode: $replaced_identity"
    fi
}

backup_file() {
    backup_target=$1
    backup_name=$2
    if [ -f "$backup_target" ]; then
        cp "$backup_target" "$SCRATCH_DIRECTORY/$backup_name"
        : > "$SCRATCH_DIRECTORY/$backup_name.present"
    fi
}

restore_file() {
    restore_target=$1
    restore_name=$2
    if [ -f "$SCRATCH_DIRECTORY/$restore_name.present" ]; then
        install -o root -g root -m 0644 \
            "$SCRATCH_DIRECTORY/$restore_name" "$restore_target"
        command -v restorecon >/dev/null 2>&1 && restorecon -F "$restore_target"
    else
        rm -f -- "$restore_target"
    fi
}

rollback_policy() {
    [ -n "$SCRATCH_DIRECTORY" ] && [ -d "$SCRATCH_DIRECTORY" ] || return 0
    restore_file "$ENVIRONMENT_TARGET" managed-environment
    restore_file "$PROMPT_TARGET" managed-prompt.sh
    restore_file "$UMASK_TARGET" managed-umask.sh
    restore_file "$HISTORY_TARGET" managed-history.sh
    if [ -n "$REPLACED_POLICY" ]; then
        restore_file "$REPLACED_POLICY" replaced-policy.sh
    fi
    ROLLBACK_REQUIRED=no
}

cleanup() {
    if [ "$ROLLBACK_REQUIRED" = yes ]; then
        rollback_policy
    fi
    if [ -n "$SCRATCH_DIRECTORY" ] && [ -d "$SCRATCH_DIRECTORY" ]; then
        rm -rf -- "$SCRATCH_DIRECTORY"
    fi
}

trap cleanup EXIT HUP INT TERM

validate_login_behavior() {
    # Expand history variables inside the clean child shells, not this setup.
    # shellcheck disable=SC2016
    env -u HISTFILE -u HISTSIZE -u HISTFILESIZE \
        "EXPECTED_MANAGED_ENVIRONMENT=$ENVIRONMENT" bash -lic '
        [ "${HISTFILE:-}" = /dev/null ] || exit 1
        [ "${HISTSIZE:-0}" -gt 0 ] 2>/dev/null || exit 1
        readonly -p HISTFILE >/dev/null 2>&1 || exit 1
        managed_login_umask=$(umask)
        managed_login_umask=${managed_login_umask#0}
        [ "$((8#$managed_login_umask & 8#027))" -eq "$((8#027))" ] || exit 1
        unset managed_login_umask
        managed_expected_prompt_path="\\u@\\h:\\w"
        case "$PS1" in
            *"[$EXPECTED_MANAGED_ENVIRONMENT"*"$managed_expected_prompt_path"*) ;;
            *) exit 1 ;;
        esac
        if [ "$EXPECTED_MANAGED_ENVIRONMENT" = PROD ] && [ "$EUID" -eq 0 ]; then
            case "$PS1" in *'[PROD ROOT]'*) ;; *) exit 1 ;; esac
        fi
        bash -ic "
            [ \"\${HISTFILE:-}\" = /dev/null ] || exit 1
            [ \"\${HISTSIZE:-0}\" -gt 0 ] 2>/dev/null || exit 1
            managed_child_umask=\$(umask)
            managed_child_umask=\${managed_child_umask#0}
            [ \"\$((8#\$managed_child_umask & 8#027))\" -eq \"\$((8#027))\" ]
        " >/dev/null 2>&1
    ' >/dev/null 2>&1 \
        || fail "a new Bash login or interactive descendant does not enforce the shell baseline"
}

install_policy() {
    [ "$(id -u)" -eq 0 ] || fail "run as root or use --plan"
    for required_command in bash cmp cp env install mktemp rm stat wc; do
        command -v "$required_command" >/dev/null 2>&1 \
            || fail "required command not found: $required_command"
    done
    validate_target
    validate_replaced_policy

    SCRATCH_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/config-shell-setup.XXXXXX")
    backup_file "$ENVIRONMENT_TARGET" managed-environment
    backup_file "$PROMPT_TARGET" managed-prompt.sh
    backup_file "$UMASK_TARGET" managed-umask.sh
    backup_file "$HISTORY_TARGET" managed-history.sh
    if [ -n "$REPLACED_POLICY" ]; then
        backup_file "$REPLACED_POLICY" replaced-policy.sh
    fi
    ROLLBACK_REQUIRED=yes
    if [ -n "$REPLACED_POLICY" ]; then
        rm -f -- "$REPLACED_POLICY"
    fi
    printf '%s\n' "$ENVIRONMENT" > "$SCRATCH_DIRECTORY/managed-environment.new"
    install -o root -g root -m 0644 \
        "$SCRATCH_DIRECTORY/managed-environment.new" "$ENVIRONMENT_TARGET"
    install -o root -g root -m 0644 "$PROMPT_SOURCE" "$PROMPT_TARGET"
    install -o root -g root -m 0644 "$UMASK_SOURCE" "$UMASK_TARGET"
    install -o root -g root -m 0644 "$HISTORY_SOURCE" "$HISTORY_TARGET"
    if command -v restorecon >/dev/null 2>&1; then
        restorecon -F \
            "$ENVIRONMENT_TARGET" \
            "$PROMPT_TARGET" \
            "$UMASK_TARGET" \
            "$HISTORY_TARGET"
    fi
    for policy_pair in \
        "$SCRATCH_DIRECTORY/managed-environment.new:$ENVIRONMENT_TARGET" \
        "$PROMPT_SOURCE:$PROMPT_TARGET" \
        "$UMASK_SOURCE:$UMASK_TARGET" \
        "$HISTORY_SOURCE:$HISTORY_TARGET"
    do
        policy_source=${policy_pair%%:*}
        policy_target=${policy_pair#*:}
        cmp -s "$policy_source" "$policy_target" \
            || fail "installed shell policy differs from repository source: $policy_target"
        policy_identity=$(stat -Lc '%U:%G:%a' "$policy_target" 2>/dev/null) \
            || fail "cannot inspect installed shell policy: $policy_target"
        [ "$policy_identity" = root:root:644 ] \
            || fail "installed shell policy has unsafe ownership or mode: $policy_identity"
    done
    validate_login_behavior
    ROLLBACK_REQUIRED=no
    printf 'Installed managed host classification: %s (%s)\n' \
        "$ENVIRONMENT_TARGET" "$ENVIRONMENT"
    printf 'Installed environment-aware Bash prompt: %s\n' "$PROMPT_TARGET"
    printf 'Installed administrative Bash umask policy: %s\n' "$UMASK_TARGET"
    printf 'Installed non-persistent Bash history policy: %s\n' "$HISTORY_TARGET"
    if [ -n "$REPLACED_POLICY" ]; then
        printf 'Replaced legacy shell policy: %s\n' "$REPLACED_POLICY"
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --plan)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --environment)
            [ "$#" -ge 2 ] || fail "--environment requires PROD, TEST, or DEV"
            [ -z "$ENVIRONMENT" ] || fail "--environment may be specified only once"
            ENVIRONMENT=$2
            shift 2
            ;;
        --replace)
            [ "$#" -ge 2 ] || fail "--replace requires a profile path"
            [ -z "$REPLACED_POLICY" ] || fail "--replace may be specified only once"
            REPLACED_POLICY=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

validate_source
if [ "$MODE" = check ] && { [ -n "$REPLACED_POLICY" ] || [ -n "$ENVIRONMENT" ]; }; then
    fail "--check does not accept deployment selections"
fi
if [ -n "$REPLACED_POLICY" ]; then
    validate_replacement_path
fi

case "$MODE" in
    check)
        printf 'Validated environment prompt, administrative umask, and history behavior.\n'
        ;;
    plan)
        validate_environment
        if [ -n "$REPLACED_POLICY" ]; then
            printf '+ backup %s for rollback\n' "$REPLACED_POLICY"
            printf '+ rm -f -- %s\n' "$REPLACED_POLICY"
        fi
        printf '+ write exact classification %s to %s as root:root mode 0644\n' \
            "$ENVIRONMENT" "$ENVIRONMENT_TARGET"
        printf '+ install -o root -g root -m 0644 %s %s\n' \
            "$PROMPT_SOURCE" "$PROMPT_TARGET"
        printf '+ install -o root -g root -m 0644 %s %s\n' \
            "$UMASK_SOURCE" "$UMASK_TARGET"
        printf '+ install -o root -g root -m 0644 %s %s\n' \
            "$HISTORY_SOURCE" "$HISTORY_TARGET"
        printf '+ restorecon -F %s %s %s %s\n' \
            "$ENVIRONMENT_TARGET" "$PROMPT_TARGET" "$UMASK_TARGET" "$HISTORY_TARGET"
        printf '+ bash -lic <verify environment prompt, umask, and history>\n'
        printf 'Plan complete; no host changes were made.\n'
        ;;
    apply)
        validate_environment
        install_policy
        ;;
esac
