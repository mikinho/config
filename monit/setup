#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
MAIN_TEMPLATE=$SCRIPT_DIRECTORY/templates/monitrc.in
SYSTEM_SOURCE=$SCRIPT_DIRECTORY/conf.d/10-system.conf
LOGROTATE_SOURCE=$SCRIPT_DIRECTORY/logrotate/monit
SYSTEMD_SOURCE=$SCRIPT_DIRECTORY/systemd/monit.service.conf
VERIFIER_SOURCE=$SCRIPT_DIRECTORY/verify
SECURITY_LIBRARY=$SCRIPT_DIRECTORY/lib/security.sh

MONIT_MAIN=/etc/monitrc
MONIT_FRAGMENT_DIRECTORY=/etc/monit.d
SYSTEM_TARGET=$MONIT_FRAGMENT_DIRECTORY/10-system.conf
LOGROTATE_TARGET=/etc/logrotate.d/monit
SYSTEMD_DIRECTORY=/etc/systemd/system/monit.service.d
SYSTEMD_TARGET=$SYSTEMD_DIRECTORY/10-baseline.conf
MONIT_LOG_DIRECTORY=/var/log/monit
MONIT_STATE_DIRECTORY=/var/lib/monit
MONIT_RUNTIME_DIRECTORY=/run/monit
LIVE_INCLUDE_GLOB='/etc/monit.d/*.conf'
MANAGED_MARKER='Managed by mikinho/config monit/setup.'
BACKUP_ROOT=/var/lib/config-monit/backups

MODE=apply
OUTPUT_DIRECTORY=
FRAGMENT_SOURCES=
FRAGMENT_NAMES=
REPLACE_MAIN=no
TEMPORARY_DIRECTORY=
BACKUP_DIRECTORY=
BACKED_UP_TARGETS=
CHANGES_STARTED=no
TRANSACTION_COMMITTED=no
SERVICE_WAS_ACTIVE=no
SERVICE_WAS_ENABLED=no
SERVICE_RESTART_REQUIRED=no
PENDING_STAGE=

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME --check
  $PROGRAM_NAME --output DIRECTORY [--fragment FILE ...]
  $PROGRAM_NAME --plan [--fragment FILE ...] [--replace-main]
  sudo $PROGRAM_NAME [--fragment FILE ...] [--replace-main]

Renders or applies the client-neutral Monit baseline. --fragment installs a
deployment-specific root-only *.conf file by basename. Existing *.conf files
not named by this command are preserved. A modified unmanaged /etc/monitrc is
never replaced unless --replace-main explicitly records an adoption decision.
Setup validates an assembled candidate before activation. Configuration-only
updates reload Monit; changed systemd execution policy or a stale process umask
requires a controlled Monit restart. Root-only transaction backups are retained.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

append_line() {
    existing_lines=$1
    appended_line=$2
    printf '%s' "$existing_lines${existing_lines:+
}$appended_line"
}

validate_source() {
    setup_source=$1
    [ -f "$setup_source" ] && [ ! -L "$setup_source" ] \
        || fail "repository dependency must be a regular file: $setup_source"
}

require_unspaced_path() {
    # Fragment lists are newline-delimited and later word-split, so any
    # whitespace, including an embedded newline, must be rejected as a whole
    # string rather than line by line.
    case "$2" in
        *[[:space:]]*) fail "$1 must not contain whitespace: $2" ;;
    esac
}

validate_fragment_source() {
    fragment_source=$1
    # Validate the name before anything reads the file, so the content check
    # only ever runs on a path that is already safe to list and copy.
    validate_source "$fragment_source"
    require_unspaced_path 'fragment paths' "$fragment_source"
    fragment_name=${fragment_source##*/}
    case "$fragment_name" in
        10-system.conf)
            fail "fragment name is reserved by the baseline: $fragment_name"
            ;;
        '' | .* | *[!A-Za-z0-9_.-]* | *.conf.conf)
            fail "invalid fragment basename: $fragment_name"
            ;;
        *.conf) ;;
        *) fail "fragment basename must end in .conf: $fragment_name" ;;
    esac
    if printf '%s\n' "$FRAGMENT_NAMES" | grep -Fx "$fragment_name" >/dev/null 2>&1; then
        fail "duplicate fragment basename: $fragment_name"
    fi
    monit_require_flat_fragment "$fragment_source"
    FRAGMENT_SOURCES=$(append_line "$FRAGMENT_SOURCES" "$fragment_source")
    FRAGMENT_NAMES=$(append_line "$FRAGMENT_NAMES" "$fragment_name")
}

validate_template_contract() {
    [ "$(grep -Fxc '    allow admin:@@CONTROL_PASSWORD@@' "$MAIN_TEMPLATE" || true)" -eq 1 ] \
        || fail "main template must contain exactly one control-password token"
    [ "$(grep -Fxc 'include @@INCLUDE_GLOB@@' "$MAIN_TEMPLATE" || true)" -eq 1 ] \
        || fail "main template must contain exactly one include-glob token"
    if grep -F 'admin:monit' "$MAIN_TEMPLATE" >/dev/null 2>&1; then
        fail "main template contains the package default credential"
    fi
}

generate_control_password() {
    generated_password=$(openssl rand -hex 32) \
        || fail "cannot generate the local control password"
    printf '%s\n' "$generated_password" | grep -Eq '^[0-9a-f]{64}$' \
        || fail "OpenSSL returned an invalid control password"
    printf '%s\n' "$generated_password"
}

existing_control_password() {
    [ -f "$MONIT_MAIN" ] && [ ! -L "$MONIT_MAIN" ] || return 1
    grep -F "$MANAGED_MARKER" "$MONIT_MAIN" >/dev/null 2>&1 || return 1
    preserved_password=$(awk '
        $1 == "allow" && $2 ~ /^admin:[0-9a-f]+$/ {
            sub(/^admin:/, "", $2)
            print $2
        }
    ' "$MONIT_MAIN")
    printf '%s\n' "$preserved_password" | grep -Eq '^[0-9a-f]{64}$' \
        || return 1
    [ "$(printf '%s\n' "$preserved_password" | wc -l | tr -d ' ')" -eq 1 ] \
        || return 1
    printf '%s\n' "$preserved_password"
}

render_main() {
    rendered_target=$1
    rendered_include_glob=$2
    rendered_password=$3
    awk -v include_glob="$rendered_include_glob" \
        -v control_password="$rendered_password" '
        $0 == "    allow admin:@@CONTROL_PASSWORD@@" {
            print "    allow admin:" control_password
            next
        }
        $0 == "include @@INCLUDE_GLOB@@" {
            print "include " include_glob
            next
        }
        { print }
    ' "$MAIN_TEMPLATE" > "$rendered_target"
    if grep -F '@@' "$rendered_target" >/dev/null 2>&1; then
        fail "main render retained an unresolved template token"
    fi
    chmod 0600 "$rendered_target"
}

copy_existing_fragments() {
    staged_fragment_directory=$1
    [ -e "$MONIT_FRAGMENT_DIRECTORY" ] || return 0
    [ -d "$MONIT_FRAGMENT_DIRECTORY" ] && [ ! -L "$MONIT_FRAGMENT_DIRECTORY" ] \
        || fail "live fragment path must be a real directory"
    unsafe_fragment=$(find "$MONIT_FRAGMENT_DIRECTORY" \
        -mindepth 1 -maxdepth 1 -name '*.conf' ! -type f -print -quit)
    [ -z "$unsafe_fragment" ] \
        || fail "live Monit fragment must be a regular file: $unsafe_fragment"
    live_fragment_paths=$(find "$MONIT_FRAGMENT_DIRECTORY" \
        -mindepth 1 -maxdepth 1 -type f -name '*.conf' -print) \
        || fail "cannot enumerate the live Monit fragments"
    printf '%s\n' "$live_fragment_paths" | while IFS= read -r live_fragment; do
            [ -n "$live_fragment" ] || continue
            # An explicit --fragment replaces/adopts this basename from the
            # validated staged source; never load its untrusted live original.
            if [ "${live_fragment##*/}" = 10-system.conf ] \
                || printf '%s\n' "$FRAGMENT_NAMES" \
                    | grep -Fx "${live_fragment##*/}" >/dev/null 2>&1
            then
                continue
            fi
            monit_require_private_fragment "$live_fragment"
            install -m 0600 "$live_fragment" \
                "$staged_fragment_directory/${live_fragment##*/}"
        done
}

copy_requested_fragments() {
    staged_fragment_directory=$1
    for fragment_source in $FRAGMENT_SOURCES; do
        fragment_name=${fragment_source##*/}
        install -m 0600 "$fragment_source" \
            "$staged_fragment_directory/$fragment_name"
    done
}

render_validation_main() {
    validation_source=$1
    validation_target=$2
    validation_runtime_root=$3
    awk -v runtime_root="$validation_runtime_root" '
        $0 == "set log /var/log/monit/monit.log" {
            print "set log " runtime_root "/log/monit.log"
            next
        }
        $0 == "set pidfile /run/monit/monit.pid" {
            print "set pidfile " runtime_root "/run/monit.pid"
            next
        }
        $0 == "set idfile /var/lib/monit/id" {
            print "set idfile " runtime_root "/state/id"
            next
        }
        $0 == "set statefile /var/lib/monit/state" {
            print "set statefile " runtime_root "/state/state"
            next
        }
        $0 == "    basedir /var/lib/monit/events" {
            print "    basedir " runtime_root "/state/events"
            next
        }
        { print }
    ' "$validation_source" > "$validation_target"
    chmod 0600 "$validation_target"
}

wait_for_control_plane() {
    control_attempt=1
    while [ "$control_attempt" -le 75 ]; do
        if monit -c "$MONIT_MAIN" summary >/dev/null 2>&1; then
            return 0
        fi
        [ "$control_attempt" -lt 75 ] || break
        sleep 1
        control_attempt=$((control_attempt + 1))
    done
    return 1
}

validate_candidate() {
    candidate_main=$1
    candidate_logrotate=$2
    candidate_main_mode=$(stat -c '%a' "$candidate_main" 2>/dev/null \
        || stat -f '%Lp' "$candidate_main")
    [ "$candidate_main_mode" = 600 ] \
        || fail "candidate main control file must be mode 0600"
    if command -v monit >/dev/null 2>&1; then
        candidate_runtime_root=$TEMPORARY_DIRECTORY/validation-runtime
        install -d -m 0700 "$candidate_runtime_root/log" \
            "$candidate_runtime_root/run" "$candidate_runtime_root/state/events"
        candidate_validation_main=$TEMPORARY_DIRECTORY/validation-monitrc
        render_validation_main "$candidate_main" "$candidate_validation_main" \
            "$candidate_runtime_root"
        monit -t -c "$candidate_validation_main" >/dev/null \
            || fail "Monit rejected the assembled candidate control tree"
    elif [ "$MODE" = apply ]; then
        fail "required command not found: monit"
    fi
    if command -v logrotate >/dev/null 2>&1; then
        logrotate --debug "$candidate_logrotate" >/dev/null 2>&1 \
            || fail "logrotate rejected the candidate policy"
    elif [ "$MODE" = apply ]; then
        fail "required command not found: logrotate"
    fi
}

prepare_candidate() {
    candidate_root=$1
    candidate_password=$2
    candidate_include_glob=$candidate_root/etc/monit.d/'*.conf'
    install -d -m 0700 "$candidate_root/etc/monit.d"
    install -d -m 0700 "$candidate_root/etc/logrotate.d"
    install -d -m 0700 "$candidate_root/etc/systemd/system/monit.service.d"
    if [ "$MODE" = apply ]; then
        copy_existing_fragments "$candidate_root/etc/monit.d"
    fi
    install -m 0600 "$SYSTEM_SOURCE" "$candidate_root/etc/monit.d/10-system.conf"
    copy_requested_fragments "$candidate_root/etc/monit.d"
    install -m 0644 "$LOGROTATE_SOURCE" "$candidate_root/etc/logrotate.d/monit"
    install -m 0644 "$SYSTEMD_SOURCE" \
        "$candidate_root/etc/systemd/system/monit.service.d/10-baseline.conf"
    render_main "$candidate_root/etc/monitrc" \
        "$candidate_include_glob" "$candidate_password"
    validate_candidate "$candidate_root/etc/monitrc" \
        "$candidate_root/etc/logrotate.d/monit"
}

validate_output_target() {
    [ -n "$OUTPUT_DIRECTORY" ] || fail "--output requires a directory"
    case "${OUTPUT_DIRECTORY##*/}" in
        '' | . | ..) fail "invalid output directory: $OUTPUT_DIRECTORY" ;;
    esac
    [ ! -e "$OUTPUT_DIRECTORY" ] && [ ! -L "$OUTPUT_DIRECTORY" ] \
        || fail "output path already exists: $OUTPUT_DIRECTORY"
    output_parent=${OUTPUT_DIRECTORY%/*}
    [ "$output_parent" != "$OUTPUT_DIRECTORY" ] || output_parent=.
    [ -d "$output_parent" ] && [ ! -L "$output_parent" ] \
        || fail "output parent must be a real directory: $output_parent"
}

validate_root_directory() {
    checked_directory=$1
    [ -d "$checked_directory" ] && [ ! -L "$checked_directory" ] \
        || fail "target must be a real directory: $checked_directory"
    checked_identity=$(stat -Lc '%U:%G:%a' "$checked_directory" 2>/dev/null) \
        || fail "cannot inspect directory: $checked_directory"
    checked_owner_group=${checked_identity%:*}
    checked_mode=${checked_identity##*:}
    [ "$checked_owner_group" = root:root ] \
        || fail "target directory must be root:root: $checked_directory"
    if [ "$((0$checked_mode & 0022))" -ne 0 ]; then
        fail "target directory must not be writable by group or other: $checked_directory"
    fi
    monit_require_no_acl "$checked_directory"
}

ensure_directory() {
    managed_directory=$1
    managed_mode=$2
    if [ -e "$managed_directory" ] || [ -L "$managed_directory" ]; then
        validate_root_directory "$managed_directory"
    fi
    install -d -o root -g root -m "$managed_mode" "$managed_directory"
}

validate_managed_target() {
    managed_target=$1
    if [ -e "$managed_target" ] || [ -L "$managed_target" ]; then
        [ -f "$managed_target" ] && [ ! -L "$managed_target" ] \
            || fail "managed target must be a regular file: $managed_target"
    fi
}

main_replacement_is_safe() {
    [ -e "$MONIT_MAIN" ] || return 0
    validate_managed_target "$MONIT_MAIN"
    if grep -F "$MANAGED_MARKER" "$MONIT_MAIN" >/dev/null 2>&1; then
        return 0
    fi
    if [ "$REPLACE_MAIN" = yes ]; then
        return 0
    fi
    package_owner=$(rpm -qf --qf '%{NAME}\n' "$MONIT_MAIN" 2>/dev/null || true)
    [ "$package_owner" = monit ] || fail \
        "refusing unmanaged $MONIT_MAIN not owned by the Monit package; migrate private policy to *.conf fragments, then rerun with --replace-main"
    if rpm -V monit > "$TEMPORARY_DIRECTORY/rpm-verification" 2>/dev/null; then
        verification_status=0
    else
        verification_status=$?
    fi
    [ "$verification_status" -le 1 ] \
        || fail "cannot verify the installed Monit package"
    verification_output=$(awk -v expected="$MONIT_MAIN" \
        '$NF == expected { print }' "$TEMPORARY_DIRECTORY/rpm-verification")
    [ -z "$verification_output" ] || fail \
        "refusing modified unmanaged $MONIT_MAIN; migrate private policy to *.conf fragments, then rerun with --replace-main"
}

backup_target() {
    backup_target_path=$1
    backup_relative_path=${backup_target_path#/}
    backup_file=$BACKUP_DIRECTORY/files/$backup_relative_path
    backup_present=$BACKUP_DIRECTORY/present/$backup_relative_path
    backup_absent=$BACKUP_DIRECTORY/absent/$backup_relative_path
    mkdir -p "${backup_file%/*}" "${backup_present%/*}" "${backup_absent%/*}"
    if [ -e "$backup_target_path" ] || [ -L "$backup_target_path" ]; then
        validate_managed_target "$backup_target_path"
        cp --preserve=mode,ownership,timestamps,xattr,context -- "$backup_target_path" "$backup_file"
        : > "$backup_present"
    else
        : > "$backup_absent"
    fi
    BACKED_UP_TARGETS=$(append_line "$BACKED_UP_TARGETS" "$backup_target_path")
}

stage_path() {
    # A staged copy is created beside its target so the final rename is atomic
    # on the same filesystem. logrotate parses every file in its include
    # directory except those carrying a taboo extension, so a plain staging
    # name there is read as a duplicate policy for the copy's duration;
    # ".disabled" is on logrotate's default taboo list. Monit and systemd load
    # only *.conf from their directories and /etc/monitrc is read by name, so
    # the plain suffix cannot be picked up anywhere else.
    case "$1" in
        */logrotate.d/*) mktemp "$1.$2.XXXXXX.disabled" ;;
        *) mktemp "$1.$2.XXXXXX" ;;
    esac
}

restore_target() {
    restore_target_path=$1
    restore_relative_path=${restore_target_path#/}
    restore_file=$BACKUP_DIRECTORY/files/$restore_relative_path
    restore_present=$BACKUP_DIRECTORY/present/$restore_relative_path
    restore_absent=$BACKUP_DIRECTORY/absent/$restore_relative_path
    if [ -f "$restore_present" ]; then
        restore_stage=$(stage_path "$restore_target_path" rollback) || return 1
        if ! cp --preserve=mode,ownership,timestamps,xattr,context -- "$restore_file" "$restore_stage" \
            || ! mv -f -- "$restore_stage" "$restore_target_path"
        then
            rm -f -- "$restore_stage"
            return 1
        fi
    elif [ -f "$restore_absent" ]; then
        rm -f -- "$restore_target_path"
    else
        printf '%s: rollback manifest is incomplete for %s\n' \
            "$PROGRAM_NAME" "$restore_target_path" >&2
        return 1
    fi
}

rollback_transaction() {
    rollback_failed=no
    files_restored=yes
    printf '%s: setup failed; restoring managed files and prior service state\n' \
        "$PROGRAM_NAME" >&2
    for rollback_target in $BACKED_UP_TARGETS; do
        if ! restore_target "$rollback_target"; then
            printf '%s: could not restore %s\n' "$PROGRAM_NAME" "$rollback_target" >&2
            files_restored=no
        fi
    done
    [ "$files_restored" = yes ] || rollback_failed=yes
    if ! systemctl daemon-reload; then
        # The restored drop-in is on disk, but the manager still holds the
        # transaction's unit properties until a reload succeeds. Report it
        # without withdrawing monitoring: the configuration Monit reads is
        # the original again, and stopping here would trade a reporting gap
        # for an outage that the operator's daemon-reload does not need.
        printf '%s: systemd daemon-reload failed; the restored unit drop-in is not loaded until it succeeds, then restart monit.service\n' \
            "$PROGRAM_NAME" >&2
        rollback_failed=yes
    fi
    if [ "$files_restored" = no ]; then
        # Never let Monit consume a partially restored tree.
        systemctl stop monit.service || rollback_failed=yes
    elif [ "$SERVICE_WAS_ACTIVE" = no ]; then
        systemctl stop monit.service || rollback_failed=yes
    elif ! monit -t -c "$MONIT_MAIN" >/dev/null; then
        # The restored files are what ran before this transaction. If they no
        # longer validate, relaunching them is not safe and stopping is not
        # justified either; leave the current process for the operator.
        printf '%s: restored Monit configuration failed validation; service state left unchanged\n' \
            "$PROGRAM_NAME" >&2
        rollback_failed=yes
    elif [ "$SERVICE_RESTART_REQUIRED" = yes ]; then
        systemctl restart monit.service || rollback_failed=yes
    elif systemctl is-active --quiet monit.service; then
        systemctl reload monit.service || rollback_failed=yes
    else
        systemctl start monit.service || rollback_failed=yes
    fi
    if [ "$SERVICE_WAS_ENABLED" = yes ]; then
        systemctl enable monit.service || rollback_failed=yes
    else
        systemctl disable monit.service || rollback_failed=yes
    fi
    if [ "$rollback_failed" = yes ]; then
        printf '%s\n' rollback-incomplete > "$BACKUP_DIRECTORY/status"
        printf '%s: rollback incomplete; retained originals require operator recovery: %s\n' \
            "$PROGRAM_NAME" "$BACKUP_DIRECTORY" >&2
        return 1
    fi
    printf '%s\n' rolled-back > "$BACKUP_DIRECTORY/status"
}

cleanup() {
    cleanup_status=$1
    trap - EXIT HUP INT TERM
    if [ "$CHANGES_STARTED" = yes ] && [ "$TRANSACTION_COMMITTED" = no ]; then
        rollback_transaction || cleanup_status=1
    fi
    if [ -n "$PENDING_STAGE" ]; then
        rm -f -- "$PENDING_STAGE" || cleanup_status=1
    fi
    if [ -n "$TEMPORARY_DIRECTORY" ] && [ -d "$TEMPORARY_DIRECTORY" ]; then
        rm -rf -- "$TEMPORARY_DIRECTORY" || cleanup_status=1
    fi
    if [ -n "$BACKUP_DIRECTORY" ]; then
        printf 'Retained root-only Monit transaction: %s\n' "$BACKUP_DIRECTORY" >&2
    fi
    exit "$cleanup_status"
}

install_managed_file() {
    staged_source=$1
    live_target=$2
    live_mode=$3
    PENDING_STAGE=$(stage_path "$live_target" tmp)
    install -o root -g root -m "$live_mode" "$staged_source" "$PENDING_STAGE"
    mv -f -- "$PENDING_STAGE" "$live_target"
    PENDING_STAGE=
}

select_activation_policy() {
    [ "$SERVICE_WAS_ACTIVE" = yes ] || return 0
    if ! cmp -s "$SYSTEMD_SOURCE" "$SYSTEMD_TARGET"; then
        SERVICE_RESTART_REQUIRED=yes
    fi
    current_main_pid=$(systemctl show monit.service --property=MainPID --value)
    current_process_umask=$(monit_read_process_umask "$current_main_pid") \
        || fail "cannot inspect the running Monit process umask"
    case "$current_process_umask" in
        0077 | 077) ;;
        *) SERVICE_RESTART_REQUIRED=yes ;;
    esac
}

activate_service() {
    if [ "$SERVICE_WAS_ACTIVE" = yes ]; then
        systemctl enable monit.service
        if [ "$SERVICE_RESTART_REQUIRED" = yes ]; then
            printf 'Restarting Monit to apply changed execution policy or process umask.\n'
            systemctl restart monit.service
        else
            systemctl reload monit.service
        fi
    else
        systemctl enable --now monit.service
    fi
}

validate_source "$SECURITY_LIBRARY"
# shellcheck disable=SC1090
. "$SECURITY_LIBRARY"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --fragment)
            [ "$#" -ge 2 ] || fail "--fragment requires a file"
            validate_fragment_source "$2"
            shift 2
            ;;
        --output)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            [ "$#" -ge 2 ] || fail "--output requires a directory"
            MODE=output
            OUTPUT_DIRECTORY=$2
            shift 2
            ;;
        --plan)
            [ "$MODE" = apply ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --replace-main)
            REPLACE_MAIN=yes
            shift
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

for setup_source in \
    "$MAIN_TEMPLATE" "$SYSTEM_SOURCE" "$LOGROTATE_SOURCE" \
    "$SYSTEMD_SOURCE" "$VERIFIER_SOURCE"
do
    validate_source "$setup_source"
done
[ -x "$VERIFIER_SOURCE" ] || fail "verifier source must be executable"
validate_template_contract

if [ "$MODE" = check ]; then
    [ -z "$FRAGMENT_SOURCES$OUTPUT_DIRECTORY" ] && [ "$REPLACE_MAIN" = no ] \
        || fail "--check does not accept deployment options"
    "$VERIFIER_SOURCE" --check >/dev/null
    printf 'Validated Monit setup templates, policies, and verifier source.\n'
    exit 0
fi
if [ "$MODE" = output ] && [ "$REPLACE_MAIN" = yes ]; then
    fail "--replace-main is not valid with --output"
fi

if [ "$MODE" = plan ]; then
    printf 'Monit setup plan:\n'
    printf '+ install root-only baseline /etc/monitrc with a generated local control credential\n'
    printf '+ preserve existing /etc/monit.d/*.conf fragments\n'
    printf '+ require trusted root-owned fragments, one link, no extended ACLs, and no nested includes\n'
    for fragment_source in $FRAGMENT_SOURCES; do
        printf '+ install root-only fragment %s as /etc/monit.d/%s\n' \
            "$fragment_source" "${fragment_source##*/}"
    done
    printf '+ install alert-only system resource checks\n'
    printf '+ install logrotate policy with SIGHUP log reopen\n'
    printf '+ install systemd runtime, state, log, umask, and reload policy\n'
    printf '+ restore default SELinux labels and reject any Monit AVC denial\n'
    printf '+ retain root-only transaction originals under /var/lib/config-monit/backups\n'
    printf '+ validate the assembled tree; reload configuration-only changes or restart Monit for changed execution policy/process umask\n'
    printf '+ start fresh Monit deployments and verify the running process Umask is 0077\n'
    if [ "$REPLACE_MAIN" = yes ]; then
        printf '+ explicitly replace a modified unmanaged /etc/monitrc\n'
    else
        printf '+ refuse a modified unmanaged /etc/monitrc\n'
    fi
    printf 'Plan complete; no host changes were made.\n'
    exit 0
fi

for required_command in awk chmod cmp cp find grep install mkdir mktemp mv openssl sleep stat wc; do
    command -v "$required_command" >/dev/null 2>&1 \
        || fail "required command not found: $required_command"
done

TEMPORARY_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/config-monit-setup.XXXXXX")
umask 077
trap 'cleanup "$?"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$MODE" = output ]; then
    validate_output_target
    control_password=$(generate_control_password)
    prepare_candidate "$TEMPORARY_DIRECTORY/publication" "$control_password"
    render_main "$TEMPORARY_DIRECTORY/publication/etc/monitrc" \
        "$LIVE_INCLUDE_GLOB" "$control_password"
    mv "$TEMPORARY_DIRECTORY/publication" "$OUTPUT_DIRECTORY"
    printf 'Rendered Monit baseline: %s\n' "$OUTPUT_DIRECTORY"
    exit 0
fi

[ "$(id -u)" -eq 0 ] || fail "run as root, use --plan, or use --output"
for required_command in getenforce getfacl logrotate matchpathcon monit readlink restorecon rpm \
    systemctl
do
    command -v "$required_command" >/dev/null 2>&1 \
        || fail "required command not found: $required_command"
done
[ "$(getenforce)" = Enforcing ] || fail "SELinux must be Enforcing"
rpm -q monit >/dev/null 2>&1 || fail "Monit package is not installed"
canonical_fragment_sources=
for fragment_source in $FRAGMENT_SOURCES; do
    validate_source "$fragment_source"
    case "$fragment_source" in
        /*) source_absolute=$fragment_source ;;
        *) source_absolute=$(pwd -P)/$fragment_source ;;
    esac
    source_parent=${source_absolute%/*}
    while [ -n "$source_parent" ]; do
        validate_root_directory "$source_parent"
        source_parent=${source_parent%/*}
    done
    # Copy from the validated canonical path, never from a replaceable ancestor
    # symlink. All source ancestors must be trusted too.
    canonical_fragment=$(readlink -f -- "$fragment_source") \
        || fail "cannot resolve adoption source: $fragment_source"
    require_unspaced_path 'canonical fragment paths' "$canonical_fragment"
    monit_require_adoption_source "$canonical_fragment"
    source_parent=${canonical_fragment%/*}
    while [ -n "$source_parent" ]; do
        validate_root_directory "$source_parent"
        source_parent=${source_parent%/*}
    done
    canonical_fragment_sources=$(append_line "$canonical_fragment_sources" "$canonical_fragment")
done
FRAGMENT_SOURCES=$canonical_fragment_sources
main_replacement_is_safe
for trusted_parent in /etc /var/lib /var/log /run; do
    validate_root_directory "$trusted_parent"
done
if [ -e "$MONIT_FRAGMENT_DIRECTORY" ] || [ -L "$MONIT_FRAGMENT_DIRECTORY" ]; then
    validate_root_directory "$MONIT_FRAGMENT_DIRECTORY"
fi

if systemctl is-active --quiet monit.service 2>/dev/null; then
    SERVICE_WAS_ACTIVE=yes
fi
if systemctl is-enabled --quiet monit.service 2>/dev/null; then
    SERVICE_WAS_ENABLED=yes
fi
select_activation_policy

control_password=$(existing_control_password || generate_control_password)
prepare_candidate "$TEMPORARY_DIRECTORY/candidate" "$control_password"
render_main "$TEMPORARY_DIRECTORY/final-monitrc" \
    "$LIVE_INCLUDE_GLOB" "$control_password"

for fixed_target in "$MONIT_MAIN" "$SYSTEM_TARGET" "$LOGROTATE_TARGET" "$SYSTEMD_TARGET"; do
    validate_managed_target "$fixed_target"
done
for fragment_source in $FRAGMENT_SOURCES; do
    validate_managed_target "$MONIT_FRAGMENT_DIRECTORY/${fragment_source##*/}"
done

ensure_directory /var/lib/config-monit 0700
ensure_directory "$BACKUP_ROOT" 0700
BACKUP_DIRECTORY=$(mktemp -d "$BACKUP_ROOT/transaction.XXXXXXXX")
printf 'active=%s\nenabled=%s\nrestart_required=%s\n' \
    "$SERVICE_WAS_ACTIVE" "$SERVICE_WAS_ENABLED" "$SERVICE_RESTART_REQUIRED" \
    > "$BACKUP_DIRECTORY/service-state"
printf '%s\n' preparing > "$BACKUP_DIRECTORY/status"
for fixed_target in "$MONIT_MAIN" "$SYSTEM_TARGET" "$LOGROTATE_TARGET" "$SYSTEMD_TARGET"; do
    backup_target "$fixed_target"
done
for fragment_source in $FRAGMENT_SOURCES; do
    backup_target "$MONIT_FRAGMENT_DIRECTORY/${fragment_source##*/}"
done
printf '%s\n' "$BACKED_UP_TARGETS" > "$BACKUP_DIRECTORY/targets"
CHANGES_STARTED=yes
printf '%s\n' applying > "$BACKUP_DIRECTORY/status"

ensure_directory "$MONIT_FRAGMENT_DIRECTORY" 0750
ensure_directory /etc/logrotate.d 0755
ensure_directory /etc/systemd/system 0755
ensure_directory "$SYSTEMD_DIRECTORY" 0755
ensure_directory "$MONIT_LOG_DIRECTORY" 0700
ensure_directory "$MONIT_STATE_DIRECTORY" 0700
ensure_directory "$MONIT_RUNTIME_DIRECTORY" 0750

install_managed_file "$TEMPORARY_DIRECTORY/final-monitrc" "$MONIT_MAIN" 0600
install_managed_file "$TEMPORARY_DIRECTORY/candidate/etc/monit.d/10-system.conf" "$SYSTEM_TARGET" 0600
for fragment_source in $FRAGMENT_SOURCES; do
    install_managed_file "$TEMPORARY_DIRECTORY/candidate/etc/monit.d/${fragment_source##*/}" \
        "$MONIT_FRAGMENT_DIRECTORY/${fragment_source##*/}" 0600
done
install_managed_file "$TEMPORARY_DIRECTORY/candidate/etc/logrotate.d/monit" "$LOGROTATE_TARGET" 0644
install_managed_file "$TEMPORARY_DIRECTORY/candidate/etc/systemd/system/monit.service.d/10-baseline.conf" "$SYSTEMD_TARGET" 0644

restorecon -RF "$MONIT_MAIN" "$MONIT_FRAGMENT_DIRECTORY" \
    "$LOGROTATE_TARGET" "$SYSTEMD_DIRECTORY" "$MONIT_LOG_DIRECTORY" \
    "$MONIT_STATE_DIRECTORY" "$MONIT_RUNTIME_DIRECTORY" >/dev/null
systemctl daemon-reload
monit -t -c "$MONIT_MAIN" >/dev/null
logrotate --debug "$LOGROTATE_TARGET" >/dev/null 2>&1

activate_service
systemctl is-enabled --quiet monit.service \
    || fail "monit.service is not enabled after setup"
systemctl is-active --quiet monit.service \
    || fail "monit.service is not active after setup"
wait_for_control_plane \
    || fail "Monit local control-plane health check failed"
"$VERIFIER_SOURCE" >/dev/null

printf '%s\n' committed > "$BACKUP_DIRECTORY/status"
TRANSACTION_COMMITTED=yes
printf 'Applied and verified Monit baseline; monit.service is active and enabled.\n'
