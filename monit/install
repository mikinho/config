#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIRECTORY/.." && pwd)
PLATFORM_LIBRARY=$REPOSITORY_ROOT/deploy/lib/platform.sh
SETUP_SOURCE=$SCRIPT_DIRECTORY/setup
VERIFIER_SOURCE=$SCRIPT_DIRECTORY/verify
VERIFIER_TARGET=/usr/local/bin/verify-monit
VERIFIER_LIBRARY_DIRECTORY=/usr/local/libexec/config-monit
MAIN_TEMPLATE=$SCRIPT_DIRECTORY/templates/monitrc.in
SYSTEM_SOURCE=$SCRIPT_DIRECTORY/conf.d/10-system.conf
LOGROTATE_SOURCE=$SCRIPT_DIRECTORY/logrotate/monit
SYSTEMD_SOURCE=$SCRIPT_DIRECTORY/systemd/monit.service.conf

MODE=install
OS_RELEASE_FILE=/etc/os-release
OS_RELEASE_OVERRIDDEN=no
SERVICE_WAS_ACTIVE=no
SERVICE_WAS_ENABLED=no

usage() {
    cat <<EOF
Usage:
  $PROGRAM_NAME
  $PROGRAM_NAME --plan [--os-release FILE]
  $PROGRAM_NAME --check

Installs Monit and its SELinux, audit, logrotate, and runtime verification
dependencies from supported RHEL-family repositories. It installs the
read-only verifier but does not configure, start, or newly enable Monit.
Run monit/setup after reviewing the rendered baseline and private fragments.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

validate_source() {
    install_source=$1
    [ -f "$install_source" ] && [ ! -L "$install_source" ] \
        || fail "repository dependency must be a regular file: $install_source"
}

validate_root_directory() {
    checked_directory=$1
    [ -d "$checked_directory" ] && [ ! -L "$checked_directory" ] \
        || fail "target must be a real directory: $checked_directory"
    checked_identity=$(stat -Lc '%U:%G:%a' "$checked_directory" 2>/dev/null) \
        || fail "cannot inspect target directory: $checked_directory"
    [ "$checked_identity" = root:root:755 ] \
        || fail "$checked_directory must be root:root mode 0755"
}

validate_install_target() {
    install_target=$1
    [ ! -L "$install_target" ] \
        || fail "refusing symbolic-link install target: $install_target"
    if [ -e "$install_target" ]; then
        [ -f "$install_target" ] \
            || fail "install target must be a regular file: $install_target"
    fi
}

for install_source in \
    "$PLATFORM_LIBRARY" "$SETUP_SOURCE" "$VERIFIER_SOURCE" \
    "$MAIN_TEMPLATE" "$SYSTEM_SOURCE" "$LOGROTATE_SOURCE" "$SYSTEMD_SOURCE"
do
    validate_source "$install_source"
done
[ -x "$SETUP_SOURCE" ] || fail "setup source must be executable: $SETUP_SOURCE"
[ -x "$VERIFIER_SOURCE" ] || fail "verifier source must be executable: $VERIFIER_SOURCE"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = install ] || fail "select exactly one mode"
            MODE=check
            shift
            ;;
        --plan)
            [ "$MODE" = install ] || fail "select exactly one mode"
            MODE=plan
            shift
            ;;
        --os-release)
            [ "$#" -ge 2 ] || fail "--os-release requires a file"
            OS_RELEASE_FILE=$2
            OS_RELEASE_OVERRIDDEN=yes
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

if [ "$MODE" = check ]; then
    [ "$OS_RELEASE_OVERRIDDEN" = no ] \
        || fail "--check does not accept --os-release"
    "$SETUP_SOURCE" --check >/dev/null
    "$VERIFIER_SOURCE" --check >/dev/null
    printf 'Validated Monit installer, setup, and verifier sources.\n'
    exit 0
fi
if [ "$OS_RELEASE_OVERRIDDEN" = yes ] && [ "$MODE" != plan ]; then
    fail "--os-release is accepted only with --plan"
fi

# shellcheck disable=SC1090,SC1091
. "$PLATFORM_LIBRARY"
platform_detect_supported_os "$OS_RELEASE_FILE"
printf 'Monit installation target: %s (%s)\n' \
    "$PLATFORM_OS_LABEL" "$PLATFORM_OS_ARCHITECTURE"

if [ "$MODE" = install ]; then
    [ "$(id -u)" -eq 0 ] || fail "run as root or use --plan"
    for install_command in cmp dnf install rpm stat systemctl; do
        command -v "$install_command" >/dev/null 2>&1 \
            || fail "required command not found: $install_command"
    done
    if systemctl is-active --quiet monit.service 2>/dev/null; then
        SERVICE_WAS_ACTIVE=yes
    fi
    if systemctl is-enabled --quiet monit.service 2>/dev/null; then
        SERVICE_WAS_ENABLED=yes
    fi
fi

# Consumed by the sourced platform library.
# shellcheck disable=SC2034
PLATFORM_MODE=$MODE
platform_install_epel_repository
platform_run dnf install --assumeyes \
    audit \
    iproute \
    libselinux-utils \
    logrotate \
    monit \
    openssl \
    policycoreutils \
    procps-ng

if [ "$MODE" = plan ]; then
    platform_print_command install -o root -g root -m 0755 \
        "$VERIFIER_SOURCE" "$VERIFIER_TARGET"
    printf '+ install verifier policy sources under %s\n' \
        "$VERIFIER_LIBRARY_DIRECTORY"
    printf 'Plan complete; Monit policy would remain inactive.\n'
    exit 0
fi

for installed_command in ausearch getenforce logrotate matchpathcon monit \
    openssl ps restorecon ss
do
    command -v "$installed_command" >/dev/null 2>&1 \
        || fail "package installation did not provide required command: $installed_command"
done
rpm -q monit >/dev/null 2>&1 || fail "Monit package was not installed"

if [ ! -e /usr/local/bin ]; then
    install -d -o root -g root -m 0755 /usr/local/bin
fi
[ -d /usr/local/bin ] && [ ! -L /usr/local/bin ] \
    || fail "verifier target must be a real directory: /usr/local/bin"
validate_root_directory /usr/local/bin
validate_install_target "$VERIFIER_TARGET"
install -o root -g root -m 0755 "$VERIFIER_SOURCE" "$VERIFIER_TARGET"
cmp -s "$VERIFIER_SOURCE" "$VERIFIER_TARGET" \
    || fail "installed verifier differs from repository source"
if [ ! -e /usr/local/libexec ]; then
    install -d -o root -g root -m 0755 /usr/local/libexec
fi
[ -d /usr/local/libexec ] && [ ! -L /usr/local/libexec ] \
    || fail "verifier library parent must be a real directory"
validate_root_directory /usr/local/libexec
if [ ! -e "$VERIFIER_LIBRARY_DIRECTORY" ]; then
    install -d -o root -g root -m 0755 "$VERIFIER_LIBRARY_DIRECTORY"
fi
[ -d "$VERIFIER_LIBRARY_DIRECTORY" ] && [ ! -L "$VERIFIER_LIBRARY_DIRECTORY" ] \
    || fail "verifier library target must be a real directory"
validate_root_directory "$VERIFIER_LIBRARY_DIRECTORY"
for verifier_library_target in \
    "$VERIFIER_LIBRARY_DIRECTORY/monitrc.in" \
    "$VERIFIER_LIBRARY_DIRECTORY/10-system.conf" \
    "$VERIFIER_LIBRARY_DIRECTORY/logrotate-monit" \
    "$VERIFIER_LIBRARY_DIRECTORY/monit.service.conf"
do
    validate_install_target "$verifier_library_target"
done
install -o root -g root -m 0644 "$MAIN_TEMPLATE" \
    "$VERIFIER_LIBRARY_DIRECTORY/monitrc.in"
install -o root -g root -m 0644 "$SYSTEM_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/10-system.conf"
install -o root -g root -m 0644 "$LOGROTATE_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/logrotate-monit"
install -o root -g root -m 0644 "$SYSTEMD_SOURCE" \
    "$VERIFIER_LIBRARY_DIRECTORY/monit.service.conf"
cmp -s "$MAIN_TEMPLATE" "$VERIFIER_LIBRARY_DIRECTORY/monitrc.in" \
    || fail "installed main template differs from repository source"
cmp -s "$SYSTEM_SOURCE" "$VERIFIER_LIBRARY_DIRECTORY/10-system.conf" \
    || fail "installed system policy differs from repository source"
cmp -s "$LOGROTATE_SOURCE" "$VERIFIER_LIBRARY_DIRECTORY/logrotate-monit" \
    || fail "installed logrotate policy differs from repository source"
cmp -s "$SYSTEMD_SOURCE" "$VERIFIER_LIBRARY_DIRECTORY/monit.service.conf" \
    || fail "installed systemd policy differs from repository source"
"$VERIFIER_TARGET" --check >/dev/null

if [ "$SERVICE_WAS_ACTIVE" = yes ]; then
    systemctl is-active --quiet monit.service \
        || fail "package installation unexpectedly stopped monit.service"
else
    if systemctl is-active --quiet monit.service 2>/dev/null; then
        systemctl stop monit.service >/dev/null 2>&1 || true
        fail "package installation unexpectedly started monit.service; it was stopped"
    fi
fi
if [ "$SERVICE_WAS_ENABLED" = yes ]; then
    systemctl is-enabled --quiet monit.service \
        || fail "package installation unexpectedly disabled monit.service"
else
    systemctl disable monit.service >/dev/null 2>&1 || true
    if systemctl is-enabled --quiet monit.service 2>/dev/null; then
        fail "fresh Monit installation did not remain disabled"
    fi
fi

printf 'Installed Monit and verifier; existing service state was preserved.\n'
