#!/usr/bin/env sh

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

set -eu
set -f

PROGRAM_NAME=${0##*/}
SCRIPT_DIRECTORY=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
SOURCE_ROOT=$SCRIPT_DIRECTORY
if [ ! -f "$SOURCE_ROOT/templates/monitrc.in" ] \
    && [ -d /usr/local/libexec/config-monit ]; then
    SOURCE_ROOT=/usr/local/libexec/config-monit
fi
if [ "$SOURCE_ROOT" = "$SCRIPT_DIRECTORY" ]; then
    VERSION_LIBRARY=$SOURCE_ROOT/lib/version.sh
    SECURITY_LIBRARY=$SOURCE_ROOT/lib/security.sh
    MAIN_TEMPLATE=$SOURCE_ROOT/templates/monitrc.in
    SYSTEM_SOURCE=$SOURCE_ROOT/conf.d/10-system.conf
    LOGROTATE_SOURCE=$SOURCE_ROOT/logrotate/monit
    SYSTEMD_SOURCE=$SOURCE_ROOT/systemd/monit.service.conf
else
    VERSION_LIBRARY=$SOURCE_ROOT/version.sh
    SECURITY_LIBRARY=$SOURCE_ROOT/security.sh
    MAIN_TEMPLATE=$SOURCE_ROOT/monitrc.in
    SYSTEM_SOURCE=$SOURCE_ROOT/10-system.conf
    LOGROTATE_SOURCE=$SOURCE_ROOT/logrotate-monit
    SYSTEMD_SOURCE=$SOURCE_ROOT/monit.service.conf
fi

MONIT_MAIN=/etc/monitrc
MONIT_FRAGMENT_DIRECTORY=/etc/monit.d
SYSTEM_TARGET=$MONIT_FRAGMENT_DIRECTORY/10-system.conf
LOGROTATE_TARGET=/etc/logrotate.d/monit
SYSTEMD_TARGET=/etc/systemd/system/monit.service.d/10-baseline.conf
MONIT_LOG_DIRECTORY=/var/log/monit
MONIT_LOG=$MONIT_LOG_DIRECTORY/monit.log
MONIT_STATE_DIRECTORY=/var/lib/monit
MONIT_RUNTIME_DIRECTORY=/run/monit
PACKAGE_UNIT=/usr/lib/systemd/system/monit.service
PACKAGE_BINARY=/usr/bin/monit
MANAGED_MARKER='Managed by mikinho/config monit/setup.'
TRANSACTION_STORE=/var/lib/config-monit
BACKUP_ROOT=$TRANSACTION_STORE/backups
# Completed transactions beyond this count are reported so retention decisions
# are recorded rather than deferred indefinitely; the copies hold credentials.
RETAINED_TRANSACTION_WARNING=5

MODE=verify
SETUP_TRANSACTION=

usage() {
    cat <<EOF
Usage:
  sudo $PROGRAM_NAME
  $PROGRAM_NAME --check

Performs a read-only acceptance audit of the installed Monit baseline,
including package integrity, enforcing SELinux, control-plane exposure,
configuration syntax, systemd state, file identities, logrotate policy,
runtime health, and Monit AVC denials recorded since boot.
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

warn() {
    printf '%s: warning: %s\n' "$PROGRAM_NAME" "$*" >&2
}

validate_source() {
    verifier_source=$1
    [ -f "$verifier_source" ] && [ ! -L "$verifier_source" ] \
        || fail "repository dependency must be a regular file: $verifier_source"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 \
        || fail "required verification command not found: $1"
}

require_regular_file_identity() {
    checked_file=$1
    expected_identity=$2
    [ -f "$checked_file" ] && [ ! -L "$checked_file" ] \
        || fail "required file must be a non-symbolic regular file: $checked_file"
    actual_identity=$(stat -Lc '%U:%G:%a:%h' "$checked_file" 2>/dev/null) \
        || fail "cannot inspect required file: $checked_file"
    [ "$actual_identity" = "$expected_identity" ] \
        || fail "$checked_file must be $expected_identity (found $actual_identity)"
    monit_require_no_acl "$checked_file"
}

require_directory_identity() {
    checked_directory=$1
    expected_identity=$2
    [ -d "$checked_directory" ] && [ ! -L "$checked_directory" ] \
        || fail "required directory must be non-symbolic: $checked_directory"
    actual_identity=$(stat -Lc '%U:%G:%a' "$checked_directory" 2>/dev/null) \
        || fail "cannot inspect required directory: $checked_directory"
    [ "$actual_identity" = "$expected_identity" ] \
        || fail "$checked_directory must be $expected_identity (found $actual_identity)"
    monit_require_no_acl "$checked_directory"
}

require_exact_line() {
    expected_line=$1
    checked_file=$2
    line_count=$(grep -Fxc -- "$expected_line" "$checked_file" || true)
    [ "$line_count" -eq 1 ] \
        || fail "$checked_file must contain exactly once: $expected_line"
}

verify_version_floor() {
    monit_version=$(monit_read_binary_version "$PACKAGE_BINARY")
    [ -n "$monit_version" ] || fail "cannot determine the installed Monit version"
    monit_version_is_at_least "$monit_version" "$MONIT_SUPPORTED_VERSION" \
        || fail "Monit $MONIT_SUPPORTED_VERSION or newer is required (found $monit_version)"
    if monit_version_is_at_least "$monit_version" "$MONIT_PREFERRED_VERSION"; then
        printf 'Monit version %s satisfies the preferred release policy.\n' \
            "$monit_version"
    else
        printf 'Monit version %s is the supported compatibility release; prefer %s when the enabled EPEL stream supplies it.\n' \
            "$monit_version" "$MONIT_PREFERRED_VERSION"
    fi
}

verify_package_integrity() {
    rpm -q monit >/dev/null 2>&1 || fail "Monit package is not installed"
    package_signature=$(rpm -q --qf '%{RSAHEADER:pgpsig}\n' monit 2>/dev/null || true)
    printf '%s\n' "$package_signature" | grep -Eqi 'Key ID|RSA/SHA' \
        || fail "installed Monit package has no verifiable RPM signature metadata"
    if verification_output=$(rpm -V monit 2>/dev/null); then
        verification_status=0
    else
        verification_status=$?
    fi
    [ "$verification_status" -le 1 ] \
        || fail "cannot verify the installed Monit package"
    for package_path in "$PACKAGE_BINARY" "$PACKAGE_UNIT"; do
        if printf '%s\n' "$verification_output" \
            | awk -v expected="$package_path" '$NF == expected { found = 1 } END { exit found ? 0 : 1 }'
        then
            fail "package-owned Monit file failed RPM verification: $package_path"
        fi
    done
}

verify_control_file() {
    require_regular_file_identity "$MONIT_MAIN" root:root:600:1
    grep -F "$MANAGED_MARKER" "$MONIT_MAIN" >/dev/null 2>&1 \
        || fail "$MONIT_MAIN is not the managed baseline"
    require_exact_line 'set daemon 30' "$MONIT_MAIN"
    require_exact_line 'set log /var/log/monit/monit.log' "$MONIT_MAIN"
    require_exact_line 'set httpd port 2812 and' "$MONIT_MAIN"
    require_exact_line '    use address 127.0.0.1' "$MONIT_MAIN"
    require_exact_line 'include /etc/monit.d/*.conf' "$MONIT_MAIN"
    if grep -F 'admin:monit' "$MONIT_MAIN" >/dev/null 2>&1; then
        fail "$MONIT_MAIN retains the package default credential"
    fi
    control_passwords=$(awk '
        $1 == "allow" && $2 ~ /^admin:/ {
            sub(/^admin:/, "", $2)
            print $2
        }
    ' "$MONIT_MAIN")
    printf '%s\n' "$control_passwords" | grep -Eq '^[0-9a-f]{64}$' \
        || fail "$MONIT_MAIN has an invalid local control credential"
    [ "$(printf '%s\n' "$control_passwords" | wc -l | tr -d ' ')" -eq 1 ] \
        || fail "$MONIT_MAIN must contain exactly one local control credential"
    # Exact comparison with only the generated fields normalized prevents an
    # extra include/global directive from escaping the fragment audit.
    normalized_control=$(awk '
        /^    allow admin:[0-9a-f]+$/ {
            $0 = "    allow admin:@@CONTROL_PASSWORD@@"
        }
        $0 == "include /etc/monit.d/*.conf" {
            $0 = "include @@INCLUDE_GLOB@@"
        }
        { print }
    ' "$MONIT_MAIN")
    [ "$normalized_control" = "$(cat "$MAIN_TEMPLATE")" ] \
        || fail "$MONIT_MAIN differs from the managed global policy; use flat deployment fragments"
    "$PACKAGE_BINARY" -t -c "$MONIT_MAIN" >/dev/null \
        || fail "Monit rejected the installed control tree"
}

verify_managed_files() {
    require_directory_identity "$MONIT_FRAGMENT_DIRECTORY" root:root:750
    require_directory_identity "$MONIT_LOG_DIRECTORY" root:root:700
    require_directory_identity "$MONIT_STATE_DIRECTORY" root:root:700
    require_directory_identity "$MONIT_RUNTIME_DIRECTORY" root:root:750
    require_regular_file_identity "$SYSTEM_TARGET" root:root:600:1
    require_regular_file_identity "$LOGROTATE_TARGET" root:root:644:1
    require_regular_file_identity "$SYSTEMD_TARGET" root:root:644:1
    require_regular_file_identity "$MONIT_LOG" root:root:600:1
    unsafe_fragment=$(find "$MONIT_FRAGMENT_DIRECTORY" \
        -mindepth 1 -maxdepth 1 -name '*.conf' ! -type f -print -quit)
    [ -z "$unsafe_fragment" ] \
        || fail "Monit fragment must be a non-symbolic regular file: $unsafe_fragment"
    verified_fragment_paths=$(find "$MONIT_FRAGMENT_DIRECTORY" -mindepth 1 -maxdepth 1 \
        -type f -name '*.conf' -print) || fail "cannot enumerate installed Monit fragments"
    printf '%s\n' "$verified_fragment_paths" | while IFS= read -r verified_fragment; do
            [ -n "$verified_fragment" ] || continue
            monit_require_private_fragment "$verified_fragment"
        done
    cmp -s "$SYSTEM_SOURCE" "$SYSTEM_TARGET" \
        || fail "installed system checks differ from repository policy"
    cmp -s "$LOGROTATE_SOURCE" "$LOGROTATE_TARGET" \
        || fail "installed logrotate policy differs from repository policy"
    cmp -s "$SYSTEMD_SOURCE" "$SYSTEMD_TARGET" \
        || fail "installed systemd policy differs from repository policy"
}

verify_setup_transaction() {
    [ -n "$SETUP_TRANSACTION" ] || return 0
    # This internal context is valid only for an immediate child of the setup
    # process recorded in this exact root-only transaction, never an arbitrary
    # retained record or a traversal/alias of one.
    [ "${SETUP_TRANSACTION%/*}" = "$BACKUP_ROOT" ] \
        || fail "setup transaction must be directly under $BACKUP_ROOT"
    setup_transaction_name=${SETUP_TRANSACTION##*/}
    case "$setup_transaction_name" in
        transaction.*) setup_transaction_suffix=${setup_transaction_name#transaction.} ;;
        *) fail "invalid setup transaction name" ;;
    esac
    case "$setup_transaction_suffix" in
        '' | *[!A-Za-z0-9]*) fail "invalid setup transaction name" ;;
    esac
    [ "${#setup_transaction_suffix}" -eq 8 ] || fail "invalid setup transaction name"
    require_directory_identity "$SETUP_TRANSACTION" root:root:700
    require_regular_file_identity "$SETUP_TRANSACTION/status" root:root:600:1
    require_regular_file_identity "$SETUP_TRANSACTION/setup-pid" root:root:600:1
    [ "$(cat "$SETUP_TRANSACTION/status")" = applying ] \
        || fail "setup transaction must still be applying"
    setup_pid=$(cat "$SETUP_TRANSACTION/setup-pid")
    case "$setup_pid" in
        '' | *[!0-9]* | 0 | 1) fail "invalid setup transaction process identity" ;;
    esac
    setup_parent=$(ps -o ppid= -p "$$" | awk '{$1 = $1; print}')
    [ "$setup_pid" = "$setup_parent" ] \
        || fail "setup transaction does not belong to the verifier's live parent"
}

verify_transaction_evidence() {
    # Setup retains every transaction, including copies of /etc/monitrc and its
    # control credential, under a root-only store. The store must stay private,
    # and a transaction that is still applying or whose rollback could not
    # complete is unfinished recovery work that acceptance must not overlook.
    require_directory_identity "$TRANSACTION_STORE" root:root:700
    require_directory_identity "$BACKUP_ROOT" root:root:700
    verify_setup_transaction
    retained_transactions=0
    unresolved_transactions=0
    setup_transaction_seen=no
    # Globbing is disabled for this script. Read find's list without a pipeline
    # so counts and the current transaction remain visible after the loop.
    transaction_directories=$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 \
        -name 'transaction.*' -print) || fail "cannot enumerate Monit transactions"
    while IFS= read -r transaction_directory; do
        [ -n "$transaction_directory" ] || continue
        require_directory_identity "$transaction_directory" root:root:700
        transaction_status=$(cat "$transaction_directory/status" 2>/dev/null) || transaction_status=missing
        if [ "$transaction_directory" = "$SETUP_TRANSACTION" ]; then
            [ "$transaction_status" = applying ] \
                || fail "setup transaction must still be applying"
            setup_transaction_seen=yes
            continue
        fi
        case "$transaction_status" in
            committed | rolled-back) retained_transactions=$((retained_transactions + 1)) ;;
            *)
                unresolved_transactions=$((unresolved_transactions + 1))
                printf '%s: unresolved Monit transaction (%s): %s\n' \
                    "$PROGRAM_NAME" "$transaction_status" "$transaction_directory" >&2
                ;;
        esac
    done <<EOF
$transaction_directories
EOF
    [ -z "$SETUP_TRANSACTION" ] || [ "$setup_transaction_seen" = yes ] \
        || fail "setup transaction disappeared during verification"
    [ "$unresolved_transactions" -eq 0 ] \
        || fail "$unresolved_transactions retained Monit transaction(s) are unresolved; complete recovery and record the retention decision before acceptance"
    [ "$retained_transactions" -le "$RETAINED_TRANSACTION_WARNING" ] \
        || warn "$retained_transactions completed Monit transactions are retained under $BACKUP_ROOT; each holds a control-credential copy, so record retention decisions and remove those no longer needed"
}

verify_log_rotation() {
    for logrotate_line in \
        '/var/log/monit/monit.log {' \
        '    maxsize 25M' \
        '    rotate 14' \
        '    create 0600 root root' \
        '            /usr/bin/systemctl kill --kill-who=main --signal=SIGHUP monit.service'
    do
        require_exact_line "$logrotate_line" "$LOGROTATE_TARGET"
    done
    matching_policies=$(grep -RlF '/var/log/monit/monit.log' \
        /etc/logrotate.d 2>/dev/null || true)
    [ "$matching_policies" = "$LOGROTATE_TARGET" ] \
        || fail "Monit log path is managed by an unexpected or duplicate logrotate policy"
    logrotate --debug "$LOGROTATE_TARGET" >/dev/null 2>&1 \
        || fail "Monit logrotate policy failed syntax validation"
}

verify_systemd_policy() {
    systemctl is-enabled --quiet monit.service \
        || fail "monit.service is not enabled"
    systemctl is-active --quiet monit.service \
        || fail "monit.service is not active"
    [ "$(systemctl show monit.service --property=RuntimeDirectory --value)" = monit ] \
        || fail "monit.service RuntimeDirectory is not monit"
    [ "$(systemctl show monit.service --property=StateDirectory --value)" = monit ] \
        || fail "monit.service StateDirectory is not monit"
    [ "$(systemctl show monit.service --property=LogsDirectory --value)" = monit ] \
        || fail "monit.service LogsDirectory is not monit"
    for private_directory_property in StateDirectoryMode LogsDirectoryMode; do
        [ "$(systemctl show monit.service --property="$private_directory_property" --value)" = 0700 ] \
            || fail "monit.service $private_directory_property is not 0700"
    done
    [ "$(systemctl show monit.service --property=RuntimeDirectoryMode --value)" = 0750 ] \
        || fail "monit.service RuntimeDirectoryMode is not 0750"
    case "$(systemctl show monit.service --property=UMask --value)" in
        0077 | 077) ;;
        *) fail "monit.service UMask is not 0077" ;;
    esac
    running_pid=$(systemctl show monit.service --property=MainPID --value)
    running_umask=$(monit_read_process_umask "$running_pid") \
        || fail "cannot inspect the running Monit process umask"
    case "$running_umask" in
        0077 | 077) ;;
        *) fail "running Monit process UMask is not 0077; restart Monit to apply execution policy" ;;
    esac
    [ "$(systemctl show monit.service --property=Restart --value)" = on-failure ] \
        || fail "monit.service restart policy is not on-failure"
}

verify_listener() {
    listener_output=$(ss -H -lnt 'sport = :2812') \
        || fail "cannot inspect the Monit control listener"
    [ -n "$listener_output" ] || fail "Monit control listener is not active"
    printf '%s\n' "$listener_output" | awk '
        NF {
            count += 1
            if ($4 == "127.0.0.1:2812") local = 1
        }
        END { exit count == 1 && local ? 0 : 1 }
    ' || fail "Monit control listener must bind only to 127.0.0.1:2812"
}

verify_selinux() {
    [ "$(getenforce)" = Enforcing ] || fail "SELinux must be Enforcing"
    for labeled_path in "$MONIT_MAIN" "$MONIT_FRAGMENT_DIRECTORY" \
        "$LOGROTATE_TARGET" "$SYSTEMD_TARGET" "$MONIT_LOG_DIRECTORY" \
        "$MONIT_STATE_DIRECTORY" "$MONIT_RUNTIME_DIRECTORY"
    do
        matchpathcon -V "$labeled_path" >/dev/null 2>&1 \
            || fail "SELinux label differs from policy default: $labeled_path"
    done
    main_pid=$(systemctl show monit.service --property=MainPID --value)
    case "$main_pid" in
        '' | *[!0-9]* | 0 | 1) fail "monit.service has no valid main PID" ;;
    esac
    process_label=$(ps -e -o label= -o pid= -o comm= \
        | awk -v expected_pid="$main_pid" \
            '$2 == expected_pid && $3 == "monit" { print $1; exit }')
    [ -n "$process_label" ] \
        || fail "cannot find the Monit process with an SELinux label"
    case "$process_label" in
        *:unconfined_t:*) fail "Monit is running in the user unconfined_t domain" ;;
    esac
    if avc_output=$(ausearch -m AVC,USER_AVC -ts boot -c monit --raw 2>/dev/null); then
        [ -z "$avc_output" ] \
            || fail "SELinux recorded a Monit AVC denial since boot"
    else
        ausearch_status=$?
        [ "$ausearch_status" -eq 1 ] \
            || fail "cannot query the audit log for Monit AVC denials"
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$MODE" = verify ] || fail "select exactly one mode"
            [ -z "$SETUP_TRANSACTION" ] || fail "setup transaction requires an acceptance audit"
            MODE=check
            shift
            ;;
        --setup-transaction)
            [ "$MODE" = verify ] || fail "setup transaction requires an acceptance audit"
            [ -z "$SETUP_TRANSACTION" ] || fail "setup transaction may be supplied only once"
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail "--setup-transaction requires a directory"
            SETUP_TRANSACTION=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

for verifier_source in \
    "$VERSION_LIBRARY" "$SECURITY_LIBRARY" "$MAIN_TEMPLATE" "$SYSTEM_SOURCE" \
    "$LOGROTATE_SOURCE" "$SYSTEMD_SOURCE"
do
    validate_source "$verifier_source"
done
command -v awk >/dev/null 2>&1 || fail "required verification command not found: awk"

# shellcheck disable=SC1090
. "$VERSION_LIBRARY"
# shellcheck disable=SC1090
. "$SECURITY_LIBRARY"
monit_validate_version_policy \
    || fail "invalid Monit version policy in $VERSION_LIBRARY"

if [ "$MODE" = check ]; then
    printf 'Validated Monit verification sources.\n'
    exit 0
fi

[ "$(id -u)" -eq 0 ] || fail "run as root"
for verify_command in ausearch awk cat cmp find getenforce getfacl grep logrotate matchpathcon \
    ps rpm ss stat systemctl wc
do
    require_command "$verify_command"
done

verify_package_integrity
verify_version_floor
verify_control_file
verify_managed_files
verify_transaction_evidence
verify_log_rotation
verify_systemd_policy
verify_listener
verify_selinux
"$PACKAGE_BINARY" -c "$MONIT_MAIN" summary >/dev/null \
    || fail "Monit local control-plane health check failed"

printf 'Verified Monit package, configuration, SELinux, log rotation, and runtime health.\n'
