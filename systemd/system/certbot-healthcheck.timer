# systemd/system/certbot-healthcheck.timer

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

[Unit]
Description=Daily verification of managed TLS certificate expiration

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
