# systemd/system/certbot.service

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

[Unit]
Description=Renew Let's Encrypt certificates
Documentation=https://eff-certbot.readthedocs.io/en/stable/using.html#renewing-certificates
# The supported webroot flow needs nginx to answer HTTP-01 challenges, and the
# post-renewal action reloads nginx. Start it first and do not run Certbot when
# nginx cannot be started.
Requires=nginx.service
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot

# Renewal may involve multiple certificates and slow ACME responses.
UMask=0077
TimeoutStartSec=1h
Environment=HOME=/var/lib/letsencrypt

# Keep Certbot's exit status intact. ExecStopPost runs after both successful and
# failed oneshot execution, so nginx still loads certificates from successful
# partial renewals while the unit remains failed when any renewal failed.
ExecStart=/bin/certbot renew --quiet --agree-tos
ExecStopPost=/bin/systemctl reload nginx.service

# Certbot's standard configuration, work, and log directories. The ACME
# webroot is provisioned separately because it is also served by nginx.
ConfigurationDirectory=letsencrypt
ConfigurationDirectoryMode=0700
StateDirectory=letsencrypt
StateDirectoryMode=0700
LogsDirectory=letsencrypt
LogsDirectoryMode=0700
ReadWritePaths=/var/www/letsencrypt

# This unit supports the webroot renewal flow used by the nginx baseline.
# Standalone authenticators, hooks, or plugins that need additional files,
# devices, capabilities, or bind sockets require an explicit local drop-in.
CapabilityBoundingSet=
SocketBindDeny=any
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=64

# SystemCallFilter and MemoryDenyWriteExecute are intentionally deferred until
# they have been tested with the host's Certbot, Python, cryptography, and
# authenticator/plugin builds.
