# systemd/system/nginx.service

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

[Unit]
Description=nginx HTTP and reverse proxy server
Documentation=man:nginx(8) https://nginx.org/en/docs/
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=exec
# Retain the system manager's default root UID. Explicit User=root makes
# systemd 257's seccomp setup drop CAP_SETUID before nginx can spawn workers.
Group=nginx
# Set the complete supplementary list explicitly so nginx does not retain the
# manager's group 0 access to otherwise hidden /proc entries.
SupplementaryGroups=nginx

UMask=0027
RuntimeDirectory=%p lock/%p
RuntimeDirectoryMode=0755
StateDirectory=%p
StateDirectoryMode=0755
LogsDirectory=%p
LogsDirectoryMode=0750

ExecStartPre=/usr/sbin/%p -t -q -c %E/%p/%p.conf -g "daemon off;"
# Daemonization resets nginx's umask to zero. Keep the supervised master in
# the foreground so the master and workers retain the file-creation policy.
ExecStart=/usr/sbin/%p -c %E/%p/%p.conf -g "daemon off;"
# Keep only the checker under the manager's root:root credentials. Its gid 0
# can inspect cross-UID worker /proc entries with ProtectProc=invisible; the
# ! prefix preserves the other sandbox/capability controls. nginx stays
# root:nginx and receives neither CAP_SYS_PTRACE nor supplementary group root.
# --startup marks this as the unit's own gate: the loaded policy is what this
# master received, so unit files edited without daemon-reload log a warning
# instead of turning the start into a failure. Operator runs still fail closed.
ExecStartPost=!/usr/local/libexec/nginx-runtime-verify --master-pid $MAINPID --startup
ExecReload=/usr/sbin/%p -t -q -c %E/%p/%p.conf -g "daemon off;"
ExecReload=/bin/kill -s HUP $MAINPID

KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=60s
# Start budget: the configuration test, execve, then the checker's ten-second
# monotonic window plus one second of forced query-cleanup grace. Each query
# is capped by the remaining window. The remainder absorbs slow config loads.
TimeoutStartSec=60s
Restart=on-failure
RestartSec=5s

# Match nginx.conf's worker_rlimit_nofile. Locked memory is available when the
# optional quic_bpf stub is selected and validated on the target host.
LimitNOFILE=100000
LimitMEMLOCK=64M

# Baseline containment. Sites that intentionally write outside the managed
# runtime, state, and log directories must add a narrowly scoped drop-in.
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
# Counts worker threads, not just processes: with the shipped `aio threads`
# default pool each worker is 33 tasks, and a graceful reload doubles them
# while the old generation drains. 4096 admits two generations for up to 61
# workers (three for 41) while still bounding runaway task creation. This is
# a workload budget; DefaultTasksMax varies with kernel and root-cgroup limits.
# nginx/setup keeps SHARED_TASKS_MAX equal to this and refuses reviewed
# worker/pool sizing that does not fit, instead of letting new workers fail
# thread creation mid-reload.
TasksMax=4096

# The master binds privileged ports, changes worker identities, manages log
# ownership, signals workers and sets rlimits. Workers drop effective caps.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE
AmbientCapabilities=
# Keep mounts blocked even when the optional QUIC BPF drop-in grants the
# kernel-dependent CAP_SYS_ADMIN fallback; otherwise it can undo read-only
# mount protections. This deny-list leaves ordinary nginx syscalls available.
SystemCallFilter=~@mount
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
