# mongodb/templates/mongod-bootstrap.conf.in

#
# Author: Michael Welter <me@mikinho.com> - https://github.com/mikinho
#

systemLog:
  destination: file
  logAppend: true
  logRotate: reopen
  path: /var/log/mongodb/mongod.log

storage:
  dbPath: /var/lib/mongo

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

net:
  port: 27017
  bindIp: 127.0.0.1

security:
  javascriptEnabled: false

replication:
  replSetName: @REPLICA_SET@
